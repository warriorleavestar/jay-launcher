<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Amber.Core\Amber.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Amber.Core.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Jay 服务器版：VPS 和局域网电脑通用的命令行程序 -->
    <AssemblyName>jay-server</AssemblyName>
    <AssemblyTitle>Jay Server</AssemblyTitle>
    <Product>Jay</Product>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

</Project>
