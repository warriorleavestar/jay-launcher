<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    <!-- Linux Wayland 远程控制走 xdg-desktop-portal（D-Bus）；和 Avalonia 在 Linux 上用的是同一个库、同一个版本。 -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- 界面文字：每种语言一个 JSON，嵌进程序集（Native AOT 版本也能读） -->
    <EmbeddedResource Include="Localization\*.json" LogicalName="Amber.Core.Localization.%(Filename).json" />
    <!-- build/pins.json: every pinned binary and download (docs/pins.md); Jay reads its pins from it. -->
    <EmbeddedResource Include="..\..\build\pins.json" LogicalName="Amber.Core.pins.json" />
    <!-- BIP39 wordlists for Jay account recovery phrases (bitcoin/bips, bip-0039) -->
    <EmbeddedResource Include="Identity\Wordlists\*.txt" LogicalName="Amber.Core.Identity.%(Filename).txt" />
    <EmbeddedResource Include="..\..\docs\help\**\*.md" LogicalName="help/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\docs\help\shots\**\*.png" LogicalName="help/shots/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\themes\builtin\**\*.json" LogicalName="themes/builtin/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The hardened EasyTier release's SHA256SUMS.txt and the trustees' signatures over it (docs/security/release-signing.md) -->
    <EmbeddedResource Include="Multiplayer\EasyTierSigned\*" LogicalName="easytier-signed/%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    CurseForge third-party API key for official builds: CI passes the repository secret CURSEFORGE_API_KEY as the
    environment variable JAY_CURSEFORGE_API_KEY (push to main and tags only). It is never in the repository; local and
    PR builds have none and fall back to the user's own key (Content/CurseForgeBuiltInKey.cs).
  -->
  <ItemGroup Condition="'$(JAY_CURSEFORGE_API_KEY)' != ''">
    <AssemblyMetadata Include="Jay.CurseForgeApiKey" Value="$(JAY_CURSEFORGE_API_KEY)" />
  </ItemGroup>

  <!--
    Jay's DNS fallback for the Windows strong sandbox (tools/jay-dns, Java 18+): compiled from source with a local JDK
    and embedded as Amber.Core.jay-dns.jar. Without a JDK the build goes on without it (a warning) and Java 18+ games
    use the standard sandbox; release builds pass -p:RequireJayDns=true so a missing JDK fails the build instead.
    The JDK is looked up in JAY_JAVAC, the CI images' JAVA_HOME_25_X64 / JAVA_HOME_21_X64, JAVA_HOME, then PATH.
  -->
  <PropertyGroup>
    <JayDnsSource>$(MSBuildThisFileDirectory)..\..\tools\jay-dns\src</JayDnsSource>
    <JayJavac Condition="'$(JayJavac)' == '' and '$(JAY_JAVAC)' != ''">$(JAY_JAVAC)</JayJavac>
    <JayJavac Condition="'$(JayJavac)' == '' and '$(JAVA_HOME_25_X64)' != '' and Exists('$(JAVA_HOME_25_X64)\bin\javac.exe')">$(JAVA_HOME_25_X64)\bin\javac.exe</JayJavac>
    <JayJavac Condition="'$(JayJavac)' == '' and '$(JAVA_HOME_21_X64)' != '' and Exists('$(JAVA_HOME_21_X64)\bin\javac.exe')">$(JAVA_HOME_21_X64)\bin\javac.exe</JayJavac>
    <JayJavac Condition="'$(JayJavac)' == '' and '$(JAVA_HOME)' != '' and Exists('$(JAVA_HOME)\bin\javac.exe')">$(JAVA_HOME)\bin\javac.exe</JayJavac>
    <JayJavac Condition="'$(JayJavac)' == '' and '$(JAVA_HOME)' != '' and Exists('$(JAVA_HOME)/bin/javac')">$(JAVA_HOME)/bin/javac</JayJavac>
    <JayJavac Condition="'$(JayJavac)' == ''">javac</JayJavac>
  </PropertyGroup>

  <ItemGroup>
    <JayDnsJava Include="$(JayDnsSource)\**\*.java" />
    <JayDnsServices Include="$(JayDnsSource)\META-INF\**\*" />
  </ItemGroup>

  <Target Name="BuildJayDns" BeforeTargets="BeforeBuild" Inputs="@(JayDnsJava);@(JayDnsServices)" Outputs="$(IntermediateOutputPath)jay-dns.jar">
    <PropertyGroup>
      <JayDnsClasses>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)jay-dns</JayDnsClasses>
    </PropertyGroup>
    <RemoveDir Directories="$(JayDnsClasses)" />
    <MakeDir Directories="$(JayDnsClasses)" />
    <Exec Command="&quot;$(JayJavac)&quot; --release 18 -encoding UTF-8 -d &quot;$(JayDnsClasses)&quot; @(JayDnsJava->'&quot;%(FullPath)&quot;', ' ')" ContinueOnError="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="JayDnsExit" />
    </Exec>
    <Copy Condition="'$(JayDnsExit)' == '0'" SourceFiles="@(JayDnsServices)" DestinationFiles="@(JayDnsServices->'$(JayDnsClasses)/META-INF/%(RecursiveDir)%(Filename)%(Extension)')" />
    <ZipDirectory Condition="'$(JayDnsExit)' == '0'" SourceDirectory="$(JayDnsClasses)" DestinationFile="$(IntermediateOutputPath)jay-dns.jar" Overwrite="true" />
    <Warning Condition="'$(JayDnsExit)' != '0' and '$(RequireJayDns)' != 'true'" Text="jay-dns was not built (no JDK 18+ found as '$(JayJavac)'): Java 18+ games will use the standard Windows sandbox." />
    <Error Condition="'$(JayDnsExit)' != '0' and '$(RequireJayDns)' == 'true'" Text="jay-dns could not be built with '$(JayJavac)' (RequireJayDns=true)." />
  </Target>

  <Target Name="EmbedJayDns" AfterTargets="BuildJayDns" BeforeTargets="BeforeBuild" Condition="Exists('$(IntermediateOutputPath)jay-dns.jar')">
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)jay-dns.jar" LogicalName="Amber.Core.jay-dns.jar" />
    </ItemGroup>
  </Target>

  <!--
    Jay's file system provider for the Windows sandbox (tools/jay-fs, Java 8 bytecode): fixes Java's write check inside
    the sandbox. The JDK class it extends is package-private, so it compiles against a stand-in (tools/jay-fs/stub) that
    is not packaged. Same JDK lookup and RequireJayDns switch as jay-dns.
  -->
  <PropertyGroup>
    <JayFsSource>$(MSBuildThisFileDirectory)..\..\tools\jay-fs</JayFsSource>
  </PropertyGroup>

  <ItemGroup>
    <JayFsJava Include="$(JayFsSource)\src\**\*.java" />
    <JayFsStub Include="$(JayFsSource)\stub\**\*.java" />
  </ItemGroup>

  <Target Name="BuildJayFs" BeforeTargets="BeforeBuild" Inputs="@(JayFsJava);@(JayFsStub)" Outputs="$(IntermediateOutputPath)jay-fs.jar">
    <PropertyGroup>
      <JayFsClasses>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)jay-fs</JayFsClasses>
      <JayFsStubClasses>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)jay-fs-stub</JayFsStubClasses>
    </PropertyGroup>
    <RemoveDir Directories="$(JayFsClasses);$(JayFsStubClasses)" />
    <MakeDir Directories="$(JayFsClasses);$(JayFsStubClasses)" />
    <Exec Command="&quot;$(JayJavac)&quot; --release 8 -Xlint:-options -encoding UTF-8 -d &quot;$(JayFsStubClasses)&quot; @(JayFsStub->'&quot;%(FullPath)&quot;', ' ')" ContinueOnError="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="JayFsStubExit" />
    </Exec>
    <Exec Condition="'$(JayFsStubExit)' == '0'" Command="&quot;$(JayJavac)&quot; --release 8 -Xlint:-options -encoding UTF-8 -cp &quot;$(JayFsStubClasses)&quot; -d &quot;$(JayFsClasses)&quot; @(JayFsJava->'&quot;%(FullPath)&quot;', ' ')" ContinueOnError="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="JayFsExit" />
    </Exec>
    <ZipDirectory Condition="'$(JayFsExit)' == '0'" SourceDirectory="$(JayFsClasses)" DestinationFile="$(IntermediateOutputPath)jay-fs.jar" Overwrite="true" />
    <Warning Condition="'$(JayFsExit)' != '0' and '$(RequireJayDns)' != 'true'" Text="jay-fs was not built (no JDK found as '$(JayJavac)'): sandboxed games may not write through zip file systems (Fabric's remapped jar)." />
    <Error Condition="'$(JayFsExit)' != '0' and '$(RequireJayDns)' == 'true'" Text="jay-fs could not be built with '$(JayJavac)' (RequireJayDns=true)." />
  </Target>

  <Target Name="EmbedJayFs" AfterTargets="BuildJayFs" BeforeTargets="BeforeBuild" Condition="Exists('$(IntermediateOutputPath)jay-fs.jar')">
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)jay-fs.jar" LogicalName="Amber.Core.jay-fs.jar" />
    </ItemGroup>
  </Target>

  <!--
    Jay's LAN bridge for the Windows strong sandbox (tools/jay-lan, Java 8 bytecode): a Java agent that connects out of the
    game to Jay so room members reach a world opened to LAN (Jay cannot connect into the AppContainer over loopback).
    Same JDK lookup and RequireJayDns switch as jay-dns.
  -->
  <PropertyGroup>
    <JayLanSource>$(MSBuildThisFileDirectory)..\..\tools\jay-lan\src</JayLanSource>
  </PropertyGroup>

  <ItemGroup>
    <JayLanJava Include="$(JayLanSource)\**\*.java" />
    <JayLanMeta Include="$(JayLanSource)\META-INF\**\*" />
  </ItemGroup>

  <Target Name="BuildJayLan" BeforeTargets="BeforeBuild" Inputs="@(JayLanJava);@(JayLanMeta)" Outputs="$(IntermediateOutputPath)jay-lan.jar">
    <PropertyGroup>
      <JayLanClasses>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)jay-lan</JayLanClasses>
    </PropertyGroup>
    <RemoveDir Directories="$(JayLanClasses)" />
    <MakeDir Directories="$(JayLanClasses)" />
    <Exec Command="&quot;$(JayJavac)&quot; --release 8 -Xlint:-options -encoding UTF-8 -d &quot;$(JayLanClasses)&quot; @(JayLanJava->'&quot;%(FullPath)&quot;', ' ')" ContinueOnError="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="JayLanExit" />
    </Exec>
    <Copy Condition="'$(JayLanExit)' == '0'" SourceFiles="@(JayLanMeta)" DestinationFiles="@(JayLanMeta->'$(JayLanClasses)/META-INF/%(RecursiveDir)%(Filename)%(Extension)')" />
    <ZipDirectory Condition="'$(JayLanExit)' == '0'" SourceDirectory="$(JayLanClasses)" DestinationFile="$(IntermediateOutputPath)jay-lan.jar" Overwrite="true" />
    <Warning Condition="'$(JayLanExit)' != '0' and '$(RequireJayDns)' != 'true'" Text="jay-lan was not built (no JDK found as '$(JayJavac)'): rooms cannot reach a game in the strong sandbox." />
    <Error Condition="'$(JayLanExit)' != '0' and '$(RequireJayDns)' == 'true'" Text="jay-lan could not be built with '$(JayJavac)' (RequireJayDns=true)." />
  </Target>

  <Target Name="EmbedJayLan" AfterTargets="BuildJayLan" BeforeTargets="BeforeBuild" Condition="Exists('$(IntermediateOutputPath)jay-lan.jar')">
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)jay-lan.jar" LogicalName="Amber.Core.jay-lan.jar" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Amber.Core.Tests" />
  </ItemGroup>

</Project>
