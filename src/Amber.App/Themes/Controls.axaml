<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    基础控件（官方设计 §5，第 0 批）：能用样式类解决的不新建控件类型。
    在 Views/Gallery 里每个都有一格，AMBER_SELFTEST_SCOPE=gallery 会在深浅两色下截图。

    按钮：play（琥珀，只给“开始游戏”这一类，每个视口最多 1 个）· primary（松鸦蓝，每块区域最多 1 个）
          · secondary · ghost · danger（描边红字）· danger.solid（实心红，只在锁定确认里）；尺寸 small / large
    Marks ("美术风格"): a chip says a state, a tag says an attribute, and neither is a button.
      Border.chip (.selected / .ok / .warn / .bad / .info / .playing): pill, usually with a Border.led in front
      Border.tag (.success / .accent), Border.loader (.vanilla … .optifine): small rectangle; TextBlock.px inside = pixel digits
      Border.badge (.muted): a count
      Border.led (.online / .busy / .warning / .error / .playing / .off): square status light, always next to words
      Border.face (.large): a person's pixel face, Background from FaceBrush
    Wing bars: Border.wing-edge (left edge of Border.code-card), the selected tab, the selected nav item, progress fills
    提示：Border.banner（.info/.success/.warning/.danger）· Border.error-bar · Border.skeleton · StackPanel.empty-state
    图标：Path.icon（.sm / .lg）
  -->

  <!-- 图标：Lucide 是 24×24 的描边路径，按尺寸缩放，描边 1.75 -->
  <Style Selector="Path.icon">
    <Setter Property="Width" Value="{DynamicResource IconSize}" />
    <Setter Property="Height" Value="{DynamicResource IconSize}" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Stroke" Value="{DynamicResource TextSecondary}" />
    <Setter Property="StrokeThickness" Value="1.75" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- 按钮里的图标跟按钮文字同色（悬停、按下、禁用都跟着变） -->
  <Style Selector="Button Path.icon">
    <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
  </Style>
  <Style Selector="Path.icon.sm">
    <Setter Property="Width" Value="{DynamicResource IconSizeSm}" />
    <Setter Property="Height" Value="{DynamicResource IconSizeSm}" />
    <Setter Property="StrokeThickness" Value="1.5" />
  </Style>
  <Style Selector="Path.icon.lg">
    <Setter Property="Width" Value="{DynamicResource IconSizeLg}" />
    <Setter Property="Height" Value="{DynamicResource IconSizeLg}" />
  </Style>

  <!-- 所有按钮：标准高 36、可点区域至少 32、焦点环用 Focus -->
  <!-- Fluent leaves content at Stretch, so a label in a button taller than it (MinHeight 44 next to the start
       button) sat at the top. Centre it vertically everywhere; horizontal stays Stretch so row buttons fill. -->
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="{DynamicResource MinHitSize}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Focus}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.small">
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeightSm}" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="FontSize" Value="{DynamicResource FontBodySmall}" />
  </Style>
  <Style Selector="Button.large">
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeightLg}" />
    <Setter Property="Padding" Value="20,8" />
  </Style>

  <!-- 琥珀“开始游戏”：唯一发光的按钮；浅色下描 1px PlayBorder（琥珀和浅底对比只有 1.81） -->
  <Style Selector="Button.play">
    <Setter Property="Background" Value="{DynamicResource Play}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPlay}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PlayBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="{DynamicResource FontSubtitle}" />
    <Setter Property="MinHeight" Value="{DynamicResource PlayButtonHeight}" />
    <Setter Property="Padding" Value="24,8" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.play /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="{DynamicResource PlayGlowShadow}" />
  </Style>
  <Style Selector="Button.play:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PlayHover}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPlay}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PlayBorder}" />
  </Style>
  <Style Selector="Button.play:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PlayPressed}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPlay}" />
  </Style>
  <Style Selector="Button.play:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Focus}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.play:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="none" />
  </Style>

  <!-- 实心红：只在锁定确认（删除、结束、撤销授权）里 -->
  <Style Selector="Button.danger.solid">
    <Setter Property="Background" Value="{DynamicResource Danger}" />
    <Setter Property="Foreground" Value="{DynamicResource OnDanger}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.danger.solid:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.danger.solid:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Danger}" />
    <Setter Property="Foreground" Value="{DynamicResource OnDanger}" />
  </Style>

  <!-- Bare: a button that is only a hit area around its own content (thumbnails). No key, no fill. -->
  <Style Selector="Button.bare">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Button.bare /template/ ContentPresenter#PART_ContentPresenter, Button.term-hint /template/ ContentPresenter#PART_ContentPresenter, Button.pill-play /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="none" />
  </Style>
  <Style Selector="Button.bare:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.bare:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- "What is this?" (§6.24): an 18 px ring with "?", inside a MinHitSize square that doesn't push its row taller. -->
  <Style Selector="Button.term-hint">
    <Setter Property="Width" Value="{DynamicResource MinHitSize}" />
    <Setter Property="Height" Value="{DynamicResource MinHitSize}" />
    <Setter Property="Margin" Value="0,-8" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.term-hint Border.term-hint-dot">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
  </Style>
  <Style Selector="Button.term-hint Border.term-hint-dot TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="Button.term-hint:pointerover Border.term-hint-dot, Button.term-hint:focus-visible Border.term-hint-dot">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Button.term-hint:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- 输入框：InputBg 底、ControlBorder 边、焦点用 Focus -->
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
  </Style>
  <Style Selector="TextBox /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource InputBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource InputBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Focus}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="TextBox.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
  </Style>
  <Style Selector="SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
  </Style>

  <!-- Chip: a state ("connected", "end-to-end encrypted"). Pill shape, usually led + words. -->
  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
    <Setter Property="Padding" Value="9,2" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Background" Value="{DynamicResource Sunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.chip TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontBodySmall}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.chip > StackPanel">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="6" />
  </Style>
  <Style Selector="Border.chip.selected, Border.chip.info">
    <Setter Property="Background" Value="{DynamicResource ControlSelected}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Border.chip.selected TextBlock, Border.chip.info TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentText}" /></Style>
  <Style Selector="Border.chip.ok TextBlock"><Setter Property="Foreground" Value="{DynamicResource SuccessText}" /></Style>
  <Style Selector="Border.chip.warn TextBlock"><Setter Property="Foreground" Value="{DynamicResource WarningText}" /></Style>
  <Style Selector="Border.chip.bad TextBlock"><Setter Property="Foreground" Value="{DynamicResource DangerText}" /></Style>
  <Style Selector="Border.chip.playing TextBlock"><Setter Property="Foreground" Value="{DynamicResource PlayText}" /></Style>

  <!-- Tag: an attribute (game version, loader, release type). Small rectangle; .pill is its old name. -->
  <Style Selector="Border.tag, Border.pill, Border.loader">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
    <Setter Property="Padding" Value="7,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.tag > TextBlock, Border.pill > TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.tag.success, Border.pill.success"><Setter Property="Background" Value="{DynamicResource SuccessTint}" /></Style>
  <Style Selector="Border.tag.success > TextBlock, Border.pill.success > TextBlock"><Setter Property="Foreground" Value="{DynamicResource SuccessText}" /></Style>
  <Style Selector="Border.tag.accent, Border.pill.accent"><Setter Property="Background" Value="{DynamicResource AccentTint}" /></Style>
  <Style Selector="Border.tag.accent > TextBlock, Border.pill.accent > TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentText}" /></Style>
  <!-- Pixel digits: game versions and step numbers only. VT323 runs small for its size, so it is set larger than its neighbours. -->
  <Style Selector="TextBlock.px">
    <Setter Property="FontFamily" Value="{DynamicResource PixelFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FontPixelTag}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="LineHeight" Value="18" />
  </Style>
  <Style Selector="TextBlock.px.step">
    <Setter Property="FontSize" Value="{DynamicResource FontPixelStep}" />
    <Setter Property="LineHeight" Value="20" />
  </Style>

  <!-- 角标：红点数字（要你处理），灰数字（新消息） -->
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="Background" Value="{DynamicResource Badge}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.badge > TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontCaption}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource OnBadge}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.badge.muted">
    <Setter Property="Background" Value="{DynamicResource BadgeMuted}" />
  </Style>
  <Style Selector="Border.badge.muted > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnBadgeMuted}" />
  </Style>

  <!-- 加载器标签：文字 + 颜色，不用任何商标图形 -->
  <Style Selector="Border.loader > TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontCaption}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="Border.loader.vanilla > TextBlock"><Setter Property="Foreground" Value="{DynamicResource LoaderVanilla}" /></Style>
  <Style Selector="Border.loader.fabric > TextBlock"><Setter Property="Foreground" Value="{DynamicResource LoaderFabric}" /></Style>
  <Style Selector="Border.loader.forge > TextBlock"><Setter Property="Foreground" Value="{DynamicResource LoaderForge}" /></Style>
  <Style Selector="Border.loader.neoforge > TextBlock"><Setter Property="Foreground" Value="{DynamicResource LoaderNeoForge}" /></Style>
  <Style Selector="Border.loader.quilt > TextBlock"><Setter Property="Foreground" Value="{DynamicResource LoaderQuilt}" /></Style>
  <Style Selector="Border.loader.optifine > TextBlock"><Setter Property="Foreground" Value="{DynamicResource LoaderOptiFine}" /></Style>

  <!-- Status light: a small square, never the only carrier of meaning (words sit next to it). -->
  <Style Selector="Border.led">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource TextTertiary}" />
  </Style>
  <Style Selector="Border.led.online"><Setter Property="Background" Value="{DynamicResource Success}" /></Style>
  <Style Selector="Border.led.busy"><Setter Property="Background" Value="{DynamicResource Accent}" /></Style>
  <Style Selector="Border.led.warning"><Setter Property="Background" Value="{DynamicResource Warning}" /></Style>
  <Style Selector="Border.led.error"><Setter Property="Background" Value="{DynamicResource Danger}" /></Style>
  <Style Selector="Border.led.playing"><Setter Property="Background" Value="{DynamicResource Play}" /></Style>
  <!-- Off: an empty socket. -->
  <Style Selector="Border.led.off">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource TextTertiary}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.led.small">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="1.5" />
  </Style>

  <!-- Pixel face (Views/FaceBrush): 24 in lists, 32 where the person is the subject. Multiples of 8 keep the cells crisp. -->
  <Style Selector="Border.face">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.face.large">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <!-- Wing bars as an edge: the left side of a code card (invite codes, direct codes). -->
  <Style Selector="Border.code-card">
    <Setter Property="Background" Value="{DynamicResource Sunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.wing-edge">
    <Setter Property="Width" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource WingBrushVertical}" />
  </Style>
  <!-- A read-only code inside a code card: the card is the frame, so the box itself has none until it is focused. -->
  <Style Selector="TextBox.code">
    <Setter Property="Margin" Value="6,0,0,0" />
  </Style>
  <Style Selector="TextBox.code /template/ Border#PART_BorderElement, TextBox.code:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <!-- The selected nav item's indicator. A style, not a local value, so a theme pack's nav.item indicator can replace it. -->
  <Style Selector="Border.nav-indicator">
    <Setter Property="Background" Value="{DynamicResource WingBrushVertical}" />
  </Style>
  <Style Selector="Border.wing-rule">
    <Setter Property="Height" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource WingBrush}" />
  </Style>

  <!-- 横幅：页面或卡片顶上的一条说明，左边一道状态色 + 图标 + 文字 -->
  <Style Selector="Border.banner">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Background" Value="{DynamicResource AccentTint}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Border.banner TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.banner Path.icon"><Setter Property="Stroke" Value="{DynamicResource AccentText}" /></Style>
  <Style Selector="Border.banner.success">
    <Setter Property="Background" Value="{DynamicResource SuccessTint}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Success}" />
  </Style>
  <Style Selector="Border.banner.success Path.icon"><Setter Property="Stroke" Value="{DynamicResource SuccessText}" /></Style>
  <Style Selector="Border.banner.warning">
    <Setter Property="Background" Value="{DynamicResource WarningTint}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Warning}" />
  </Style>
  <Style Selector="Border.banner.warning Path.icon"><Setter Property="Stroke" Value="{DynamicResource WarningText}" /></Style>
  <Style Selector="Border.banner.danger">
    <Setter Property="Background" Value="{DynamicResource DangerTint}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
  </Style>
  <Style Selector="Border.banner.danger Path.icon"><Setter Property="Stroke" Value="{DynamicResource DangerText}" /></Style>

  <!-- 错误条：出了什么事 + 怎么办（按钮）；出错级别不自动消失 -->
  <Style Selector="Border.error-bar">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Background" Value="{DynamicResource DangerTint}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
  </Style>
  <Style Selector="Border.error-bar TextBlock.title">
    <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.error-bar Path.icon"><Setter Property="Stroke" Value="{DynamicResource DangerText}" /></Style>

  <!-- 骨架屏：加载时占位；减少动画时也不闪 -->
  <Style Selector="Border.skeleton">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="MinHeight" Value="12" />
  </Style>

  <!-- 空状态：一句话说清这里放什么 + 一个能做的事 -->
  <Style Selector="StackPanel.empty-state">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="MaxWidth" Value="420" />
    <Setter Property="Spacing" Value="8" />
    <Setter Property="Margin" Value="16,32" />
  </Style>
  <Style Selector="StackPanel.empty-state > Path.icon">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="StrokeThickness" Value="1.25" />
    <Setter Property="Stroke" Value="{DynamicResource IlloLine}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="StackPanel.empty-state > TextBlock">
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="StackPanel.empty-state > TextBlock.title">
    <Setter Property="FontSize" Value="{DynamicResource FontSubtitle}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="StackPanel.empty-state > TextBlock.hint">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>

  <!-- 菜单、下拉、提示：Overlay 底 -->
  <Style Selector="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource Overlay}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
  </Style>
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource Overlay}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
  </Style>
  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource Overlay}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Overlay}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
  </Style>

  <!-- Lists: the selected row is a tonal azure fill, not Fluent's translucent accent. -->
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:focus:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlSelected}" />
  </Style>
  <Style Selector="ListBoxItem:pointerover:not(:selected) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlHover}" />
  </Style>

  <!-- Drop-downs are keys too: tonal fill, the button radius. -->
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="MinHeight" Value="{DynamicResource MinHitSize}" />
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource ControlHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
  </Style>
  <Style Selector="ComboBox:focus-visible /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource Focus}" />
  </Style>

  <!-- Progress: wing bars filling a sunken track. -->
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource WingBrush}" />
    <Setter Property="Background" Value="{DynamicResource Sunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <!-- Fluent sets the bar's thickness in a :horizontal / :vertical style, which outranks a plain setter. -->
  <Style Selector="ProgressBar:horizontal"><Setter Property="MinHeight" Value="8" /></Style>
  <Style Selector="ProgressBar:vertical"><Setter Property="MinWidth" Value="8" /></Style>

  <!-- 开关：开 = Accent -->
  <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
  </Style>

  <!-- 标题层级：Headline、Display -->
  <Style Selector="TextBlock.headline">
    <Setter Property="FontSize" Value="{DynamicResource FontHeadline}" />
    <Setter Property="LineHeight" Value="{DynamicResource LineHeadline}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="{DynamicResource FontDisplay}" />
    <Setter Property="LineHeight" Value="{DynamicResource LineDisplay}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- ===== 外壳（官方设计 §3.1、§5.8）===== -->
  <!-- 只放图标的按钮（返回、前进）：32×32 起，可点区域不小于 MinHitSize -->
  <Style Selector="Button.icon-only">
    <Setter Property="Padding" Value="6" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="MinWidth" Value="{DynamicResource MinHitSize}" />
    <Setter Property="MinHeight" Value="{DynamicResource MinHitSize}" />
  </Style>
  <Style Selector="Button.icon-only Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Button.icon-only:disabled Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource DisabledText}" />
  </Style>
  <!-- 侧栏品牌行：点它回游戏库 -->
  <Style Selector="Button.shell-brand">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Margin" Value="8,10,8,6" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <!-- 侧栏底部的设置、账号 -->
  <Style Selector="Button.shell-foot">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.shell-foot.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavSelected}" />
  </Style>
  <Style Selector="Button.shell-foot Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource SidebarText}" />
  </Style>
  <!-- A page's main vertical scroller. Fluent draws the scrollbar over the content (16 wide when expanded), so
       right-aligned controls ended up under it. Reserve that width as padding inside the scroller and pull the
       scroller into the page gutter by the same amount: content keeps its right edge, the bar sits in the gutter. -->
  <Style Selector="ScrollViewer.page-scroll">
    <Setter Property="Margin" Value="0,0,-16,0" />
    <Setter Property="Padding" Value="0,0,16,0" />
  </Style>
  <!-- 图标栏：底部按钮只留图标，居中 -->
  <Style Selector="Border.sidebar.rail Button.shell-foot">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Border.sidebar.rail TextBlock.foot-title">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.sidebar.rail Button.shell-brand">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="0,8" />
  </Style>
  <!-- Sub-page tabs: the selected one is bold over a wing-bar underline, no fill. -->
  <Style Selector="ListBox.subtabs ListBoxItem">
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinHeight" Value="{DynamicResource MinHitSize}" />
    <Setter Property="CornerRadius" Value="6,6,0,0" />
    <Setter Property="BorderThickness" Value="0,0,0,3" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="ListBox.subtabs ListBoxItem:selected">
    <Setter Property="BorderBrush" Value="{DynamicResource WingBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="ListBox.subtabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.subtabs ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.subtabs ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="ListBox.subtabs ListBoxItem:pointerover:not(:selected) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlHover}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <!-- 路由定位到字段时闪一下描边（减少动画时也一样，是静态描边） -->
  <Style Selector=":is(TemplatedControl).field-flash">
    <Setter Property="BorderBrush" Value="{DynamicResource Focus}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- 正在玩胶囊（顶栏）：绿点 + 实例名；崩溃时红 -->
  <Style Selector="Button.pill-play">
    <Setter Property="Background" Value="{DynamicResource PlayTint}" />
    <Setter Property="Foreground" Value="{DynamicResource PlayText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Play}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button.pill-play:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.pill-play:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PlayTint}" />
    <Setter Property="Foreground" Value="{DynamicResource PlayText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Play}" />
  </Style>
  <Style Selector="Button.pill-play Border.led"><Setter Property="Background" Value="{DynamicResource Play}" /></Style>
  <Style Selector="Button.pill-play.crash">
    <Setter Property="Background" Value="{DynamicResource DangerTint}" />
    <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
  </Style>
  <Style Selector="Button.pill-play.crash:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.pill-play.crash:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerTint}" />
    <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
  </Style>
  <Style Selector="Button.pill-play.crash Border.led"><Setter Property="Background" Value="{DynamicResource Danger}" /></Style>
  <Style Selector="TextBlock.error"><Setter Property="Foreground" Value="{DynamicResource DangerText}" /></Style>
  <Style Selector="TextBlock.warn"><Setter Property="Foreground" Value="{DynamicResource WarningText}" /></Style>
  <Style Selector="TextBlock.ok"><Setter Property="Foreground" Value="{DynamicResource SuccessText}" /></Style>
  <!-- 请求条：普通请求（非安全）。和横幅一样，但更醒目一点 -->
  <Style Selector="Border.banner.request">
    <Setter Property="BorderThickness" Value="1,1,1,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>

  <!-- Compact density (§6.20): tighter list rows and card padding; heights come from the window's size tokens. -->
  <Style Selector="Window.density-compact ListBoxItem">
    <Setter Property="Padding" Value="8,3" />
  </Style>
  <Style Selector="Window.density-compact Border.card">
    <Setter Property="Padding" Value="12" />
  </Style>
</Styles>
