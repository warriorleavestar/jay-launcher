<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    设计令牌（官方设计 §4）：页面和 C# 里不写十六进制颜色，都从这里取（DynamicResource，跟着主题换）。
    深色叫“夜”，浅色叫“晨”。颜色和 Amber.Core/Themes/ThemeColor.cs 的 ThemeDefaults 一致，单元测试会核对，并重算 §4.2 的对比度表。
    颜色名沿用主题包 format 1 的名字（PageBg = 设计稿 Base、SidebarBg = Frame、BorderSubtle = Divider…），旧主题包照常生效；
    format 2 的改名在第 11 批做，那时旧名走迁移表。
  -->
  <Color x:Key="SystemAccentColor">#2C59CC</Color>
  <Color x:Key="SystemAccentColorLight1">#3A67DA</Color>
  <Color x:Key="SystemAccentColorLight2">#5B82E4</Color>
  <Color x:Key="SystemAccentColorLight3">#78A0FF</Color>
  <Color x:Key="SystemAccentColorDark1">#2149B0</Color>
  <Color x:Key="SystemAccentColorDark2">#1A3A8E</Color>
  <Color x:Key="SystemAccentColorDark3">#132B6B</Color>

  <!-- 间距：4 的倍数为主 -->
  <x:Double x:Key="Space0">2</x:Double>
  <x:Double x:Key="Space1">4</x:Double>
  <x:Double x:Key="Space2">8</x:Double>
  <x:Double x:Key="Space3">12</x:Double>
  <x:Double x:Key="Space4">16</x:Double>
  <x:Double x:Key="Space5">24</x:Double>
  <x:Double x:Key="Space6">32</x:Double>
  <x:Double x:Key="Space7">48</x:Double>
  <x:Double x:Key="Space8">64</x:Double>
  <Thickness x:Key="CardPadding">16</Thickness>
  <Thickness x:Key="CardPaddingCompact">12</Thickness>
  <Thickness x:Key="PagePadding">24,20</Thickness>
  <Thickness x:Key="PagePaddingCompact">16,12</Thickness>
  <Thickness x:Key="PagePaddingWide">32,24</Thickness>

  <!-- 控件尺寸：小 28、标准 36、大 44；开始按钮 48（矮窗口 40）；可点区域最小 32 -->
  <x:Double x:Key="ControlHeightSm">28</x:Double>
  <x:Double x:Key="ControlHeight">36</x:Double>
  <x:Double x:Key="ControlHeightLg">44</x:Double>
  <x:Double x:Key="PlayButtonHeight">48</x:Double>
  <x:Double x:Key="PlayButtonHeightShort">40</x:Double>
  <x:Double x:Key="TopBarHeight">48</x:Double>
  <x:Double x:Key="SidebarWidth">240</x:Double>
  <x:Double x:Key="RailWidth">76</x:Double>
  <x:Double x:Key="MinHitSize">32</x:Double>
  <x:Double x:Key="IconSizeSm">16</x:Double>
  <x:Double x:Key="IconSize">20</x:Double>
  <x:Double x:Key="IconSizeLg">24</x:Double>

  <!-- 圆角 -->
  <CornerRadius x:Key="RadiusXs">4</CornerRadius>
  <CornerRadius x:Key="RadiusSm">6</CornerRadius>
  <CornerRadius x:Key="RadiusMd">8</CornerRadius>
  <CornerRadius x:Key="RadiusLg">12</CornerRadius>
  <CornerRadius x:Key="RadiusXl">16</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>

  <!-- 字号阶梯（§4.4）：最小 12；中日文只用 Regular 和 Bold 两个字重 -->
  <x:Double x:Key="FontCaption">12</x:Double>
  <x:Double x:Key="FontBodySmall">13</x:Double>
  <x:Double x:Key="FontBody">14</x:Double>
  <x:Double x:Key="FontSubtitle">16</x:Double>
  <x:Double x:Key="FontTitle">20</x:Double>
  <x:Double x:Key="FontHeadline">24</x:Double>
  <x:Double x:Key="FontDisplay">32</x:Double>
  <x:Double x:Key="LineCaption">18</x:Double>
  <x:Double x:Key="LineBodySmall">20</x:Double>
  <x:Double x:Key="LineBody">22</x:Double>
  <x:Double x:Key="LineSubtitle">24</x:Double>
  <x:Double x:Key="LineTitle">28</x:Double>
  <x:Double x:Key="LineHeadline">32</x:Double>
  <x:Double x:Key="LineDisplay">40</x:Double>
  <!-- 字体：先拉丁后中日文；按语言替换在 i18n 那边（繁体、日文） -->
  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, $Default, Inter, Microsoft YaHei UI, PingFang SC, Noto Sans SC, Noto Sans CJK SC, Source Han Sans SC</FontFamily>
  <!-- 等宽：JetBrains Mono 随所有平台打包（邀请码、安全码、日志、启动参数） -->
  <FontFamily x:Key="MonoFont">avares://Jay/Assets/Fonts#JetBrains Mono, Cascadia Mono, SF Mono, Consolas, Noto Sans Mono CJK SC, monospace</FontFamily>
  <!-- 主题包的窗口背景图透明度（背景图本身只在主题包里有） -->
  <x:Double x:Key="ThemeBackgroundOpacity">1</x:Double>

  <!-- 阴影层级（§4.6）：深色主要靠底色变亮和边框，浅色靠阴影 -->
  <BoxShadows x:Key="Elevation1">0 1 2 0 #330B1220</BoxShadows>
  <BoxShadows x:Key="Elevation2">0 4 12 0 #400B1220</BoxShadows>
  <BoxShadows x:Key="Elevation3">0 12 32 0 #590B1220</BoxShadows>
  <BoxShadows x:Key="PlayGlowShadow">0 4 16 0 #40F6A93B</BoxShadows>

  <!-- 动效（§4.7）：减少动画打开时 Jay 把这些换成 0 或 100 毫秒（MotionSettings） -->
  <x:TimeSpan x:Key="MotionFast">0:0:0.1</x:TimeSpan>
  <x:TimeSpan x:Key="MotionBase">0:0:0.16</x:TimeSpan>
  <x:TimeSpan x:Key="MotionSlow">0:0:0.24</x:TimeSpan>
  <x:TimeSpan x:Key="MotionSlower">0:0:0.32</x:TimeSpan>
  <SplineEasing x:Key="EaseStandard" X1="0.2" Y1="0" X2="0" Y2="1" />
  <SplineEasing x:Key="EaseEmphasized" X1="0.05" Y1="0.7" X2="0.1" Y2="1" />

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <!-- 内容区底色（设计稿 Base） -->
      <SolidColorBrush x:Key="PageBg" Color="#0E1219" />
      <!-- 卡片、列表容器、面板 -->
      <SolidColorBrush x:Key="Surface" Color="#202A3A" />
      <!-- 卡片里再凸起的块（设计稿 Raised） -->
      <SolidColorBrush x:Key="SurfaceRaised" Color="#29344A" />
      <!-- 分隔线、卡片 1px 边（设计稿 Divider） -->
      <SolidColorBrush x:Key="BorderSubtle" Color="#394660" />
      <!-- 侧栏、顶栏（设计稿 Frame） -->
      <SolidColorBrush x:Key="SidebarBg" Color="#080B10" />
      <!-- 正文、标题（设计稿 Text） -->
      <SolidColorBrush x:Key="TextPrimary" Color="#E8EDF5" />
      <SolidColorBrush x:Key="TextSecondary" Color="#B3BDCD" />
      <SolidColorBrush x:Key="TextTertiary" Color="#A0ABBE" />
      <!-- 松鸦蓝：普通主按钮、开关、进度、选中 -->
      <SolidColorBrush x:Key="Accent" Color="#78A0FF" />
      <SolidColorBrush x:Key="AccentHover" Color="#93B4FF" />
      <SolidColorBrush x:Key="AccentPressed" Color="#6188EA" />
      <SolidColorBrush x:Key="OnAccent" Color="#08132E" />
      <!-- 链接、蓝色文字 -->
      <SolidColorBrush x:Key="AccentText" Color="#8FB1FF" />
      <SolidColorBrush x:Key="Success" Color="#3DD68C" />
      <SolidColorBrush x:Key="SuccessText" Color="#5BE0A0" />
      <!-- 柠檬黄，和琥珀拉开色相 -->
      <SolidColorBrush x:Key="Warning" Color="#E9C84A" />
      <SolidColorBrush x:Key="WarningText" Color="#F0D46A" />
      <SolidColorBrush x:Key="Danger" Color="#FF6B6B" />
      <SolidColorBrush x:Key="DangerText" Color="#FF8C87" />
      <SolidColorBrush x:Key="OnDanger" Color="#1F0606" />
      <SolidColorBrush x:Key="DisabledFill" Color="#293342" />
      <!-- 设计稿 TextDisabled -->
      <SolidColorBrush x:Key="DisabledText" Color="#808B9E" />
      <!-- 设计稿 NavText -->
      <SolidColorBrush x:Key="SidebarText" Color="#E8EDF5" />
      <!-- 设计稿 NavTextMuted -->
      <SolidColorBrush x:Key="SidebarTextMuted" Color="#A3AEC0" />
      <!-- 设计稿 NavItemSelected，只在侧栏用 -->
      <SolidColorBrush x:Key="NavSelected" Color="#1A2336" />
      <!-- 设计稿 NavItemHover -->
      <SolidColorBrush x:Key="NavHover" Color="#17191E" />
      <!-- 色调底：已按叠在 Surface 上算好 -->
      <SolidColorBrush x:Key="AccentTint" Color="#2E3D5A" />
      <SolidColorBrush x:Key="SuccessTint" Color="#244246" />
      <SolidColorBrush x:Key="WarningTint" Color="#3C403C" />
      <SolidColorBrush x:Key="DangerTint" Color="#3F3341" />
      <!-- 菜单、抽屉、对话框、Toast -->
      <SolidColorBrush x:Key="Overlay" Color="#2D394E" />
      <!-- 日志、代码的凹陷底 -->
      <SolidColorBrush x:Key="Sunken" Color="#070A0E" />
      <!-- 输入框底 -->
      <SolidColorBrush x:Key="InputBg" Color="#0B0F16" />
      <!-- 对话框后面的遮罩 -->
      <SolidColorBrush x:Key="Scrim" Color="#8C000000" />
      <!-- 输入框、复选框、次按钮的边（≥ 3:1） -->
      <SolidColorBrush x:Key="ControlBorder" Color="#7783A0" />
      <SolidColorBrush x:Key="ControlHover" Color="#2D3746" />
      <SolidColorBrush x:Key="ControlPressed" Color="#37404E" />
      <SolidColorBrush x:Key="ControlSelected" Color="#2E3D5A" />
      <!-- 焦点环 -->
      <SolidColorBrush x:Key="Focus" Color="#A9C4FF" />
      <!-- 琥珀：只给“开始游戏”这一类按钮 -->
      <SolidColorBrush x:Key="Play" Color="#F6A93B" />
      <SolidColorBrush x:Key="PlayHover" Color="#FFB955" />
      <SolidColorBrush x:Key="PlayPressed" Color="#E0952A" />
      <SolidColorBrush x:Key="OnPlay" Color="#1E1404" />
      <!-- 浅色下给琥珀按钮描边 -->
      <SolidColorBrush x:Key="PlayBorder" Color="#00000000" />
      <SolidColorBrush x:Key="PlayText" Color="#F8B85C" />
      <!-- 琥珀按钮的光晕 -->
      <SolidColorBrush x:Key="PlayGlow" Color="#40F6A93B" />
      <SolidColorBrush x:Key="PlayTint" Color="#3E3C3A" />
      <!-- 红点角标 -->
      <SolidColorBrush x:Key="Badge" Color="#FF6B6B" />
      <SolidColorBrush x:Key="OnBadge" Color="#1F0606" />
      <!-- 灰色数字角标 -->
      <SolidColorBrush x:Key="BadgeMuted" Color="#455068" />
      <SolidColorBrush x:Key="OnBadgeMuted" Color="#E8EDF5" />
      <!-- 线描插画 -->
      <SolidColorBrush x:Key="IlloLine" Color="#93B4FF" />
      <SolidColorBrush x:Key="IlloFill" Color="#202A3A" />
      <!-- 加载器标签文字 -->
      <SolidColorBrush x:Key="LoaderVanilla" Color="#7DD08A" />
      <SolidColorBrush x:Key="LoaderFabric" Color="#E2C49A" />
      <SolidColorBrush x:Key="LoaderForge" Color="#A9BCD6" />
      <SolidColorBrush x:Key="LoaderNeoForge" Color="#F5A66B" />
      <SolidColorBrush x:Key="LoaderQuilt" Color="#C3A6FA" />
      <SolidColorBrush x:Key="LoaderOptiFine" Color="#F08C8C" />
      <!-- 日志级别（在 Sunken 上） -->
      <SolidColorBrush x:Key="LogDebug" Color="#8D98AA" />
      <SolidColorBrush x:Key="LogInfo" Color="#E8EDF5" />
      <SolidColorBrush x:Key="LogWarn" Color="#F0D46A" />
      <SolidColorBrush x:Key="LogError" Color="#FF8C87" />
      <SolidColorBrush x:Key="LogFatal" Color="#FF7AA8" />
      <SolidColorBrush x:Key="LogJay" Color="#F8B85C" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <!-- 内容区底色（设计稿 Base） -->
      <SolidColorBrush x:Key="PageBg" Color="#F3F5F9" />
      <!-- 卡片、列表容器、面板 -->
      <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
      <!-- 卡片里再凸起的块（设计稿 Raised） -->
      <SolidColorBrush x:Key="SurfaceRaised" Color="#EEF1F6" />
      <!-- 分隔线、卡片 1px 边（设计稿 Divider） -->
      <SolidColorBrush x:Key="BorderSubtle" Color="#D3D9E2" />
      <!-- 侧栏、顶栏（设计稿 Frame） -->
      <SolidColorBrush x:Key="SidebarBg" Color="#E4E9F0" />
      <!-- 正文、标题（设计稿 Text） -->
      <SolidColorBrush x:Key="TextPrimary" Color="#111722" />
      <SolidColorBrush x:Key="TextSecondary" Color="#455164" />
      <SolidColorBrush x:Key="TextTertiary" Color="#566275" />
      <!-- 松鸦蓝：普通主按钮、开关、进度、选中 -->
      <SolidColorBrush x:Key="Accent" Color="#2C59CC" />
      <SolidColorBrush x:Key="AccentHover" Color="#3A67DA" />
      <SolidColorBrush x:Key="AccentPressed" Color="#2149B0" />
      <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
      <!-- 链接、蓝色文字 -->
      <SolidColorBrush x:Key="AccentText" Color="#2550BF" />
      <SolidColorBrush x:Key="Success" Color="#16804F" />
      <SolidColorBrush x:Key="SuccessText" Color="#11683F" />
      <!-- 柠檬黄，和琥珀拉开色相 -->
      <SolidColorBrush x:Key="Warning" Color="#9A7400" />
      <SolidColorBrush x:Key="WarningText" Color="#7A5C00" />
      <SolidColorBrush x:Key="Danger" Color="#C93030" />
      <SolidColorBrush x:Key="DangerText" Color="#B02828" />
      <SolidColorBrush x:Key="OnDanger" Color="#FFFFFF" />
      <SolidColorBrush x:Key="DisabledFill" Color="#F3F4F5" />
      <!-- 设计稿 TextDisabled -->
      <SolidColorBrush x:Key="DisabledText" Color="#7C8698" />
      <!-- 设计稿 NavText -->
      <SolidColorBrush x:Key="SidebarText" Color="#111722" />
      <!-- 设计稿 NavTextMuted -->
      <SolidColorBrush x:Key="SidebarTextMuted" Color="#455164" />
      <!-- 设计稿 NavItemSelected，只在侧栏用 -->
      <SolidColorBrush x:Key="NavSelected" Color="#CED7EC" />
      <!-- 设计稿 NavItemHover -->
      <SolidColorBrush x:Key="NavHover" Color="#D9DEE6" />
      <!-- 色调底：已按叠在 Surface 上算好 -->
      <SolidColorBrush x:Key="AccentTint" Color="#E5EBF9" />
      <SolidColorBrush x:Key="SuccessTint" Color="#E7F2ED" />
      <SolidColorBrush x:Key="WarningTint" Color="#F5F1E5" />
      <SolidColorBrush x:Key="DangerTint" Color="#F9EAEA" />
      <!-- 菜单、抽屉、对话框、Toast -->
      <SolidColorBrush x:Key="Overlay" Color="#FFFFFF" />
      <!-- 日志、代码的凹陷底 -->
      <SolidColorBrush x:Key="Sunken" Color="#EBEEF3" />
      <!-- 输入框底 -->
      <SolidColorBrush x:Key="InputBg" Color="#FFFFFF" />
      <!-- 对话框后面的遮罩 -->
      <SolidColorBrush x:Key="Scrim" Color="#590B1220" />
      <!-- 输入框、复选框、次按钮的边（≥ 3:1） -->
      <SolidColorBrush x:Key="ControlBorder" Color="#6E7B8F" />
      <SolidColorBrush x:Key="ControlHover" Color="#F3F3F5" />
      <SolidColorBrush x:Key="ControlPressed" Color="#E9EAED" />
      <SolidColorBrush x:Key="ControlSelected" Color="#E5EBF9" />
      <!-- 焦点环 -->
      <SolidColorBrush x:Key="Focus" Color="#2C59CC" />
      <!-- 琥珀：只给“开始游戏”这一类按钮 -->
      <SolidColorBrush x:Key="Play" Color="#F6A93B" />
      <SolidColorBrush x:Key="PlayHover" Color="#FFB955" />
      <SolidColorBrush x:Key="PlayPressed" Color="#E0952A" />
      <SolidColorBrush x:Key="OnPlay" Color="#1E1404" />
      <!-- 浅色下给琥珀按钮描边 -->
      <SolidColorBrush x:Key="PlayBorder" Color="#A3620C" />
      <SolidColorBrush x:Key="PlayText" Color="#8F520A" />
      <!-- 琥珀按钮的光晕 -->
      <SolidColorBrush x:Key="PlayGlow" Color="#4DF6A93B" />
      <SolidColorBrush x:Key="PlayTint" Color="#FEF5E7" />
      <!-- 红点角标 -->
      <SolidColorBrush x:Key="Badge" Color="#C9302C" />
      <SolidColorBrush x:Key="OnBadge" Color="#FFFFFF" />
      <!-- 灰色数字角标 -->
      <SolidColorBrush x:Key="BadgeMuted" Color="#5A6578" />
      <SolidColorBrush x:Key="OnBadgeMuted" Color="#FFFFFF" />
      <!-- 线描插画 -->
      <SolidColorBrush x:Key="IlloLine" Color="#3A67DA" />
      <SolidColorBrush x:Key="IlloFill" Color="#E5EBF9" />
      <!-- 加载器标签文字 -->
      <SolidColorBrush x:Key="LoaderVanilla" Color="#236B30" />
      <SolidColorBrush x:Key="LoaderFabric" Color="#7D5E30" />
      <SolidColorBrush x:Key="LoaderForge" Color="#3D5675" />
      <SolidColorBrush x:Key="LoaderNeoForge" Color="#9C4710" />
      <SolidColorBrush x:Key="LoaderQuilt" Color="#6A3FC2" />
      <SolidColorBrush x:Key="LoaderOptiFine" Color="#A3303A" />
      <!-- 日志级别（在 Sunken 上） -->
      <SolidColorBrush x:Key="LogDebug" Color="#566275" />
      <SolidColorBrush x:Key="LogInfo" Color="#111722" />
      <SolidColorBrush x:Key="LogWarn" Color="#7A5C00" />
      <SolidColorBrush x:Key="LogError" Color="#B02828" />
      <SolidColorBrush x:Key="LogFatal" Color="#A3245A" />
      <SolidColorBrush x:Key="LogJay" Color="#8F520A" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
