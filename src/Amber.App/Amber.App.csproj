<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Jay</AssemblyName>
    <AssemblyTitle>Jay</AssemblyTitle>
    <Product>Jay</Product>
    <Description>Jay Minecraft Launcher</Description>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- 这两个资源只属于 Windows apphost；macOS/Linux 发布时不要交给 Win32 资源编译器。 -->
    <ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('Windows'))">Assets\jay.ico</ApplicationIcon>
    <TieredPGO>false</TieredPGO>
    <!-- Avalonia 的编译统计在 src/Directory.Build.targets 里统一关掉。 -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\jay.ico" />
    <AvaloniaResource Include="Assets\jay.png" />
    <!-- 等宽字体 JetBrains Mono（SIL OFL 1.1，见 Assets/Fonts/OFL-JetBrainsMono.txt）随所有平台打包：邀请码、安全码、日志都用它。 -->
    <AvaloniaResource Include="Assets\Fonts\JetBrainsMono-Regular.ttf" />
    <AvaloniaResource Include="Assets\Fonts\JetBrainsMono-Bold.ttf" />
    <!-- Manrope for Latin letters and digits, VT323 for pixel digits on version tags (both SIL OFL 1.1, see Assets/Fonts/OFL-Manrope.txt and OFL-VT323.txt). -->
    <AvaloniaResource Include="Assets\Fonts\Manrope-Regular.ttf" />
    <AvaloniaResource Include="Assets\Fonts\Manrope-SemiBold.ttf" />
    <AvaloniaResource Include="Assets\Fonts\Manrope-Bold.ttf" />
    <AvaloniaResource Include="Assets\Fonts\VT323-Regular.ttf" />
  </ItemGroup>

  <!-- Linux 发行版不一定有中文字体：只给 Linux 版打包思源黑体（Noto Sans SC，SIL OFL 1.1，见 Assets/Fonts/OFL.txt）做回退。 -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Linux')))">
    <AvaloniaResource Include="Assets\Fonts\NotoSansSC-Regular.otf" />
  </ItemGroup>
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Linux')))">
    <DefineConstants>$(DefineConstants);JAY_BUNDLED_CJK_FONT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Amber.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Amber.Core\Amber.Core.csproj" />
  </ItemGroup>

</Project>
