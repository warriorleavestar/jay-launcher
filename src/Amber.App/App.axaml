<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Amber.App.App"
             xmlns:l="using:Amber.App.Localization"
             Name="Jay" RequestedThemeVariant="Default">
  <Application.DataTemplates>
    <!-- 下拉框的选项：文字跟着界面语言换，列表本身不变。 -->
    <DataTemplate DataType="l:OptionItem">
      <TextBlock Text="{Binding Label}" />
    </DataTemplate>
  </Application.DataTemplates>
  <!-- 资源要写在样式前面：样式里的 StaticResource 在加载时就查，后面的资源那时还没有。 -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Jay/Themes/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector=":is(Window)">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="Background" Value="{DynamicResource PageBg}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <!-- 提示条：色调底、左侧一道强调色（改版规格的 callout.info / warning） -->
    <Style Selector="Border.callout">
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Border.callout.info">
      <Setter Property="Background" Value="{DynamicResource AccentTint}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Border.callout.warning">
      <Setter Property="Background" Value="{DynamicResource WarningTint}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Warning}" />
    </Style>
    <!-- 胶囊：类型和状态标签（改版规格 4.4：正式版 Success、快照 Accent、其余中性色） -->
    <Style Selector="Border.pill">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
      <Setter Property="Padding" Value="8,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource PageBg}" />
    </Style>
    <Style Selector="Border.pill > TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="Border.pill.success">
      <Setter Property="Background" Value="{DynamicResource SuccessTint}" />
    </Style>
    <Style Selector="Border.pill.success > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SuccessText}" />
    </Style>
    <Style Selector="Border.pill.accent">
      <Setter Property="Background" Value="{DynamicResource AccentTint}" />
    </Style>
    <Style Selector="Border.pill.accent > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
      <Setter Property="Padding" Value="{StaticResource CardPadding}" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="{StaticResource FontTitle}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="{StaticResource FontSubtitle}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
    </Style>
    <!-- 兼容提示：没问题时是普通的次要文字，有问题时用警告色 -->
    <Style Selector="TextBlock.compat">
      <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
    </Style>
    <Style Selector="TextBlock.compat.problem">
      <Setter Property="Foreground" Value="{DynamicResource WarningText}" />
    </Style>
    <!-- 表单：左边一列是标签，宽度按内容，太长就换行（英文、日文的标签比中文长）；值那一列里的说明（hint）不受限，跟着列宽排 -->
    <Style Selector="Grid.form > TextBlock:not(.hint)">
      <Setter Property="MaxWidth" Value="190" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- 说明文字：用 TextSecondary，不再用半透明（半透明在色调底上对比度不够） -->
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 按钮四种：primary（每块区域最多一个）、secondary、ghost、danger。 -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHover}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentPressed}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DangerTint}" />
      <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
    </Style>
    <!-- 两步确认的待确认状态：实心红底 -->
    <Style Selector="Button.danger.armed">
      <Setter Property="Background" Value="{DynamicResource Danger}" />
      <Setter Property="Foreground" Value="{DynamicResource OnDanger}" />
    </Style>
    <Style Selector="Button.danger.armed:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Danger}" />
      <Setter Property="Foreground" Value="{DynamicResource OnDanger}" />
    </Style>
    <!-- ⋯ 菜单里的删除项：Danger 色文字 -->
    <Style Selector="MenuItem.danger">
      <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
    </Style>
    <!-- 禁用态统一：DisabledFill + DisabledText（不再用半透明琥珀） -->
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DisabledFill}" />
      <Setter Property="Foreground" Value="{DynamicResource DisabledText}" />
    </Style>

    <!-- 导航：选中项左边一条琥珀色指示条（在 MainWindow 的模板里），背景稍亮 -->
    <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavSelected}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavHover}" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
  </Application.Styles>
</Application>
