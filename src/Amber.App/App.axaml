<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Amber.App.App"
             xmlns:l="using:Amber.App.Localization"
             Name="Jay" RequestedThemeVariant="Default">
  <Application.DataTemplates>
    <!-- 下拉框的选项：文字跟着界面语言换，列表本身不变。 -->
    <DataTemplate DataType="l:OptionItem">
      <TextBlock Text="{Binding Label}" />
    </DataTemplate>
  </Application.DataTemplates>
  <!-- 资源要写在样式前面。token 一律用 DynamicResource：导入的主题包会在运行时替换它们。 -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Jay/Themes/Tokens.axaml" />
        <ResourceInclude Source="avares://Jay/Themes/Icons.axaml" />
        <ResourceInclude Source="avares://Jay/Themes/Safety.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector=":is(Window)">
      <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
      <Setter Property="Background" Value="{DynamicResource PageBg}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <!-- 提示条：色调底、左侧一道强调色（改版规格的 callout.info / warning） -->
    <Style Selector="Border.callout">
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Border.callout.info">
      <Setter Property="Background" Value="{DynamicResource AccentTint}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Border.callout.warning">
      <Setter Property="Background" Value="{DynamicResource WarningTint}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Warning}" />
    </Style>
    <!-- 字段下方的校验提示（改版规格 3.10：不通过时红字提示，保留输入） -->
    <Style Selector="TextBlock.field-error">
      <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
      <Setter Property="FontSize" Value="{DynamicResource FontCaption}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- ↺ 恢复默认：图标按钮，至少 32×32 -->
    <Style Selector="Button.reset">
      <Setter Property="MinWidth" Value="32" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <!-- Segmented choice: a row of radio keys. The chosen one is tonal azure with an azure edge (not a filled accent block). -->
    <Style Selector="UniformGrid.segmented > RadioButton, StackPanel.segmented > RadioButton">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="{DynamicResource MinHitSize}" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="SegmentBorder" Background="{DynamicResource Sunken}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                  Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource RadiusMd}">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="UniformGrid.segmented > RadioButton:checked /template/ Border#SegmentBorder, StackPanel.segmented > RadioButton:checked /template/ Border#SegmentBorder">
      <Setter Property="Background" Value="{DynamicResource ControlSelected}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="UniformGrid.segmented > RadioButton:checked, StackPanel.segmented > RadioButton:checked">
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="UniformGrid.segmented > RadioButton:pointerover:not(:checked) /template/ Border#SegmentBorder, StackPanel.segmented > RadioButton:pointerover:not(:checked) /template/ Border#SegmentBorder">
      <Setter Property="Background" Value="{DynamicResource ControlHover}" />
    </Style>
    <Style Selector="UniformGrid.segmented > RadioButton:focus-visible /template/ Border#SegmentBorder, StackPanel.segmented > RadioButton:focus-visible /template/ Border#SegmentBorder">
      <Setter Property="BorderBrush" Value="{DynamicResource Focus}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <!-- 侧边栏底色写成样式（不写在元素上），主题包的组件样式才盖得住。窗口底色同理，在上面的 :is(Window) 里。 -->
    <Style Selector="Border.sidebar">
      <Setter Property="Background" Value="{DynamicResource SidebarBg}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
      <Setter Property="Padding" Value="{DynamicResource CardPadding}" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <!-- Drag-and-drop zones (§6.25): a dashed accent frame, filled when the files are over it. -->
    <Style Selector="Border.drop-target">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Width" Value="240" />
    </Style>
    <Style Selector="Border.compact Border.drop-target">
      <Setter Property="Width" Value="320" />
    </Style>
    <Style Selector="Border.drop-target.hovered">
      <Setter Property="Background" Value="{DynamicResource AccentTint}" />
    </Style>

    <Style Selector="TextBlock.h1">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="{DynamicResource FontTitle}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="{DynamicResource FontSubtitle}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="{DynamicResource FontCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
    </Style>
    <!-- 兼容提示：没问题时是普通的次要文字，有问题时用警告色 -->
    <Style Selector="TextBlock.compat">
      <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
    </Style>
    <Style Selector="TextBlock.compat.problem">
      <Setter Property="Foreground" Value="{DynamicResource WarningText}" />
    </Style>
    <!-- 表单：左边一列是标签，宽度按内容，太长就换行（英文、日文的标签比中文长）；值那一列里的说明（hint）不受限，跟着列宽排 -->
    <Style Selector="Grid.form > TextBlock:not(.hint)">
      <Setter Property="MaxWidth" Value="190" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- 说明文字：用 TextSecondary，不再用半透明（半透明在色调底上对比度不够） -->
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
      Buttons ("美术风格": one shape, each look has one job). Every Button is a tonal key unless a class says otherwise:
        play     amber, the one main action on a screen (Themes/Controls.axaml)
        primary  jay azure, the confirmation inside a panel or card
        (none) / secondary  tonal key, any other action
        ghost    quiet: no key until hovered; minor entries, icon buttons, whole rows. There are no underlined text links.
        danger   red label; danger.solid and danger.armed are filled red
    -->
    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
      <Setter Property="Padding" Value="13,5" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{DynamicResource KeycapShadow}" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ControlHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ControlPressed}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHover}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentPressed}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ControlPressed}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DangerTint}" />
      <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
    </Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DangerTint}" />
      <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
    </Style>
    <!-- 两步确认的待确认状态：实心红底 -->
    <Style Selector="Button.danger.armed">
      <Setter Property="Background" Value="{DynamicResource Danger}" />
      <Setter Property="Foreground" Value="{DynamicResource OnDanger}" />
    </Style>
    <Style Selector="Button.danger.armed:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Danger}" />
      <Setter Property="Foreground" Value="{DynamicResource OnDanger}" />
    </Style>
    <!-- ⋯ 菜单里的删除项：Danger 色文字 -->
    <Style Selector="MenuItem.danger">
      <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
    </Style>
    <!-- 禁用态统一：DisabledFill + DisabledText（不再用半透明琥珀） -->
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DisabledFill}" />
      <Setter Property="Foreground" Value="{DynamicResource DisabledText}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Navigation: the selected item carries the wing bars on its left edge (in MainWindow's item template) over a slightly lighter fill. -->
    <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavSelected}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavHover}" />
    </Style>
    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <StyleInclude Source="avares://Jay/Themes/Controls.axaml" />
  </Application.Styles>
</Application>
