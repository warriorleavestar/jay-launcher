<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="using:Amber.App.Services"
             xmlns:l="using:Amber.App.Localization"
             xmlns:vm="using:Amber.App.ViewModels"
             xmlns:c="using:Amber.App.Views.Controls"
             xmlns:install="using:Amber.Core.Install"
             x:Class="Amber.App.Views.DownloadPage"
             x:DataType="vm:DownloadViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
    <TextBlock svc:ThemeRegion.Name="downloads.title" Classes="h1" Text="{l:T download.heading}" />
    <Grid svc:ThemeRegion.Name="downloads.search" Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
      <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" MinWidth="110" />
      <TextBox Grid.Column="1" Text="{Binding Search}" PlaceholderText="{l:T download.search.placeholder}" Margin="10,0" />
      <Button Grid.Column="2" Content="{l:T common.refresh}" Command="{Binding RefreshCommand}" />
    </Grid>

    <!-- 热门版本芯片（改版规格 4.4）：最新正式版 + 和新手卡同一组热门版本，点了直接打开安装面板。 -->
    <WrapPanel svc:ThemeRegion.Name="downloads.filters" Grid.Row="2" ItemSpacing="8" LineSpacing="8" Margin="0,0,0,10">
      <TextBlock Classes="hint" Text="{l:T onboarding.install.hot}" VerticalAlignment="Center" />
      <Button x:Name="HotLatestButton" Classes="secondary" Content="{Binding LatestReleaseLabel}" Command="{Binding ConfigureLatestCommand}" IsVisible="{Binding HasLatestRelease}" />
      <ItemsControl x:Name="HotList" ItemsSource="{Binding HotVersions}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel ItemSpacing="8" LineSpacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:HotVersion">
            <Button Classes="secondary" Content="{Binding Label}"
                    Command="{Binding #HotList.((vm:DownloadViewModel)DataContext).ConfigureHotCommand}" CommandParameter="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </WrapPanel>

    <Grid svc:ThemeRegion.Name="downloads.body" x:Name="BodyGrid" Grid.Row="3" ColumnDefinitions="*,Auto">
      <Border Classes="card" Padding="6">
        <Grid>
          <!-- 加载和出错（改版规格 4.4 / 5.5）：加载只给 Spinner；出错写原因并给【重试】【切换下载源】。 -->
          <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" IsVisible="{Binding IsLoadingList}">
            <ProgressBar IsIndeterminate="True" Width="180" HorizontalAlignment="Center" />
            <TextBlock Classes="hint" Text="{l:T download.status.fetching_versions}" TextAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Margin="12" IsVisible="{Binding HasListError}">
            <TextBlock x:Name="ListErrorText" Text="{Binding ListError}" Foreground="{DynamicResource DangerText}" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Classes="hint" Text="{Binding SourceText}" TextAlignment="Center" TextWrapping="Wrap" />
            <WrapPanel HorizontalAlignment="Center" ItemSpacing="8" LineSpacing="8">
              <Button x:Name="RetryListButton" Classes="primary" Content="{l:T common.retry}" Command="{Binding RefreshCommand}" />
              <Button x:Name="SwitchSourceButton" Content="{l:T download.source.switch}" Command="{Binding SwitchDownloadSourceCommand}" />
            </WrapPanel>
          </StackPanel>
          <ListBox x:Name="VersionList" ItemsSource="{Binding Items}" Background="Transparent" IsVisible="{Binding !!Items.Count}">
            <ListBox.Styles>
              <Style Selector="ListBoxItem"><Setter Property="Padding" Value="8,4" /></Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <!-- 两行：版本号 + 类型胶囊 + 已安装芯片；第二行日期。安装按钮固定显示，双击或回车也能打开安装面板。 -->
              <DataTemplate DataType="vm:RemoteVersionItem">
                <Grid ColumnDefinitions="*,Auto" Margin="6,0">
                  <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,10,0">
                    <WrapPanel ItemSpacing="6" LineSpacing="4">
                      <TextBlock Text="{Binding Id}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Id}" />
                      <Border Classes="pill" Classes.success="{Binding IsRelease}" Classes.accent="{Binding IsSnapshot}">
                        <TextBlock Text="{Binding TypeText}" />
                      </Border>
                      <Border Classes="pill success" IsVisible="{Binding Installed}">
                        <TextBlock Text="{l:T download.installed.chip}" />
                      </Border>
                    </WrapPanel>
                    <TextBlock Text="{Binding Date}" FontSize="{DynamicResource FontCaption}" Foreground="{DynamicResource TextTertiary}" />
                  </StackPanel>
                  <Button Grid.Column="1" MinWidth="96" HorizontalContentAlignment="Center" VerticalAlignment="Center"
                          Content="{Binding InstallLabel}"
                          Command="{Binding $parent[ListBox].((vm:DownloadViewModel)DataContext).ConfigureCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- 安装面板：选加载器和名字 -->
      <!-- 宽屏在右侧占一列（260–340）；窄窗时由后台代码改成盖在列表上的抽屉，Esc 关闭。 -->
      <Border x:Name="InstallPanel" Grid.Column="1" Classes="card" MinWidth="260" MaxWidth="340" Width="300" Margin="14,0,0,14" IsVisible="{Binding IsConfiguring}">
        <ScrollViewer>
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="{Binding InstallTitle}" Margin="0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding InstallTitle}" />
            <TextBlock Text="{l:T download.loader.label}" />
            <ComboBox ItemsSource="{Binding LoaderChoices}" SelectedItem="{Binding SelectedLoader}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="vm:LoaderChoice">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <StackPanel Spacing="10" IsVisible="{Binding NeedsLoaderVersion}">
              <TextBlock Text="{l:T download.loader.version}" />
              <ComboBox ItemsSource="{Binding LoaderVersions}" SelectedItem="{Binding SelectedLoaderVersion}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="install:LoaderVersion">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Version}" />
                      <TextBlock Text="{Binding Note}" Classes="hint" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <CheckBox Content="{l:T common.show_unstable}" IsChecked="{Binding ShowUnstableLoaders}" />
              <TextBlock Classes="hint" Text="{Binding LoaderHint}" />
            </StackPanel>

            <TextBlock Text="{l:T download.version.name}" />
            <TextBox Text="{Binding CustomName}" />
            <TextBlock Classes="hint" Text="{l:T download.version.name_hint}" />

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
              <Button Classes="primary" Content="{l:T download.install.start}" Command="{Binding InstallCommand}" Padding="22,8" />
              <Button Content="{l:T common.close}" Command="{Binding CloseConfigureCommand}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- 成功卡：装好后给出下一步 -->
      <Border x:Name="InstalledCard" Grid.Column="1" Classes="card" MinWidth="260" MaxWidth="340" Width="300" Margin="14,0,0,14" VerticalAlignment="Top" IsVisible="{Binding HasInstalled}">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Margin="0" Text="{Binding InstalledTitle}" TextWrapping="Wrap" />
          <TextBlock Classes="hint" Text="{l:T download.installed.hint}" TextWrapping="Wrap" />
          <Button Classes="primary" Content="{l:T download.installed.launch}" Command="{Binding LaunchInstalledCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button Content="{l:T download.installed.add_mods}" Command="{Binding AddModsToInstalledCommand}" IsVisible="{Binding InstalledHasLoader}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button Content="{l:T download.installed.open}" Command="{Binding OpenInstalledCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button Classes="ghost" Content="{l:T common.close}" Command="{Binding CloseInstalledCommand}" HorizontalAlignment="Right" />
        </StackPanel>
      </Border>
    </Grid>

    <Border svc:ThemeRegion.Name="downloads.status" Grid.Row="4" Classes="card" Margin="0">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="6" VerticalAlignment="Center">
          <c:StatusBar Message="{Binding StatusInfo}" />
          <ProgressBar Value="{Binding Progress}" Maximum="100" IsVisible="{Binding IsBusy}" />
          <TextBlock x:Name="WaitTextBlock" Classes="hint" Text="{Binding WaitText}" IsVisible="{Binding IsBusy}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Column="1" Content="{l:T common.cancel}" Command="{Binding CancelInstallCommand}" IsVisible="{Binding IsBusy}" Margin="12,0,0,0" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
