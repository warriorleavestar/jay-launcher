<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Amber.App.ViewModels"
             xmlns:c="using:Amber.App.Views.Controls"
             xmlns:v="using:Amber.App.Views"
             xmlns:l="using:Amber.App.Localization"
             xmlns:diag="using:Amber.Core.Diagnostics"
             xmlns:svc="using:Amber.App.Services"
             x:Class="Amber.App.Views.HomePage"
             x:DataType="vm:HomeViewModel">
  <Grid RowDefinitions="Auto,*,Auto">
    <TextBlock Classes="h1" Text="{l:T home.launch}" svc:ThemeRegion.Name="home.title" />
    <ScrollViewer Grid.Row="1">
      <StackPanel>
        <!-- 启动失败（没进游戏就失败了）：一句话原因 + 按顺序排好的修复按钮（旧规格 N1） -->
        <Border x:Name="FailureCard" Classes="error-bar" Margin="0,0,0,12" IsVisible="{Binding HasFailure}">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <Path Classes="icon" Data="{StaticResource Icon.Warning}" Width="20" Height="20" VerticalAlignment="Top" Stroke="{DynamicResource DangerText}" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{Binding Failure.Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Failure.Reason}" Classes="hint" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Button Grid.Column="2" Classes="ghost icon-only" Command="{Binding DismissFailureCommand}" VerticalAlignment="Top"
                      ToolTip.Tip="{l:T home.failure.dismiss}" AutomationProperties.Name="{l:T home.failure.dismiss}">
                <Path Classes="icon" Data="{StaticResource Icon.Close}" Width="16" Height="16" />
              </Button>
            </Grid>
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <ItemsControl x:Name="FailureFixes" ItemsSource="{Binding Failure.Buttons}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:LaunchFixButton">
                    <Button Content="{Binding Label}" Classes.secondary="{Binding !IsPrimary}"
                            Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).FixCommand}" CommandParameter="{Binding Fix}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="secondary" Content="{l:T home.failure.export}" IsVisible="{Binding Failure.CanExport}" Click="ExportFailure_Click" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <!-- 游戏在运行时又要启动：问一声，允许同时开两个客户端 -->
        <Border Classes="callout warning" svc:ThemeRegion.Name="home.pending" IsVisible="{Binding HasPendingLaunch}" Margin="0,0,0,12">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
              <Button Classes="primary" Content="{l:T home.multi.launch_anyway}" Command="{Binding LaunchAnywayCommand}" />
              <Button Content="{l:T common.cancel}" Command="{Binding DismissPendingLaunchCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding PendingLaunchText}" TextWrapping="Wrap" VerticalAlignment="Center" />
          </DockPanel>
        </Border>

        <!-- 新手卡：没有账号或没有实例时替换实例卡（改版规格 3.1） -->
        <v:OnboardingCard x:Name="OnboardingCard" svc:ThemeRegion.Name="home.onboarding" DataContext="{Binding Onboarding}" />

        <Border Classes="card" svc:ThemeRegion.Name="home.instance" IsVisible="{Binding ShowInstanceCard}">
          <Grid Classes="form" ColumnSpacing="12" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Text="{l:T home.version.label}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"
                      HorizontalAlignment="Stretch" PlaceholderText="{l:T home.version.empty}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="hint" FontSize="12" Text="{Binding VersionInfo}" Margin="2,4,0,0" />

            <TextBlock Grid.Row="2" Text="{l:T home.account.label}" VerticalAlignment="Center" Margin="0,12,0,0" />
            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                      HorizontalAlignment="Stretch" Margin="0,12,0,0" PlaceholderText="{l:T home.account.empty}" />

            <TextBlock Grid.Row="3" Text="{l:T home.memory.maximum}" VerticalAlignment="Center" Margin="0,12,0,0" />
            <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="Auto,*,90" Margin="0,12,0,0">
              <CheckBox Content="{l:T common.automatic}" IsChecked="{Binding AutoMemory}" Margin="0,0,12,0" />
              <Slider Grid.Column="1" Minimum="1024" Maximum="{Binding TotalMemoryMb}" Value="{Binding MaxMemoryMb}"
                      TickFrequency="512" IsSnapToTickEnabled="True" IsEnabled="{Binding !AutoMemory}" />
              <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" IsVisible="{Binding !AutoMemory}"
                         Text="{Binding MaxMemoryMb, StringFormat='{}{0} MB'}" />
              <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" IsVisible="{Binding AutoMemory}"
                         Classes="hint" Text="{l:T home.memory.by_mod_count}" />
            </Grid>
          </Grid>
        </Border>

        <Border Classes="card" svc:ThemeRegion.Name="home.crash" IsVisible="{Binding HasCrash}" BorderBrush="{DynamicResource Accent}" BorderThickness="1">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="{l:T home.crash.causes}" Margin="0" />
            <ItemsControl ItemsSource="{Binding Crash.Findings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="diag:CrashFinding">
                  <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Advice}" Classes="hint" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="hint" Text="{Binding Crash.Summary}" IsVisible="{Binding !Crash.Findings.Count}" TextWrapping="Wrap" />
            <StackPanel IsVisible="{Binding !!Crash.SuspectMods.Count}" Spacing="4">
              <TextBlock Text="{l:T home.crash.suspect_mods}" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding Crash.SuspectMods}" />
            </StackPanel>
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button Content="{l:T home.crash.view_log}" Command="{Binding ViewLogCommand}" />
              <Button Content="{l:T home.crash.open_report}" Command="{Binding OpenLatestCrashFileCommand}" />
              <Button Content="{l:T home.crash.export}" Click="ExportCrash_Click" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border x:Name="LaunchStatusCard" svc:ThemeRegion.Name="home.launch" Grid.Row="2" Classes="card" Margin="0">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <StackPanel VerticalAlignment="Center" Spacing="6">
          <c:StatusBar x:Name="LaunchStatus" Message="{Binding StatusInfo}">
            <c:StatusBar.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.Or}">
                <Binding Path="IsBusy" />
                <Binding Path="!IsVisible" ElementName="BakeWarnings" />
              </MultiBinding>
            </c:StatusBar.IsVisible>
          </c:StatusBar>
          <Panel IsVisible="{Binding !IsBusy}">
            <c:BakeNoticeHost x:Name="BakeWarnings" />
          </Panel>
          <ProgressBar Value="{Binding Progress}" Maximum="100" IsVisible="{Binding ShowProgress}" IsIndeterminate="{Binding ProgressIndeterminate}" />
        </StackPanel>
        <!-- 退出等太久才出现；确认文字放在 Flyout 里，不塞进主按钮 -->
        <Button Grid.Column="1" x:Name="ForceKillButton" Classes="danger" Content="{l:T home.button.force_kill}" IsVisible="{Binding ShowForceKill}"
                Margin="12,0,0,0" Padding="18,10" VerticalAlignment="Center">
          <Button.Flyout>
            <Flyout Placement="TopEdgeAlignedRight">
              <StackPanel Spacing="10" MaxWidth="280">
                <TextBlock Text="{l:T home.force_kill.confirm}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <Button Classes="danger" Content="{l:T home.button.force_kill}" Command="{Binding ForceKillCommand}" Click="CloseForceKillFlyout" />
                  <Button Content="{l:T common.cancel}" Click="CloseForceKillFlyout" />
                </StackPanel>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <StackPanel Grid.Column="2" Margin="12,0,0,0" Spacing="4" VerticalAlignment="Center">
          <Button x:Name="PrimaryButton" Classes="play" Content="{Binding PrimaryLabel}" Command="{Binding PrimaryCommand}" ToolTip.Tip="Ctrl+Enter"
                  MinHeight="48" MinWidth="160" Padding="28,10" FontSize="16" FontWeight="SemiBold"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
          <TextBlock Classes="hint" Text="{Binding AccountHint}" HorizontalAlignment="Center" MaxWidth="200"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding AccountHint}" IsVisible="{Binding !!AccountHint.Length}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
