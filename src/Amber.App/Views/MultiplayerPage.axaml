<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="using:Amber.App.Services"
             xmlns:l="using:Amber.App.Localization"
             xmlns:vm="using:Amber.App.ViewModels"
             xmlns:pub="using:Amber.Core.Multiplayer.Public"
             xmlns:c="using:Amber.App.Views.Controls"
             xmlns:v="using:Amber.App.Views"
             xmlns:safety="using:Amber.App.Controls.Safety"
             x:Class="Amber.App.Views.MultiplayerPage"
             x:DataType="vm:MultiplayerViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
    <StackPanel Spacing="6" Margin="0,0,14,0">
      <TextBlock svc:ThemeRegion.Name="multiplayer.title" Classes="h1" Text="{l:T multiplayer.title}" />
      <!-- Privacy plan item 15: while "Launch without sandbox" is on, this line stays on every tab. -->
      <Border x:Name="NoSandboxLine" Classes="callout warning" Padding="10,6" Margin="0,0,0,8" IsVisible="{Binding RunsWithoutSandbox}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <TextBlock Text="{l:T multiplayer.no_sandbox}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" />
          <Button x:Name="NoSandboxFixButton" Grid.Column="1" Classes="ghost small" Content="{l:T multiplayer.no_sandbox.fix}" Command="{Binding OpenSandboxSettingsCommand}" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </StackPanel>

    <!-- Tabs (official §6.14): play · public rooms · servers · settings. A scrolling segmented strip in compact windows. -->
    <ScrollViewer svc:ThemeRegion.Name="multiplayer.tabs" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,14,10">
      <StackPanel x:Name="MpTabs" Orientation="Horizontal" Classes="segmented" Spacing="4">
        <RadioButton x:Name="PlayTabButton" GroupName="MpTab" IsChecked="{Binding IsPlayTab, Mode=OneWay}" Command="{Binding ShowTabCommand}" CommandParameter="play" ><TextBlock Text="{l:T multiplayer.tab.play}" /></RadioButton>
        <RadioButton x:Name="PublicTabButton" GroupName="MpTab" IsChecked="{Binding IsPublicTab, Mode=OneWay}" Command="{Binding ShowTabCommand}" CommandParameter="public" IsVisible="{Binding ShowPublicNetworks}" ><TextBlock Text="{l:T multiplayer.tab.public}" /></RadioButton>
        <RadioButton x:Name="ServersTabButton" GroupName="MpTab" IsChecked="{Binding IsServersTab, Mode=OneWay}" Command="{Binding ShowTabCommand}" CommandParameter="servers" ><TextBlock Text="{l:T multiplayer.tab.servers}" /></RadioButton>
        <RadioButton x:Name="SettingsTabButton" GroupName="MpTab" IsChecked="{Binding IsSettingsTab, Mode=OneWay}" Command="{Binding ShowTabCommand}" CommandParameter="settings" ><TextBlock Text="{l:T multiplayer.tab.settings}" /></RadioButton>
      </StackPanel>
    </ScrollViewer>

        <!-- In a room: the sticky header (official §6.15) and, under it, the locked knock panel. Both stay put while the body scrolls. -->
    <StackPanel x:Name="RoomHeaderArea" svc:ThemeRegion.Name="multiplayer.room" Grid.Row="2" Spacing="8" Margin="0,0,0,10" IsVisible="{Binding ShowRoomHeader}">
      <Border x:Name="RoomHeader" Classes="card" Margin="0" Padding="12,8">
        <Grid x:Name="RoomHeaderGrid" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
          <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="RoomHeaderText" Text="{Binding RoomHeaderText}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <Button x:Name="CopyAddressButton" Classes="ghost small" Content="{Binding VirtualIpLabel}" Command="{Binding CopyVirtualIpCommand}" IsVisible="{Binding HasVirtualIp}"
                    HorizontalAlignment="Left" Padding="0,2" ToolTip.Tip="{l:T common.copy}" />
          </StackPanel>
          <StackPanel x:Name="RoomHeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Button x:Name="HeaderInviteButton" Classes="primary" Content="{l:T multiplayer.invite.button}" Command="{Binding InviteFriendsCommand}" IsVisible="{Binding IsHosting}" ToolTip.Tip="Ctrl+Shift+I" />
            <Button x:Name="InviteContactButton" Content="{l:T multiplayer.contacts.invite_button}" IsVisible="{Binding CanInviteContacts}" ToolTip.Tip="{l:T multiplayer.contacts.invite_hint}">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <StackPanel x:Name="InviteContactPanel" Spacing="6" MaxWidth="320">
                    <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.contacts.invite_hint}" />
                    <ItemsControl x:Name="InviteContactList" ItemsSource="{Binding ContactList}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ContactItem">
                          <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,1"
                                  Command="{Binding $parent[ItemsControl].((vm:MultiplayerViewModel)DataContext).InviteContactCommand}" CommandParameter="{Binding}">
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button x:Name="RoomMenuButton" Content="⋯" ToolTip.Tip="{l:T multiplayer.room.menu}" AutomationProperties.Name="{l:T multiplayer.room.menu}">
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem x:Name="RoomSettingsItem" Header="{l:T multiplayer.room.settings}" Command="{Binding ToggleRoomSettingsCommand}" IsVisible="{Binding IsHosting}" />
                  <MenuItem x:Name="RoomProblemsItem" Header="{l:T multiplayer.room.problems}" Command="{Binding OpenDiagnosticsCommand}" />
                  <MenuItem Header="{l:T multiplayer.chat.export}" Click="ExportChat_Click" />
                  <MenuItem x:Name="CopyRoomInfoItem" Header="{l:T multiplayer.room.copy_info}" Command="{Binding CopyRoomInfoCommand}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button x:Name="EndRoomButton" Content="{Binding EndRoomLabel}" Command="{Binding AskStopCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- A mailed invite got no receipt: it may have been held back; offer the other ways in. -->
      <Border x:Name="HeldBackBanner" Classes="banner warning" Margin="0" Padding="12,8" IsVisible="{Binding HasHeldBack}">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding HeldBackText}" TextWrapping="Wrap" />
          <WrapPanel ItemSpacing="6" LineSpacing="6">
            <Button x:Name="HeldBackOtherWayButton" Content="{l:T multiplayer.contacts.held_back.other_way}" Command="{Binding HeldBackOtherWayCommand}" />
            <Button Classes="ghost" Content="{l:T multiplayer.contacts.held_back.dismiss}" Command="{Binding DismissHeldBackCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- Someone knocks: a locked panel (theme packs cannot restyle it). "No" has the focus; Alt+Y / Alt+N / Esc. -->
      <ScrollViewer x:Name="KnockScroll" IsVisible="{Binding HasKnocks}" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="4">
      <!-- One knock at a time; the rest wait in line ("2 more knocking"). -->
      <ContentControl x:Name="KnockList" Content="{Binding FirstKnock}">
        <ContentControl.ContentTemplate>
          <DataTemplate DataType="vm:ApprovalCard">
            <safety:SafetyPanel Title="{Binding Headline}" Margin="0,0,0,6">
              <safety:SafetyPanel.Body>
                <StackPanel Spacing="6">
                  <TextBlock Text="{l:T multiplayer.knock.safety_code}" FontSize="12" />
                  <SelectableTextBlock Text="{Binding SafetyCode}" FontFamily="Consolas,Menlo,monospace" FontSize="16" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Facts}" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding Facts, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Text="{Binding VerifyHint}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Warning}" FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="{Binding HasWarning}" />
                  <CheckBox IsChecked="{Binding TrustAfter}" IsVisible="{Binding CanTrustAfter}">
                    <TextBlock Text="{Binding TrustLabel}" TextWrapping="Wrap" />
                  </CheckBox>
                  <TextBlock x:Name="KnockJayHint" Text="{Binding JayHint}" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding HasJayAccount}" />
                  <WrapPanel ItemSpacing="8" LineSpacing="6">
                    <safety:SafetyButton Classes="knock-deny" Kind="Safe" Content="{l:T multiplayer.invite.deny}"
                                         Command="{Binding $parent[ScrollViewer].((vm:MultiplayerViewModel)DataContext).DenyKnockCommand}" CommandParameter="{Binding}" />
                    <safety:SafetyButton Classes="knock-approve" Kind="Confirm" Content="{l:T multiplayer.invite.approve}"
                                         Command="{Binding $parent[ScrollViewer].((vm:MultiplayerViewModel)DataContext).ApproveKnockCommand}" CommandParameter="{Binding}" />
                  </WrapPanel>
                  <TextBlock Text="{Binding RemainingText}" FontSize="12" />
                  <TextBlock Text="{l:T multiplayer.knock.keys}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
              </safety:SafetyPanel.Body>
            </safety:SafetyPanel>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
      <TextBlock x:Name="MoreKnocksText" Text="{Binding MoreKnocksText}" IsVisible="{Binding HasMoreKnocks}" FontWeight="SemiBold" />
      </StackPanel>
      </ScrollViewer>

      <!-- Someone wants to send me a file: locked card in the same safety layer; programs get an extra warning. Never opened by Jay. -->
      <ItemsControl x:Name="FileOfferList" ItemsSource="{Binding FileOffers}" IsVisible="{Binding HasFileOffers}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:FileOfferItem">
            <safety:SafetyPanel Title="{Binding Headline}" Margin="0,0,0,6">
              <safety:SafetyPanel.Body>
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" FontWeight="SemiBold" IsVisible="{Binding IsProgram}" />
                  <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" IsVisible="{Binding !IsProgram}" />
                  <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding SafetyCode, StringFormat='▦ {0}'}" />
                  <WrapPanel ItemSpacing="8" LineSpacing="6">
                    <safety:SafetyButton Classes="file-decline" Kind="Safe" Content="{l:T multiplayer.private.decline}"
                                         Command="{Binding $parent[ItemsControl].((vm:MultiplayerViewModel)DataContext).DeclineFileCommand}" CommandParameter="{Binding}" />
                    <safety:SafetyButton Classes="file-accept" Kind="Confirm" Content="{l:T multiplayer.file.accept}"
                                         Command="{Binding $parent[ItemsControl].((vm:MultiplayerViewModel)DataContext).AcceptFileCommand}" CommandParameter="{Binding}" />
                  </WrapPanel>
                </StackPanel>
              </safety:SafetyPanel.Body>
            </safety:SafetyPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Joiner: check the mods against the host's (official §6.14). Never says "same" before the lists were compared. -->
      <Border x:Name="ModCheckCard" Classes="card" Margin="0,0,0,6" IsVisible="{Binding ShowModCheck}">
        <StackPanel Spacing="6">
          <TextBlock Classes="h2" Margin="0" Text="{l:T multiplayer.modcheck.heading}" />
          <TextBlock x:Name="ModCheckingText" Text="{l:T multiplayer.modcheck.checking}" IsVisible="{Binding ModCheckChecking}" TextWrapping="Wrap" />
          <TextBlock x:Name="ModCheckSameText" Text="{l:T multiplayer.modcheck.same}" IsVisible="{Binding ModCheckSame}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="ModCheckNoticeText" Text="{Binding ModCheckNotice}" IsVisible="{Binding HasModCheckNotice}" TextWrapping="Wrap" />
          <StackPanel x:Name="ModDifferencePanel" Spacing="4" IsVisible="{Binding ModCheckDifferent}">
            <TextBlock Text="{Binding ModCheckTitle}" TextWrapping="Wrap" />
            <TextBlock x:Name="ModMissingText" Text="{Binding ModMissingText}" IsVisible="{Binding HasModMissing}" TextWrapping="Wrap" />
            <TextBlock x:Name="ModDifferentText" Text="{Binding ModDifferentText}" IsVisible="{Binding HasModDifferent}" TextWrapping="Wrap" />
            <TextBlock x:Name="ModExtraText" Classes="hint" Text="{Binding ModExtraText}" IsVisible="{Binding HasModExtra}" TextWrapping="Wrap" />
            <TextBlock FontSize="12" Margin="0,4,0,0" Text="{l:T multiplayer.modcheck.sync_to}" />
            <WrapPanel ItemSpacing="16" LineSpacing="4" IsEnabled="{Binding ModCheckButtonsShown}">
              <RadioButton x:Name="SyncIntoNewRadio" GroupName="ModSyncTarget" IsChecked="{Binding SyncIntoNewInstance}">
                <TextBlock Text="{l:T multiplayer.modcheck.into_new}" TextWrapping="Wrap" />
              </RadioButton>
              <RadioButton x:Name="SyncIntoMineRadio" GroupName="ModSyncTarget" IsChecked="{Binding SyncIntoMine}">
                <TextBlock Text="{Binding SyncIntoMineText}" TextWrapping="Wrap" />
              </RadioButton>
            </WrapPanel>
            <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{Binding ModSyncSummary}" />
            <StackPanel x:Name="ModSyncProgress" Spacing="4" IsVisible="{Binding ModSyncing}">
              <ProgressBar IsIndeterminate="True" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="ModSyncText" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding ModSyncText}" />
                <Button Grid.Column="1" Classes="small" Content="{l:T common.cancel}" Command="{Binding CancelModSyncCommand}" Margin="8,0,0,0" />
              </Grid>
            </StackPanel>
            <WrapPanel x:Name="ModCheckButtons" ItemSpacing="8" LineSpacing="6" Margin="0,4,0,0" IsVisible="{Binding ModCheckButtonsShown}">
              <Button x:Name="SyncModsButton" Classes="primary" Command="{Binding SyncModsCommand}">
                <TextBlock Text="{l:T multiplayer.modcheck.sync}" TextWrapping="Wrap" />
              </Button>
              <Button x:Name="ModDetailsButton" Content="{l:T multiplayer.modcheck.details}" Command="{Binding ToggleModDetailsCommand}" />
              <Button x:Name="SkipModCheckButton" Classes="ghost" Content="{l:T multiplayer.modcheck.skip}" Command="{Binding SkipModCheckCommand}" />
            </WrapPanel>
            <ScrollViewer MaxHeight="240" IsVisible="{Binding ModDetailsOpen}">
            <ItemsControl x:Name="ModDiffList" ItemsSource="{Binding ModDiffLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ModDiffLine">
                  <Grid ColumnDefinitions="24,*" Margin="0,1">
                    <TextBlock Text="{Binding Mark}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <ScrollViewer x:Name="MpBody" Classes="page-scroll" svc:ThemeRegion.Name="multiplayer.body" Grid.Row="3">
      <StackPanel Spacing="14" Margin="0,0,14,14">

<!-- 加入方：房主发起的测试正在进行 -->
        <Border Classes="card" Margin="0" IsVisible="{Binding GuestTestRunning}" BorderBrush="{DynamicResource Warning}" BorderThickness="2">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding GuestTestBanner}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold" />
            <Button Grid.Column="1" Classes="amber" Content="{l:T multiplayer.matrix.stop_test}" Command="{Binding StopGuestTestCommand}" Margin="12,0,0,0" />
          </Grid>
        </Border>

        <!-- 正在经别人上网 -->
        <Border Classes="card" Margin="0" IsVisible="{Binding UsingExit}" BorderBrush="{DynamicResource Warning}" BorderThickness="2">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding ExitBanner}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold" />
            <Button Grid.Column="1" Classes="primary" Content="{l:T multiplayer.exit.stop}" Command="{Binding StopExitNodeCommand}" Margin="12,0,0,0" />
          </Grid>
        </Border>

        <!-- ===== Play: lobby when idle, the room when in one ===== -->
        <StackPanel x:Name="PlayPanel" Spacing="14" IsVisible="{Binding IsPlayTab}">
          <!-- The component: only when it is missing (it also lives in settings › component). -->
          <Panel IsVisible="{Binding !IsComponentReady}">
            <Border Classes="card" Margin="0">
              <StackPanel Spacing="8">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                  <TextBlock Text="{Binding ComponentText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <WrapPanel Grid.Row="1" ItemSpacing="6" LineSpacing="6" IsVisible="{Binding !IsComponentReady}">
                    <Button Classes="primary" Content="{l:T multiplayer.component.download}" Command="{Binding DownloadComponentCommand}" IsVisible="{Binding !IsDownloading}" />
                    <Button Content="{l:T multiplayer.component.import}" Click="ImportComponent_Click" IsVisible="{Binding !IsDownloading}" />
                  </WrapPanel>
                </Grid>
                <c:ProgressLine x:Name="ComponentLine" IsVisible="{Binding IsDownloading}" Step="{Binding Status}"
                                Percent="{Binding ComponentWork.Percent}" IsIndeterminate="{Binding ComponentWork.IsIndeterminate}"
                                BytesPerSecond="{Binding ComponentWork.BytesPerSecond}" Remaining="{Binding ComponentWork.Remaining}"
                                CancelCommand="{Binding CancelDownloadCommand}" />
                <SelectableTextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{Binding ManualHintText}" IsVisible="{Binding !IsComponentReady}" />
                <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{Binding LicenseText}" />
              </StackPanel>
            </Border>
          </Panel>

          <!-- Lobby (§6.14): open a room | join a friend. Wide: side by side; medium: stacked; compact: join first. -->
          <Grid x:Name="LobbyGrid" ColumnDefinitions="*,14,*" RowDefinitions="Auto,Auto,Auto" IsVisible="{Binding IsIdle}">
            <Border x:Name="HostCard" Classes="card" Margin="0">
              <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="{l:T multiplayer.lobby.host_title}" Margin="0" />
                <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.lobby.host_hint}" />
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <TextBlock Text="{l:T multiplayer.lobby.game}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <ComboBox Grid.Column="1" x:Name="LobbyGameBox" ItemsSource="{Binding LanGames}" SelectedItem="{Binding SelectedLanGame}" HorizontalAlignment="Stretch" PlaceholderText="{l:T multiplayer.lan.empty}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="vm:LanGameItem"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="2" Content="{l:T common.find}" Command="{Binding ScanCommand}" Margin="6,0,0,0" ToolTip.Tip="{l:T multiplayer.lan.scan_tooltip}" />
                </Grid>
                <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding GameStatusText}" Classes.hint="{Binding HasHostGame}" />
                <Grid x:Name="LastRoomRow" ColumnDefinitions="*,Auto" IsVisible="{Binding HasLastRoom}">
                  <TextBlock x:Name="LastRoomText" Classes="hint" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding LastRoomText}" />
                  <Button x:Name="RepeatLastRoomButton" Grid.Column="1" Classes="small" Margin="8,0,0,0" Command="{Binding RepeatLastRoomCommand}">
                    <TextBlock Text="{l:T multiplayer.lobby.repeat_room}" TextWrapping="Wrap" />
                  </Button>
                </Grid>
                <Button x:Name="LobbyHostButton" Classes.play="{Binding HostButtonIsAmber}" Command="{Binding HostFromLobbyCommand}"
                        IsVisible="{Binding ShowHostButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                  <TextBlock Text="{Binding HostButtonText}" TextWrapping="Wrap" TextAlignment="Center" />
                </Button>
                <TextBlock x:Name="PlayAndHostHint" Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{Binding PlayAndHostHint}"
                           IsVisible="{Binding StartsGameToHost}" />
                <!-- Started from the lobby: the three steps in the game; the room opens by itself when the log says Open to LAN. -->
                <Border x:Name="WaitingForLanPanel" Background="{DynamicResource AccentTint}" CornerRadius="6" Padding="10" IsVisible="{Binding IsWaitingForLan}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding WaitingForLanText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button x:Name="CancelWaitForLanButton" Grid.Column="1" Classes="small" Margin="8,0,0,0" VerticalAlignment="Center"
                            Content="{l:T common.cancel}" Command="{Binding CancelWaitForLanCommand}" />
                  </Grid>
                </Border>
                <CheckBox x:Name="AutoCopyInviteBox" IsChecked="{Binding AutoCopyInvite}">
                  <TextBlock Text="{l:T multiplayer.lobby.auto_copy}" TextWrapping="Wrap" />
                </CheckBox>
                <Expander x:Name="MoreWaysExpander" Header="{l:T multiplayer.lobby.more}" HorizontalAlignment="Stretch" IsExpanded="{Binding MoreWaysOpen}">
                  <StackPanel Spacing="10">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{l:T multiplayer.lobby.manual_port}" FontWeight="SemiBold" />
                      <TextBox Text="{Binding ManualPort}" PlaceholderText="{l:T multiplayer.lan.port_placeholder}" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                      <TextBlock Text="{l:T multiplayer.direct.heading}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap"
                                 Text="{l:T multiplayer.direct.hint}" />
                      <WrapPanel ItemSpacing="6" LineSpacing="4">
                        <Button Content="{l:T multiplayer.network.check}" Command="{Binding CheckNetworkCommand}" IsEnabled="{Binding !IsCheckingNetwork}" />
                        <CheckBox Content="{l:T multiplayer.direct.use_nodes}" IsChecked="{Binding DirectUseNodes}" />
                        <CheckBox Content="{l:T multiplayer.diagnostics.debug_mode}" IsChecked="{Binding DebugMode}" ToolTip.Tip="{l:T multiplayer.diagnostics.debug_tooltip}" />
                      </WrapPanel>
                      <SelectableTextBlock Text="{Binding NetworkCheckText}" TextWrapping="Wrap" FontSize="12" IsVisible="{Binding NetworkCheckText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <StackPanel Spacing="6">
                        <TextBlock Text="{l:T multiplayer.direct.host_title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding GameStatusText}" Classes.hint="{Binding HasHostGame}" />
                        <Button Classes="primary" Content="{l:T multiplayer.direct.create}" Command="{Binding CreateDirectRoomCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>

            <Border x:Name="JoinCard" Grid.Column="2" Classes="card" Margin="0">
              <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="{l:T multiplayer.lobby.join_title}" Margin="0" />
                <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.lobby.join_hint}" />
                <!-- One box for every code; pasted codes are masked until "show". -->
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox x:Name="JoinCodeBox" Text="{Binding JoinCode}" PlaceholderText="{l:T multiplayer.join.code_placeholder}" PasswordChar="•" RevealPassword="{Binding JoinCodeShown}"
                           c:EnterSubmit.Command="{Binding JoinCommand}" />
                  <Button Grid.Column="1" Command="{Binding ToggleJoinCodeShownCommand}" Margin="6,0,0,0" VerticalAlignment="Top">
                    <Panel>
                      <TextBlock Text="{l:T multiplayer.invite.show}" IsVisible="{Binding !JoinCodeShown}" />
                      <TextBlock Text="{l:T multiplayer.invite.hide}" IsVisible="{Binding JoinCodeShown}" />
                    </Panel>
                  </Button>
                </Grid>
                <TextBlock x:Name="JoinCodeRecognitionText" FontSize="12" TextWrapping="Wrap" Text="{Binding JoinCodeRecognition}" IsVisible="{Binding HasJoinCodeText}"
                           Classes.warn="{Binding JoinCodeRecognitionWarns}" />
                <!-- A sealed direct code: the passphrase the host told by another way (a call, in person). -->
                <TextBox x:Name="JoinPassphraseBox" Text="{Binding JoinPassphrase}" PlaceholderText="{l:T multiplayer.sealed.passphrase_placeholder}"
                         IsVisible="{Binding JoinCodeIsSealed}" c:EnterSubmit.Command="{Binding JoinCommand}" />
                <!-- Invite v3: the host's game, the instance Jay picked, or "install one and join". -->
                <StackPanel x:Name="JoinGamePanel" Spacing="4" IsVisible="{Binding HasJoinGame}">
                  <TextBlock x:Name="JoinGameText" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding JoinGameText}" />
                  <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding ShowJoinInstancePicker}">
                    <TextBlock FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Text="{l:T multiplayer.lobby.game.use}" />
                    <ComboBox x:Name="JoinInstanceBox" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Instances}" SelectedItem="{Binding TargetInstance}" />
                  </Grid>
                  <TextBlock x:Name="JoinMatchText" Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{Binding JoinMatchText}"
                             IsVisible="{Binding JoinMatchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock x:Name="JoinNoInstanceText" Classes="warn" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.lobby.game.none}" IsVisible="{Binding JoinNeedsInstall}" />
                  <Button x:Name="InstallForInviteButton" Command="{Binding InstallForInviteGameCommand}" IsVisible="{Binding JoinNeedsInstall}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                    <TextBlock Text="{Binding InstallForInviteText}" TextWrapping="Wrap" TextAlignment="Center" />
                  </Button>
                </StackPanel>
                <Button x:Name="LobbyJoinButton" Classes.primary="{Binding !JoinCodeRecognized}" Classes.play="{Binding JoinCodeRecognized}" Content="{l:T multiplayer.lobby.join_button}" Command="{Binding JoinCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                <Button Content="{l:T multiplayer.invite.cancel}" Command="{Binding CancelKnockCommand}" IsVisible="{Binding IsKnocking}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              </StackPanel>
            </Border>

            <!-- Footer: first time? · safety · component and relay servers -->
            <Grid x:Name="LobbyFooter" Grid.Row="2" Grid.ColumnSpan="3" ColumnDefinitions="*,*" Margin="0,4,0,0">
              <WrapPanel ItemSpacing="12" LineSpacing="4" VerticalAlignment="Center">
                <Button x:Name="LobbyLessonButton" Classes="ghost small" Command="{Binding OpenLessonCommand}" CommandParameter="multiplayer"><TextBlock Text="{l:T multiplayer.lobby.first_time}" TextWrapping="Wrap" /></Button>
                <Button x:Name="LobbySafetyButton" Classes="ghost small" Command="{Binding OpenLessonCommand}" CommandParameter="safety"><TextBlock Text="{l:T multiplayer.lobby.safety}" TextWrapping="Wrap" /></Button>
                <Button x:Name="LobbyDrillButton" Classes="ghost small" Command="{Binding OpenDrillCommand}"><TextBlock Text="{l:T multiplayer.lobby.drill}" TextWrapping="Wrap" /></Button>
                <Button x:Name="LobbyProblemsButton" Classes="ghost small" Command="{Binding OpenDiagnosticsCommand}"><TextBlock Text="{l:T multiplayer.room.problems}" TextWrapping="Wrap" /></Button>
              </WrapPanel>
              <Button Grid.Column="1" Classes="ghost small" HorizontalAlignment="Right" Command="{Binding ShowTabCommand}" CommandParameter="settings">
                <TextBlock Text="{Binding LobbyStatusText}" TextWrapping="Wrap" TextAlignment="Right" Classes.warn="{Binding LobbyStatusWarns}" />
              </Button>
            </Grid>
          </Grid>

          <!-- ===== In a room (official §6.15): people | chat | details.
               Wide: three columns; medium: people and chat side by side, details below; compact: one section at a time. ===== -->
          <StackPanel x:Name="RoomPanel" Spacing="10" IsVisible="{Binding !IsIdle}">
            <StackPanel x:Name="RoomSections" Orientation="Horizontal" Classes="segmented" Spacing="4" IsVisible="False">
              <RadioButton x:Name="PeopleSectionButton" GroupName="RoomSection" IsChecked="{Binding CompactPeople}"><TextBlock Text="{l:T multiplayer.room.section.people}" /></RadioButton>
              <RadioButton x:Name="ChatSectionButton" GroupName="RoomSection" IsChecked="{Binding CompactChat}"><TextBlock Text="{l:T multiplayer.room.section.chat}" /></RadioButton>
              <RadioButton x:Name="DetailsSectionButton" GroupName="RoomSection" IsChecked="{Binding CompactInvite}">
                <Panel>
                  <TextBlock Text="{l:T multiplayer.room.section.invite}" IsVisible="{Binding IsHosting}" />
                  <TextBlock Text="{l:T multiplayer.room.section.details}" IsVisible="{Binding !IsHosting}" />
                </Panel>
              </RadioButton>
            </StackPanel>

            <Grid x:Name="RoomGrid" ColumnDefinitions="250,14,*,14,300" RowDefinitions="Auto,Auto">
              <!-- People in the room: me first; pick someone for their safety code and actions. -->
              <Border x:Name="PeopleColumn" Classes="card" Margin="0" VerticalAlignment="Top">
                <StackPanel Spacing="6">
                  <TextBlock Classes="h2" Text="{l:T multiplayer.people.title}" Margin="0" />
                  <ListBox x:Name="PeopleList" ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}" Background="Transparent">
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="vm:PersonItem">
                        <Grid ColumnDefinitions="Auto,Auto,*">
                          <Border Classes="led online" Margin="0,0,8,0" IsVisible="{Binding IsOnline}" />
                          <Border Classes="led off" Margin="0,0,8,0" IsVisible="{Binding !IsOnline}" />
                          <Border Grid.Column="1" Classes="face" Background="{Binding Name, Converter={x:Static v:FaceBrush.Instance}}" Margin="0,0,8,0" />
                          <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Status}" Classes="caption" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.people.pick}" IsVisible="{Binding !HasSelectedPerson}" />
                  <StackPanel x:Name="PersonDetails" Spacing="6" IsVisible="{Binding HasSelectedPerson}">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <TextBlock Classes="caption" Text="{l:T multiplayer.knock.safety_code}" VerticalAlignment="Center" />
                      <c:TermHint x:Name="SafetyCodeTermHint" Term="safety_code" />
                    </StackPanel>
                    <SelectableTextBlock x:Name="PersonSafetyCode" Text="{Binding SelectedPerson.Fingerprint}" FontFamily="Consolas,Menlo,monospace" TextWrapping="Wrap" />
                    <TextBlock Classes="caption" Text="{l:T multiplayer.people.jay}" IsVisible="{Binding SelectedPerson.HasJayAccount}" />
                    <SelectableTextBlock x:Name="PersonJayAccount" Text="{Binding SelectedPerson.JayAccount}" FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                         TextWrapping="Wrap" IsVisible="{Binding SelectedPerson.HasJayAccount}" />
                    <WrapPanel ItemSpacing="6" LineSpacing="6">
                      <Button x:Name="PersonChatButton" Classes="small" Content="{l:T multiplayer.people.chat}" Command="{Binding ChatWithCommand}" CommandParameter="{Binding SelectedPerson}" IsVisible="{Binding SelectedPerson.CanPrivate}" />
                      <Button x:Name="PersonTrustButton" Classes="small" Content="{l:T multiplayer.invite.trust}" Command="{Binding TrustPersonCommand}" CommandParameter="{Binding SelectedPerson}" IsVisible="{Binding SelectedPerson.CanTrust}" />
                      <TextBlock Classes="hint" Text="{l:T multiplayer.invite.trusted_badge}" VerticalAlignment="Center" IsVisible="{Binding SelectedPerson.IsTrusted}" />
                      <Panel IsVisible="{Binding ShowRemoteControl}">
                        <Button Classes="small" Content="{l:T multiplayer.remote.button}" Command="{Binding RemoteControlPersonCommand}" CommandParameter="{Binding SelectedPerson}"
                                IsEnabled="{Binding CanRemoteControl}" IsVisible="{Binding SelectedPerson.CanRemove}" />
                      </Panel>
                      <Button x:Name="PersonRemoveButton" Classes="small" Content="{l:T multiplayer.kick.button}" Command="{Binding RemovePersonCommand}" CommandParameter="{Binding SelectedPerson}" IsVisible="{Binding SelectedPerson.CanRemove}" />
                    </WrapPanel>
                    <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.kick.hint}" IsVisible="{Binding SelectedPerson.CanRemove}" />
                  </StackPanel>
                  <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.remote.hint}" IsVisible="{Binding CanRemoteControl}" />
                  <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{Binding RemoteUnavailableText}" IsVisible="{Binding HasRemoteUnavailableText}" />
                </StackPanel>
              </Border>

              <!-- Chat: the room, or private (end-to-end; the host only passes it on). Files offered to me show under either. -->
              <Border x:Name="ChatColumn" Grid.Column="2" Classes="card" Margin="0" VerticalAlignment="Top">
                <StackPanel Spacing="6">
                  <Panel>
                    <TextBlock Classes="h2" Text="{l:T multiplayer.chat.title}" Margin="0" IsVisible="{Binding !HasOnlinePeers}" />
                    <StackPanel x:Name="ChatModes" Orientation="Horizontal" Classes="segmented" Spacing="4" IsVisible="{Binding HasOnlinePeers}" HorizontalAlignment="Left">
                      <RadioButton x:Name="RoomChatButton" GroupName="ChatMode" IsChecked="{Binding RoomChatMode}"><TextBlock Text="{l:T multiplayer.room.chat_room}" /></RadioButton>
                      <RadioButton x:Name="PrivateChatButton" GroupName="ChatMode" IsChecked="{Binding PrivateChatMode}"><TextBlock Text="{l:T multiplayer.room.chat_private}" /></RadioButton>
                    </StackPanel>
                  </Panel>
                  <StackPanel x:Name="RoomChat" Spacing="6" IsVisible="{Binding RoomChatMode}">
                    <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{Binding ChatStatus}" />
                    <Border Background="{DynamicResource PageBg}" CornerRadius="6" Padding="8" Height="260">
                      <ScrollViewer Name="ChatScroll">
                        <ItemsControl ItemsSource="{Binding ChatLines}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ChatLine">
                              <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                <TextBlock Text="{Binding Time}" Classes="caption" Margin="0,2,8,0" />
                                <StackPanel Grid.Column="1">
                                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" IsVisible="{Binding !IsNotice}" />
                                  <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" Classes.hint="{Binding IsNotice}" />
                                </StackPanel>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Border>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBox x:Name="ChatInputBox" Text="{Binding ChatInput}" PlaceholderText="{l:T multiplayer.chat.input_placeholder}" MaxLength="500" KeyDown="ChatInput_KeyDown" IsEnabled="{Binding ChatReady}" />
                      <Button Grid.Column="1" Classes="primary" Content="{l:T common.send}" Command="{Binding SendChatCommand}" IsEnabled="{Binding ChatReady}" Margin="6,0,0,0" />
                    </Grid>
                  </StackPanel>
                  <StackPanel x:Name="PrivateChat" Spacing="6" IsVisible="{Binding PrivateChatMode}">
                    <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.private.hint}" />
                    <ComboBox x:Name="PrivatePeerBox" ItemsSource="{Binding OnlinePeers}" SelectedItem="{Binding SelectedPeer}" HorizontalAlignment="Stretch" PlaceholderText="{l:T multiplayer.private.choose}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:OnlinePeerItem"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ItemsControl ItemsSource="{Binding PrivateLines}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:PrivateLine">
                          <SelectableTextBlock Text="{Binding Display}" TextWrapping="Wrap" FontSize="13" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding HasPrivatePeer}">
                      <TextBox Text="{Binding PrivateInput}" PlaceholderText="{l:T multiplayer.private.input_placeholder}" MaxLength="2000" />
                      <Button Grid.Column="1" Classes="primary" Content="{l:T common.send}" Command="{Binding SendPrivateCommand}" Margin="6,0,0,0" />
                      <Button Grid.Column="2" Content="{l:T multiplayer.private.send_file}" Command="{Binding SendFileCommand}" Margin="6,0,0,0" />
                    </Grid>
                  </StackPanel>
                  <TextBlock x:Name="FileOfferPointer" Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.file.see_above}" IsVisible="{Binding HasFileOffers}" />
                  <ItemsControl ItemsSource="{Binding Transfers}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:TransferItem">
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                          <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
                          <Button Grid.Column="1" Content="{l:T common.cancel}" Margin="8,0,0,0" IsVisible="{Binding IsActive}"
                                  Command="{Binding $parent[ItemsControl].((vm:MultiplayerViewModel)DataContext).CancelTransferCommand}" CommandParameter="{Binding}" />
                          <Button Grid.Column="2" Content="{l:T multiplayer.private.open_folder}" Margin="6,0,0,0" IsVisible="{Binding CanOpen}"
                                  Command="{Binding $parent[ItemsControl].((vm:MultiplayerViewModel)DataContext).OpenTransferFolderCommand}" CommandParameter="{Binding}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <!-- Details: room settings (host), the invite card (host), how to get in (guest), direct room, connection. -->
              <StackPanel x:Name="DetailsColumn" Grid.Column="4" Spacing="14">
                <!-- Room settings drawer (⋯ › Room settings) -->
                <Border x:Name="RoomSettingsCard" Classes="card" Margin="0" IsVisible="{Binding RoomSettingsOpen}">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="h2" Text="{l:T multiplayer.room.settings}" Margin="0" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="ghost small" Content="✕" Command="{Binding ToggleRoomSettingsCommand}" ToolTip.Tip="{l:T common.close}" />
                    </Grid>
                    <TextBlock Text="{l:T multiplayer.room.who_join}" FontWeight="SemiBold" />
                    <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.room.who_join_body}" />
                    <TextBlock Text="{l:T multiplayer.room.who_find}" FontWeight="SemiBold" />
                    <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.room.who_find_body}" />
                    <Button x:Name="PublishRoomButton" Classes="ghost small" Content="{l:T multiplayer.room.publish}" Command="{Binding ShowTabCommand}" CommandParameter="public"
                            IsVisible="{Binding ShowPublicNetworks}" HorizontalAlignment="Left" Padding="0,2" />
                    <TextBlock Text="{l:T multiplayer.room.wait}" FontWeight="SemiBold" />
                    <ComboBox x:Name="RoomKnockWaitBox" ItemsSource="{Binding KnockWaitChoices}" SelectedItem="{Binding SelectedRoomKnockWait}" MinWidth="160">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:KnockWaitChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{l:T multiplayer.room.mod_sync}" FontWeight="SemiBold" />
                    <CheckBox x:Name="AllowModSyncBox" IsChecked="{Binding AllowModSync}">
                      <TextBlock Text="{l:T multiplayer.room.mod_sync_allow}" TextWrapping="Wrap" />
                    </CheckBox>
                    <TextBlock Text="{l:T multiplayer.kick.banned_title}" FontWeight="SemiBold" />
                    <TextBlock Classes="hint" FontSize="12" Text="{l:T multiplayer.room.removed_none}" IsVisible="{Binding !BannedPeople.Count}" />
                    <ItemsControl x:Name="RemovedList" ItemsSource="{Binding BannedPeople}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:BannedItem">
                          <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                            <TextBlock Text="{Binding Label}" FontFamily="Consolas,monospace" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Classes="small" Content="{l:T multiplayer.kick.unban}" Command="{Binding $parent[ItemsControl].((vm:MultiplayerViewModel)DataContext).UnbanCommand}" CommandParameter="{Binding}" Margin="6,0,0,0" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <!-- Invite card: the code (masked), copy, copy a message, what this invite allows; "Change…" folds out the options. -->
                <Border x:Name="InviteCard" Classes="card" Margin="0" IsVisible="{Binding IsHosting}">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="h2" Text="{l:T multiplayer.invite.button}" Margin="0" />
                    <!-- Room opened before the game: what it is waiting for, a port box for other games, and [Find]. -->
                    <Border x:Name="GameLinkPanel" Background="{DynamicResource AccentTint}" CornerRadius="6" Padding="10" IsVisible="{Binding HasGameRelay}">
                      <StackPanel Spacing="6">
                        <TextBlock x:Name="GameLinkText" Text="{Binding GameLinkText}" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsWaitingForGame}">
                          <TextBox x:Name="GameLinkPortBox" Text="{Binding ManualPort}" PlaceholderText="{l:T multiplayer.lan.port_placeholder}" />
                          <Button x:Name="GameLinkFindButton" Grid.Column="1" Content="{l:T common.find}" Command="{Binding FindGameForRoomCommand}" Margin="6,0,0,0" ToolTip.Tip="{l:T multiplayer.lan.scan_tooltip}" />
                        </Grid>
                      </StackPanel>
                    </Border>
                    <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.invite.hint}" IsVisible="{Binding !HasInvite}" />
                    <Button x:Name="CreateFirstInviteButton" Classes="primary" Content="{l:T multiplayer.invite.create}" Command="{Binding CreateInviteCommand}" IsVisible="{Binding !HasInvite}" HorizontalAlignment="Left" />
                    <StackPanel Spacing="6" IsVisible="{Binding HasInvite}">
                      <Border Classes="code-card">
                        <Panel>
                          <Border Classes="wing-edge" />
                          <TextBox x:Name="InviteCodeBox" Classes="mono code" Text="{Binding InviteDisplay}" IsReadOnly="True" TextWrapping="Wrap" />
                        </Panel>
                      </Border>
                      <WrapPanel ItemSpacing="6" LineSpacing="6">
                        <Button x:Name="CopyInviteButton" Classes="primary" Content="{l:T multiplayer.invite.copy}" Command="{Binding CopyInviteCommand}" />
                        <Button x:Name="CopyInviteMessageButton" Content="{l:T multiplayer.invite.copy_message}" Command="{Binding CopyInviteMessageCommand}" />
                        <Button Command="{Binding ToggleInviteShownCommand}">
                          <Panel>
                            <TextBlock Text="{l:T multiplayer.invite.show}" IsVisible="{Binding !InviteShown}" />
                            <TextBlock Text="{l:T multiplayer.invite.hide}" IsVisible="{Binding InviteShown}" />
                          </Panel>
                        </Button>
                      </WrapPanel>
                      <TextBlock x:Name="InviteTermsText" FontSize="12" TextWrapping="Wrap" Text="{Binding InviteTerms}" />
                      <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.clipboard.autoclear_hint}" />
                    </StackPanel>
                    <Button x:Name="InviteChangeButton" Classes="ghost small" Content="{l:T multiplayer.invite.change}" Command="{Binding ToggleInviteOptionsCommand}" HorizontalAlignment="Left" Padding="0,2" />
                    <StackPanel x:Name="InviteOptions" Spacing="8" IsVisible="{Binding InviteOptionsOpen}">
                      <TextBlock Text="{l:T multiplayer.invite.dialog_title}" FontWeight="SemiBold" />
                      <WrapPanel ItemSpacing="8" LineSpacing="6">
                        <TextBlock Text="{l:T multiplayer.invite.uses}" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding InviteUses}" Minimum="1" Maximum="20" Increment="1" FormatString="0" MinWidth="110" />
                        <TextBlock Text="{l:T multiplayer.invite.expiry}" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding InviteExpiryChoices}" SelectedItem="{Binding SelectedInviteExpiry}" MinWidth="150">
                          <ComboBox.ItemTemplate>
                            <DataTemplate DataType="vm:InviteExpiryChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </WrapPanel>
                      <CheckBox Content="{l:T multiplayer.invite.auto_approve}" IsChecked="{Binding InviteAutoApprove}" IsVisible="{Binding ShowInviteAutoApprove}" />
                      <WrapPanel ItemSpacing="6" LineSpacing="6">
                        <Button Classes="primary" Content="{l:T multiplayer.invite.create}" Command="{Binding CreateInviteCommand}" />
                        <Button Content="{l:T multiplayer.invite.close}" Command="{Binding ToggleInviteOptionsCommand}" />
                      </WrapPanel>
                    </StackPanel>
                    <!-- Invites not used up yet: can be revoked -->
                    <StackPanel Spacing="4" IsVisible="{Binding !!PendingInvites.Count}">
                      <TextBlock Text="{l:T multiplayer.invite.pending_title}" FontWeight="SemiBold" />
                      <ItemsControl ItemsSource="{Binding PendingInvites}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:PendingInviteItem">
                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                              <TextBlock Text="{Binding Label}" FontFamily="Consolas,monospace" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                              <Button Grid.Column="1" Classes="small" Command="{Binding $parent[ItemsControl].((vm:MultiplayerViewModel)DataContext).TogglePendingInviteShownCommand}" CommandParameter="{Binding}" Margin="6,0,0,0">
                                <Panel>
                                  <TextBlock Text="{l:T multiplayer.invite.show}" IsVisible="{Binding !Shown}" />
                                  <TextBlock Text="{l:T multiplayer.invite.hide}" IsVisible="{Binding Shown}" />
                                </Panel>
                              </Button>
                              <Button Grid.Column="2" Classes="small" Content="{l:T multiplayer.invite.revoke}" Command="{Binding $parent[ItemsControl].((vm:MultiplayerViewModel)DataContext).RevokeInviteCommand}" CommandParameter="{Binding}" Margin="6,0,0,0" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- Guest: how to get into the game -->
                <Border x:Name="GuestCard" Classes="card" Margin="0" IsVisible="{Binding IsJoined}">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="h2" Text="{l:T multiplayer.join.active}" Margin="0" />
                    <TextBlock Text="{l:T multiplayer.join.address_label}" />
                    <TextBox Text="{Binding JoinAddress}" IsReadOnly="True" FontFamily="Consolas,monospace" FontSize="16" />
                    <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.join.address_hint}" />
                    <TextBlock Text="{Binding HostFingerprintText}" FontFamily="Consolas,monospace" IsVisible="{Binding HasHostFingerprint}" TextWrapping="Wrap" />
                    <ComboBox ItemsSource="{Binding Instances}" SelectedItem="{Binding TargetInstance}" HorizontalAlignment="Stretch" ToolTip.Tip="{l:T multiplayer.join.version_label}" />
                    <WrapPanel ItemSpacing="6" LineSpacing="6">
                      <Button Classes="primary" Content="{l:T multiplayer.join.launch}" Command="{Binding LaunchAndJoinCommand}" />
                      <Button Content="{l:T multiplayer.join.add_to_servers}" Command="{Binding AddToServersCommand}" />
                    </WrapPanel>
                    <!-- Remote control of the host (they say yes every time) -->
                    <StackPanel Spacing="4" IsVisible="{Binding ShowRemoteControl}">
                      <Button Content="{l:T multiplayer.remote.control_host}" Command="{Binding ControlHostCommand}" IsEnabled="{Binding CanRemoteControl}" HorizontalAlignment="Left" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- 直连房间：路径、全条件测试（邀请就是普通的 JAY2 邀请，地址只在加密的敲门里交换） -->
                <Border Classes="card" Margin="0" IsVisible="{Binding IsDirect}">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="h2" Text="{l:T multiplayer.direct.title}" Margin="0" />
                    <TextBlock Text="{Binding CurrentPathText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{Binding DirectHint}" />
                    <!-- No server at all: a sealed code and a passphrase told by another way. No IP is readable in the code. -->
                    <StackPanel x:Name="SealedHostPanel" Spacing="6" IsVisible="{Binding IsDirectHost}">
                      <TextBlock Text="{l:T multiplayer.sealed.title}" FontWeight="SemiBold" Margin="0,6,0,0" />
                      <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.sealed.hint}" />
                      <Button x:Name="CreateSealedButton" Content="{l:T multiplayer.sealed.create}" Command="{Binding CreateSealedOfferCommand}" IsEnabled="{Binding !IsSealing}" />
                      <StackPanel Spacing="6" IsVisible="{Binding HasSealedOffer}">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBox x:Name="SealedCodeBox" Text="{Binding SealedOfferCode}" IsReadOnly="True" TextWrapping="Wrap" FontSize="12" />
                          <Button Grid.Column="1" Content="{l:T multiplayer.sealed.copy_code}" Command="{Binding CopySealedCodeCommand}" Margin="6,0,0,0" VerticalAlignment="Top" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="{l:T multiplayer.sealed.passphrase_label}" />
                          <TextBlock x:Name="SealedPassphraseText" Grid.Column="1" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" FontFamily="monospace" Text="{Binding SealedPassphrase}" />
                          <Button Grid.Column="2" Content="{l:T multiplayer.sealed.copy_passphrase}" Command="{Binding CopySealedPassphraseCommand}" Margin="6,0,0,0" />
                        </Grid>
                        <TextBlock Classes="warn" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.sealed.separate_warning}" />
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBox x:Name="SealedReplyBox" Text="{Binding SealedReplyInput}" PlaceholderText="{l:T multiplayer.sealed.reply_placeholder}" c:EnterSubmit.Command="{Binding AddSealedReplyCommand}" />
                          <Button Grid.Column="1" Content="{l:T multiplayer.sealed.connect}" Command="{Binding AddSealedReplyCommand}" Margin="6,0,0,0" VerticalAlignment="Top" />
                        </Grid>
                      </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="SealedGuestPanel" Spacing="6" IsVisible="{Binding HasMySealedReply}">
                      <TextBlock Text="{l:T multiplayer.sealed.reply_title}" FontWeight="SemiBold" />
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBox x:Name="MySealedReplyBox" Text="{Binding MySealedReply}" IsReadOnly="True" TextWrapping="Wrap" FontSize="12" />
                        <Button Grid.Column="1" Content="{l:T multiplayer.sealed.copy_reply}" Command="{Binding CopyMySealedReplyCommand}" Margin="6,0,0,0" VerticalAlignment="Top" />
                      </Grid>
                    </StackPanel>
                    <StackPanel Spacing="6" IsVisible="{Binding IsDirectHost}">
                      <TextBlock Text="{l:T multiplayer.matrix.title}" FontWeight="SemiBold" Margin="0,6,0,0" />
                      <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.matrix.hint}" />
                      <CheckBox Content="{l:T multiplayer.matrix.include_full_lan}" IsChecked="{Binding MatrixFullLan}" IsEnabled="{Binding CanUseFullLan}" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Classes="primary" Content="{l:T multiplayer.matrix.start}" Command="{Binding RunMatrixCommand}" IsEnabled="{Binding !MatrixRunning}" />
                        <Button Content="{l:T common.stop}" Command="{Binding CancelMatrixCommand}" IsVisible="{Binding MatrixRunning}" />
                      </StackPanel>
                    </StackPanel>
                    <!-- 加入方：房主请求全条件测试，用户确认后才开始 -->
                    <Border Classes="card" Margin="0" IsVisible="{Binding TestRequestPending}">
                      <StackPanel Spacing="6">
                        <TextBlock Text="{l:T multiplayer.matrix.request_title}" FontWeight="SemiBold" />
                        <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.matrix.request_hint}" />
                        <CheckBox Content="{l:T multiplayer.matrix.allow_full_lan}" IsChecked="{Binding TestAllowFullLan}" IsVisible="{Binding TestRequestWantsFullLan}" IsEnabled="{Binding CanUseFullLan}" />
                        <CheckBox Content="{l:T multiplayer.matrix.allow_exit}" IsChecked="{Binding TestAllowExit}" IsVisible="{Binding TestRequestWantsFullLan}" IsEnabled="{Binding TestAllowFullLan}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Button Classes="amber" Content="{l:T multiplayer.matrix.accept}" Command="{Binding AcceptTestRequestCommand}" />
                          <Button Content="{l:T multiplayer.matrix.decline}" Command="{Binding DeclineTestRequestCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding MatrixLines}" IsVisible="{Binding !!MatrixLines.Count}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate><SelectableTextBlock Text="{Binding}" FontFamily="Consolas,monospace" FontSize="{DynamicResource FontCaption}" TextWrapping="Wrap" /></DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <!-- Connection: how each computer is reached; using someone's computer to get online. -->
                <Expander x:Name="ConnectionExpander" Header="{l:T multiplayer.peers.title}" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="hint" Text="{l:T multiplayer.peers.empty}" IsVisible="{Binding !Peers.Count}" />
                    <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{Binding TransportText}" />
                    <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource WarningText}" Text="{Binding ExitWarning}"
                               IsVisible="{Binding ExitWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Panel IsVisible="{Binding ShowNetworkExit}">
                      <WrapPanel ItemSpacing="6" LineSpacing="6" IsVisible="{Binding !UsingGameProxy}">
                        <TextBlock Text="{l:T multiplayer.proxy.peer_label}" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding ExitCandidates}" SelectedItem="{Binding SelectedExitPeer}" MinWidth="200">
                          <ComboBox.ItemTemplate>
                            <DataTemplate DataType="vm:PeerItem"><TextBlock Text="{Binding Meta}" /></DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="{l:T multiplayer.proxy.start}" Command="{Binding UseGameProxyCommand}" IsEnabled="{Binding CanUseGameProxy}"
                                ToolTip.Tip="{l:T multiplayer.proxy.start_tip}" />
                      </WrapPanel>
                    </Panel>
                    <Border IsVisible="{Binding UsingGameProxy}" BorderBrush="{DynamicResource Warning}" BorderThickness="1" CornerRadius="6" Padding="8">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding GameProxyBanner}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="{l:T multiplayer.proxy.stop}" Command="{Binding StopGameProxyCommand}" Margin="8,0,0,0" />
                      </Grid>
                    </Border>
                    <WrapPanel ItemSpacing="6" LineSpacing="6" IsVisible="{Binding CanUseExit}">
                      <TextBlock Text="{l:T multiplayer.exit.peer_label}" VerticalAlignment="Center" />
                      <ComboBox ItemsSource="{Binding ExitCandidates}" SelectedItem="{Binding SelectedExitPeer}" MinWidth="200">
                        <ComboBox.ItemTemplate>
                          <DataTemplate DataType="vm:PeerItem"><TextBlock Text="{Binding Meta}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <Button Content="{l:T common.start}" Command="{Binding UseExitNodeCommand}" IsEnabled="{Binding !UsingExit}" ToolTip.Tip="{l:T multiplayer.exit.start_tooltip}" />
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding Peers}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:PeerItem">
                          <StackPanel Margin="0,3">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Meta}" Classes="caption" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Grid>
          </StackPanel>
        </StackPanel>

        <!-- ===== Public rooms (§6.16) ===== -->
        <StackPanel x:Name="PublicPanel" Spacing="14" IsVisible="{Binding IsPublicTab}">
          <!-- No public network yet (the default): where public rooms come from. -->
          <Border x:Name="PublicSetupCard" Classes="card" Margin="0" IsVisible="{Binding ShowPublicSetup}">
            <StackPanel Spacing="8">
              <TextBlock Classes="h2" Text="{l:T multiplayer.public.title}" Margin="0" />
              <TextBlock TextWrapping="Wrap" Text="{l:T multiplayer.public.setup_body}" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{l:T multiplayer.public.setup_have_address}" />
                <Button x:Name="AddPublicNetworkButton" Grid.Column="1" Classes="primary" Margin="12,0,0,0" Content="{l:T multiplayer.public.setup_add}" Command="{Binding AddPublicNetworkCommand}" />
              </Grid>
              <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.public.setup_friend_code}" />
            </StackPanel>
          </Border>
          <Border x:Name="PublicCard" Classes="card" Margin="0" IsVisible="{Binding !ShowPublicSetup}">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Classes="h2" Text="{l:T multiplayer.public.title}" Margin="0" />
                  <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding PublicStateText}" Classes.hint="{Binding !IsPublicConnected}" />
                  <TextBlock Classes="caption" Text="{Binding PublicRefreshedText}" IsVisible="{Binding IsPublicConnected}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Top">
                  <Button Classes="primary" Content="{l:T multiplayer.public.connect}" Command="{Binding ConnectPublicCommand}" IsVisible="{Binding !IsPublicConnected}" IsEnabled="{Binding !IsPublicConnecting}" />
                  <Button Content="{l:T multiplayer.public.refresh}" Command="{Binding RefreshRoomsCommand}" IsVisible="{Binding IsPublicConnected}" IsEnabled="{Binding !IsRefreshingRooms}" />
                  <Button Content="{l:T multiplayer.public.disconnect}" Command="{Binding DisconnectPublicCommand}" IsVisible="{Binding IsPublicConnected}" />
                  <Button x:Name="CancelConnectButton" Content="{l:T common.cancel}" Command="{Binding DisconnectPublicCommand}" IsVisible="{Binding IsPublicConnecting}" />
                </StackPanel>
              </Grid>
              <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.public.hint}" />
              <!-- 网络配置里的公告和链接（网络维护者写的） -->
              <Border Classes="card" Margin="0" IsVisible="{Binding HasNetworkNotice}">
                <StackPanel Spacing="4">
                  <TextBlock Text="{l:T multiplayer.netconfig.notice_title}" FontWeight="SemiBold" />
                  <SelectableTextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding NetworkNotice}" />
                </StackPanel>
              </Border>
              <ItemsControl ItemsSource="{Binding NetworkLinks}" IsVisible="{Binding HasNetworkLinks}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel ItemSpacing="6" LineSpacing="6" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="pub:NetworkLink">
                    <Button Content="{Binding Name}" ToolTip.Tip="{Binding Url}"
                            Command="{Binding $parent[ItemsControl].((vm:MultiplayerViewModel)DataContext).OpenNetworkLinkCommand}" CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <!-- 网络主题想铺满整个 Jay：等用户点头 -->
              <Border Classes="card" Margin="0" IsVisible="{Binding NetworkThemeAskGlobal}">
                <StackPanel Spacing="6">
                  <TextBlock Text="{l:T multiplayer.netconfig.theme_title}" FontWeight="SemiBold" />
                  <TextBlock FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.netconfig.theme_global}" />
                  <WrapPanel ItemSpacing="6" LineSpacing="6">
                    <Button Classes="primary" Content="{l:T multiplayer.netconfig.theme_accept}" Command="{Binding AcceptNetworkThemeGlobalCommand}" />
                    <Button Content="{l:T multiplayer.netconfig.theme_decline}" Command="{Binding DeclineNetworkThemeGlobalCommand}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <!-- 网络账号（网络配置里有 login 段才显示）：账号密码加密发给网络节点，可能还要两步验证 -->
              <Border Classes="card" Margin="0" IsVisible="{Binding HasNetworkLogin}">
                <StackPanel Spacing="6">
                  <TextBlock Text="{l:T multiplayer.account.title}" FontWeight="SemiBold" />
                  <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.account.hint}" />
                  <TextBlock FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.account.required}" IsVisible="{Binding IsNetworkLoginRequired}" />
                  <StackPanel Spacing="6" IsVisible="{Binding ShowAccountLogin}">
                    <TextBox Text="{Binding AccountUser}" PlaceholderText="{l:T multiplayer.account.user}" MaxLength="32" />
                    <TextBox Text="{Binding AccountPassword}" PasswordChar="•" PlaceholderText="{l:T multiplayer.account.password}" />
                    <ItemsControl ItemsSource="{Binding AccountFactors}" IsVisible="{Binding HasAccountFactors}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:AccountFactorInput">
                          <TextBox Text="{Binding Value}" PlaceholderText="{Binding Prompt}" MaxLength="256" Margin="0,0,0,6" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Classes="primary" Content="{l:T multiplayer.account.login}" Command="{Binding LoginAccountCommand}" />
                  </StackPanel>
                  <WrapPanel ItemSpacing="6" LineSpacing="6" IsVisible="{Binding IsAccountLoggedIn}">
                    <TextBlock VerticalAlignment="Center" Text="{Binding AccountLoggedInAs}" FontWeight="SemiBold" />
                    <Button Content="{l:T multiplayer.account.logout}" Command="{Binding LogoutAccountCommand}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <!-- Before the first connect: what others on the network can and cannot see (locked). -->
              <safety:SafetyPanel x:Name="PublicNoticePanel" Title="{l:T multiplayer.public.notice_title}" IsVisible="{Binding PublicNoticeOpen}">
                <safety:SafetyPanel.Body>
                  <StackPanel Spacing="8">
                    <TextBlock TextWrapping="Wrap" Text="{l:T multiplayer.public.notice_body}" />
                    <WrapPanel ItemSpacing="8" LineSpacing="6">
                      <safety:SafetyButton Kind="Safe" Content="{l:T common.cancel}" Command="{Binding ClosePublicNoticeCommand}" />
                      <safety:SafetyButton Kind="Confirm" Content="{l:T multiplayer.public.notice_accept}" Command="{Binding AcceptPublicNoticeCommand}" />
                    </WrapPanel>
                  </StackPanel>
                </safety:SafetyPanel.Body>
              </safety:SafetyPanel>
              <!-- 房间列表（没在房间里时） -->
              <StackPanel Spacing="6" IsVisible="{Binding IsIdle}">
                <WrapPanel x:Name="RoomFilters" ItemSpacing="8" LineSpacing="6" IsVisible="{Binding IsPublicConnected}">
                  <TextBox x:Name="RoomSearchBox" Text="{Binding RoomSearch}" PlaceholderText="{l:T multiplayer.public.search}" MinWidth="220" ToolTip.Tip="/" />
                  <ComboBox x:Name="RoomGameBox" ItemsSource="{Binding RoomGameChoices}" SelectedItem="{Binding SelectedRoomGame}" MinWidth="140">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="vm:RoomGameChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <CheckBox x:Name="OpenRoomsBox" IsChecked="{Binding OpenRoomsOnly}"><TextBlock Text="{l:T multiplayer.public.open_only}" TextWrapping="Wrap" /></CheckBox>
                  <ComboBox x:Name="RoomSortBox" ItemsSource="{Binding RoomSortChoices}" SelectedItem="{Binding SelectedRoomSort}" MinWidth="140">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="vm:RoomSortChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </WrapPanel>
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowNoPublicRooms}">
                  <TextBlock Classes="hint" VerticalAlignment="Center" TextWrapping="Wrap" Text="{l:T multiplayer.public.empty}" />
                  <Button Grid.Column="1" Content="{l:T multiplayer.public.refresh}" Command="{Binding RefreshRoomsCommand}" Margin="8,0,0,0" />
                </Grid>
                <TextBlock x:Name="NoMatchingRoomsText" Classes="hint" TextWrapping="Wrap" Text="{l:T multiplayer.public.no_match}" IsVisible="{Binding ShowNoMatchingRooms}" />
                <ItemsControl x:Name="PublicRoomList" ItemsSource="{Binding VisibleRooms}" IsVisible="{Binding IsPublicConnected}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:PublicRoomItem">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Spacing="1">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="hint" FontSize="12" Text="{Binding Meta}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{l:T multiplayer.public.join}" Margin="8,0,0,0" VerticalAlignment="Center"
                                Command="{Binding $parent[ItemsControl].((vm:MultiplayerViewModel)DataContext).JoinPublicRoomCommand}" CommandParameter="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Text="{Binding PublicRoomPassword}" PasswordChar="•" PlaceholderText="{l:T multiplayer.public.password_placeholder}" IsVisible="{Binding IsPublicConnected}" />
                <!-- 用指纹码找房间 -->
                <StackPanel Spacing="6" IsVisible="{Binding IsPublicConnected}">
                  <WrapPanel ItemSpacing="2">
                    <TextBlock Text="{l:T multiplayer.device.find_title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <c:TermHint x:Name="DeviceCodeTermHint" Term="device_code" />
                  </WrapPanel>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding FindCodeInput}" PlaceholderText="{l:T multiplayer.device.find_placeholder}" FontFamily="Consolas,monospace" />
                    <Button Grid.Column="1" Content="{l:T multiplayer.device.find}" Command="{Binding FindByFingerprintCommand}" IsEnabled="{Binding !IsFindingRoom}" Margin="6,0,0,0" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasFoundRoom}">
                    <StackPanel Spacing="1">
                      <TextBlock Text="{Binding FoundRoom.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="hint" FontSize="12" Text="{Binding FoundRoom.Meta}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{l:T multiplayer.public.join}" Margin="8,0,0,0" VerticalAlignment="Center" Command="{Binding JoinFoundRoomCommand}" />
                  </Grid>
                </StackPanel>
              </StackPanel>
              <!-- 房主：在公共网络上怎么出现 -->
              <StackPanel Spacing="6" IsVisible="{Binding IsHosting}">
                <TextBlock Text="{l:T multiplayer.public.publish_title}" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding VisibilityChoices}" SelectedItem="{Binding SelectedVisibility}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate DataType="vm:VisibilityChoice">
                      <StackPanel Spacing="1">
                        <TextBlock Text="{Binding Label}" />
                        <TextBlock Classes="hint" FontSize="12" Text="{Binding Detail}" TextWrapping="Wrap" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox Text="{Binding PublishRoomName}" PlaceholderText="{l:T multiplayer.public.name_placeholder}" />
                <TextBox Text="{Binding PublishPassword}" PasswordChar="•" PlaceholderText="{l:T multiplayer.public.publish_password_placeholder}" IsVisible="{Binding NeedsPublishPassword}" />
                <CheckBox Content="{l:T multiplayer.public.auto_approve}" IsChecked="{Binding PublishAutoApprove}" />
                <CheckBox Content="{l:T multiplayer.device.allow_search}" IsChecked="{Binding AllowFingerprintSearch}" />
                <CheckBox Content="{l:T multiplayer.device.require}" IsChecked="{Binding RequireDevice}" />
                <TextBox Text="{Binding AllowedDevicesText}" AcceptsReturn="True" MinHeight="40" FontFamily="Consolas,monospace" TextWrapping="Wrap"
                         PlaceholderText="{l:T multiplayer.device.allowed_placeholder}" />
                <WrapPanel ItemSpacing="6" LineSpacing="6">
                  <Button Classes="primary" Content="{l:T multiplayer.public.publish}" Command="{Binding PublishRoomCommand}" />
                  <Button Content="{l:T multiplayer.public.unpublish}" Command="{Binding UnpublishRoomCommand}" />
                </WrapPanel>
                <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{Binding PublishStatus}" IsVisible="{Binding PublishStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ===== Servers (§6.17): Jay servers | the server I run ===== -->
        <StackPanel x:Name="ServersPanel" Spacing="14" IsVisible="{Binding IsServersTab}">
          <UniformGrid Columns="2" Classes="segmented" HorizontalAlignment="Left" MinWidth="280">
            <RadioButton x:Name="JayServersSegment" GroupName="MpServers" IsChecked="{Binding ShowJayServerList}" ><TextBlock Text="{l:T multiplayer.servers.jay}" TextTrimming="CharacterEllipsis" /></RadioButton>
            <RadioButton x:Name="MyServerSegment" GroupName="MpServers" IsChecked="{Binding ShowMyServer}" ><TextBlock Text="{l:T multiplayer.servers.mine}" TextTrimming="CharacterEllipsis" /></RadioButton>
          </UniformGrid>
          <Panel IsVisible="{Binding ShowJayServerList}">
            <!-- Jay 服务器：经网关进的专用服务器（VPS 或局域网里跑 Jay 服务器版的电脑） -->
            <Border Classes="card" Margin="0" DataContext="{Binding JayServers}" x:DataType="vm:JayServersViewModel">
              <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="{l:T multiplayer.jayserver.title}" Margin="0" />
                <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.jayserver.hint}" />
                <SelectableTextBlock FontSize="12" Text="{Binding DeviceCode}" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Text="{Binding InviteText}" PlaceholderText="{l:T multiplayer.jayserver.invite_placeholder}" />
                  <Button Grid.Column="1" Classes="primary" Margin="6,0,0,0" Content="{l:T multiplayer.jayserver.join}" Command="{Binding JoinCommand}" IsEnabled="{Binding !IsBusy}" />
                </Grid>
                <TextBox x:Name="JayServerPassphraseBox" Text="{Binding InvitePassphrase}" IsVisible="{Binding InviteIsSealed}"
                         PlaceholderText="{l:T multiplayer.jayserver.passphrase_placeholder}" />
                <TextBlock x:Name="NoJayServersText" Classes="hint" TextWrapping="Wrap" Text="{l:T multiplayer.jayserver.empty}" IsVisible="{Binding !Servers.Count}" />
                <ItemsControl ItemsSource="{Binding Servers}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:JayServerItem">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="hint" FontSize="12" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0">
                          <Button Classes="play" Content="{l:T multiplayer.jayserver.play}" IsVisible="{Binding !IsConnected}"
                                  Command="{Binding $parent[ItemsControl].((vm:JayServersViewModel)DataContext).PlayCommand}" CommandParameter="{Binding}" />
                          <Button Content="{l:T multiplayer.jayserver.disconnect}" IsVisible="{Binding IsConnected}"
                                  Command="{Binding $parent[ItemsControl].((vm:JayServersViewModel)DataContext).DisconnectCommand}" />
                          <Button Content="{l:T common.delete}"
                                  Command="{Binding $parent[ItemsControl].((vm:JayServersViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{Binding Status}" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Border>
          </Panel>
          <Panel IsVisible="{Binding ShowMyServer}">
            <!-- 开服：在这台电脑上跑 Jay 服务器版（网关 + 原版 MC 服务端），朋友用邀请码经“Jay 服务器”进来 -->
            <Border Classes="card" Margin="0" DataContext="{Binding HostServer}" x:DataType="vm:HostServerViewModel">
              <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="{l:T multiplayer.hostserver.title}" Margin="0" />
                <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.hostserver.hint}" />
                <!-- Step bar: ① address ── ② prepare ── ③ start ── ④ invite (done ✓, current ●) -->
                <ItemsControl x:Name="ServerWizardSteps" ItemsSource="{Binding WizardSteps}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel ItemSpacing="14" LineSpacing="4" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:WizardStepItem">
                      <TextBlock Text="{Binding Label}" Classes.hint="{Binding !IsCurrent}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="ServerRunningText" Text="{l:T multiplayer.hostserver.running}" Foreground="{DynamicResource SuccessText}" FontWeight="SemiBold" IsVisible="{Binding IsRunning}" />

                <!-- 第一步：玩家连的地址 -->
                <StackPanel Spacing="6" IsVisible="{Binding NeedsInit}">
                  <TextBlock FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.hostserver.step_address}" />
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBox Text="{Binding PublicHost}" PlaceholderText="{l:T multiplayer.hostserver.host_placeholder}" />
                    <TextBox Grid.Column="1" Width="90" Margin="6,0,0,0" Text="{Binding PublicPort}" PlaceholderText="47670" />
                    <Button Grid.Column="2" Classes="primary" Margin="6,0,0,0" Content="{l:T multiplayer.hostserver.init}" Command="{Binding InitCommand}" />
                  </Grid>
                </StackPanel>

                <!-- 第二步：准备 MC 服务端 -->
                <StackPanel Spacing="6" IsVisible="{Binding NeedsSetup}">
                  <TextBlock FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.hostserver.step_setup}" />
                  <WrapPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,6">
                      <TextBlock VerticalAlignment="Center" Text="{l:T multiplayer.hostserver.version}" />
                      <TextBox Width="110" Text="{Binding McVersion}" PlaceholderText="latest" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,6">
                      <TextBlock VerticalAlignment="Center" Text="{l:T multiplayer.hostserver.memory}" />
                      <TextBox Width="80" Text="{Binding MemoryMb}" />
                    </StackPanel>
                  </WrapPanel>
                  <CheckBox IsChecked="{Binding AcceptEula}">
                    <TextBlock TextWrapping="Wrap" Text="{l:T multiplayer.hostserver.eula}" />
                  </CheckBox>
                  <Button Classes="primary" Content="{l:T multiplayer.hostserver.setup}" Command="{Binding SetupCommand}" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Left" />
                </StackPanel>

                <!-- 运行和管理 -->
                <StackPanel Spacing="8" IsVisible="{Binding IsSetUp}">
                  <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding Summary}" />
                  <WrapPanel Orientation="Horizontal">
                    <Button Classes="primary" Margin="0,0,6,6" Content="{l:T multiplayer.hostserver.start}" Command="{Binding StartCommand}" IsVisible="{Binding CanStart}" />
                    <Button Margin="0,0,6,6" Content="{l:T multiplayer.hostserver.stop}" Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}" IsEnabled="{Binding !IsBusy}" />
                  </WrapPanel>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding InviteName}" PlaceholderText="{l:T multiplayer.hostserver.invite_placeholder}" />
                    <Button Grid.Column="1" Margin="6,0,0,0" Content="{l:T multiplayer.hostserver.invite}" Command="{Binding CreateInviteCommand}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding InviteCode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBox IsReadOnly="True" FontSize="12" TextWrapping="Wrap" Text="{Binding InviteCode}" />
                    <Button Grid.Column="1" Margin="6,0,0,0" Content="{l:T multiplayer.hostserver.copy}" Command="{Binding CopyInviteCommand}" />
                  </Grid>
                  <StackPanel x:Name="HostInvitePassphrasePanel" Spacing="4" IsVisible="{Binding HasInvitePassphrase}">
                    <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.hostserver.invite_sealed}" />
                    <Grid ColumnDefinitions="*,Auto">
                      <SelectableTextBlock FontFamily="Consolas,monospace" FontSize="16" VerticalAlignment="Center" Text="{Binding InvitePassphrase}" />
                      <Button Grid.Column="1" Margin="6,0,0,0" Content="{l:T multiplayer.sealed.copy_passphrase}" Command="{Binding CopyInvitePassphraseCommand}" />
                    </Grid>
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Members}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:HostMemberItem">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="hint" FontSize="12" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0">
                            <Button Content="{l:T multiplayer.hostserver.revoke}" IsVisible="{Binding HasDevices}"
                                    Command="{Binding $parent[ItemsControl].((vm:HostServerViewModel)DataContext).RevokeCommand}" CommandParameter="{Binding}" />
                            <Button Content="{l:T common.delete}"
                                    Command="{Binding $parent[ItemsControl].((vm:HostServerViewModel)DataContext).RemoveMemberCommand}" CommandParameter="{Binding}" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Expander HorizontalAlignment="Stretch" Header="{l:T multiplayer.hostserver.console}" IsVisible="{Binding LogText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel Spacing="6">
                      <TextBox x:Name="HostServerLog" IsReadOnly="True" FontFamily="Consolas,Menlo,monospace" FontSize="11" TextWrapping="Wrap" MaxHeight="220" Text="{Binding LogText}" />
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBox x:Name="ServerCommandBox" Text="{Binding McCommand}" PlaceholderText="{l:T multiplayer.hostserver.command_placeholder}" KeyDown="ServerCommand_KeyDown" />
                        <Button Grid.Column="1" Margin="6,0,0,0" Content="{l:T multiplayer.hostserver.send}" Command="{Binding SendCommandCommand}" />
                      </Grid>
                    </StackPanel>
                  </Expander>
                </StackPanel>

                <SelectableTextBlock Classes="hint" FontSize="11" TextWrapping="Wrap" Text="{Binding DataDirectoryText}" IsVisible="{Binding IsInitialized}" />
                <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{Binding Status}" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Border>
          </Panel>
        </StackPanel>

        <!-- ===== Multiplayer settings (§6.18) ===== -->
        <StackPanel x:Name="MpSettingsPanel" Spacing="14" IsVisible="{Binding IsSettingsTab}">
          <!-- 手机通过当前网络出口上网。共享状态由提权守护确认。 -->
          <c:HotspotSharingPanel DataContext="{Binding Hotspot}" />

          <!-- Safety code and friends -->
          <Border x:Name="IdentityCard" Classes="card" Margin="0">
            <StackPanel Spacing="8">
              <TextBlock Classes="h2" Text="{l:T multiplayer.settings.identity}" Margin="0" />
              <SelectableTextBlock Text="{Binding MyFingerprint}" TextWrapping="Wrap" FontWeight="SemiBold" />
              <TextBlock Text="{l:T multiplayer.identity.title}" FontWeight="SemiBold" />
              <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.identity.reset_hint}" />
              <Button Content="{l:T multiplayer.identity.reset}" Command="{Binding ResetIdentityCommand}" IsEnabled="{Binding IsIdle}" HorizontalAlignment="Left" />
              <TextBlock Text="{l:T multiplayer.trusted.title}" FontWeight="SemiBold" Margin="0,6,0,0" />
              <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.trusted.hint}" />
              <TextBlock Classes="hint" Text="{l:T multiplayer.trusted.empty}" IsVisible="{Binding !TrustedPeople.Count}" />
              <ItemsControl ItemsSource="{Binding TrustedPeople}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:TrustedItem">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                      <TextBlock Text="{Binding Label}" FontFamily="Consolas,monospace" VerticalAlignment="Center" TextWrapping="Wrap" />
                      <Button Grid.Column="1" Content="{l:T multiplayer.trusted.remove}" Command="{Binding $parent[ItemsControl].((vm:MultiplayerViewModel)DataContext).RemoveTrustedCommand}" CommandParameter="{Binding}" Margin="6,0,0,0" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Contacts (zero-leak codes): add once, compare four emoji, then invite them with sealed mail. -->
          <Border x:Name="ContactsCard" Classes="card" Margin="0" IsVisible="{Binding ShowPublicNetworks}">
            <StackPanel Spacing="8">
              <TextBlock Classes="h2" Text="{l:T multiplayer.contacts.title}" Margin="0" />
              <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.contacts.hint}" />
              <TextBlock Text="{l:T multiplayer.contacts.my_code}" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,Auto">
                <SelectableTextBlock x:Name="MyContactCodeText" Text="{Binding MyContactCode}" FontFamily="Consolas,Menlo,monospace" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button x:Name="CopyContactCodeButton" Grid.Column="1" Classes="small" Margin="8,0,0,0" Content="{l:T common.copy}" Command="{Binding CopyContactCodeCommand}" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.contacts.my_code_hint}" />
              <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                <TextBox x:Name="ContactCodeBox" Text="{Binding ContactCodeInput}" PlaceholderText="{l:T multiplayer.contacts.add_placeholder}"
                         c:EnterSubmit.Command="{Binding AddContactCommand}" />
                <Button x:Name="AddContactButton" Grid.Column="1" Margin="6,0,0,0" Content="{l:T multiplayer.contacts.add}" Command="{Binding AddContactCommand}" />
              </Grid>
              <TextBlock x:Name="ContactsPublicHint" Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.contacts.public_hint}" IsVisible="{Binding !IsPublicConnected}" />

              <TextBlock Text="{l:T multiplayer.contacts.requests}" FontWeight="SemiBold" Margin="0,6,0,0" IsVisible="{Binding HasContactRequests}" />
              <ItemsControl x:Name="ContactRequestList" ItemsSource="{Binding ContactRequests}" IsVisible="{Binding HasContactRequests}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:ContactRequestItem">
                    <Border Classes="callout" Padding="10,8" Margin="0,3">
                      <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <!-- The emoji check: big, each with its name under it (and read out for screen readers). -->
                        <StackPanel Spacing="6" IsVisible="{Binding IsComparing}">
                          <ItemsControl x:Name="ContactEmoji" ItemsSource="{Binding Emoji}" AutomationProperties.Name="{Binding EmojiSpoken}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate><WrapPanel ItemSpacing="14" LineSpacing="6" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="vm:EmojiItem">
                                <StackPanel Spacing="2" MinWidth="56" AutomationProperties.Name="{Binding Name}">
                                  <TextBlock Text="{Binding Emoji}" FontSize="34" HorizontalAlignment="Center" />
                                  <TextBlock Text="{Binding Name}" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="80" TextAlignment="Center" />
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.contacts.compare.hint}" />
                          <WrapPanel ItemSpacing="6" LineSpacing="6">
                            <Button x:Name="ConfirmContactButton" Content="{l:T multiplayer.contacts.compare.match}" Command="{Binding $parent[ItemsControl].((vm:MultiplayerViewModel)DataContext).ConfirmContactCommand}" CommandParameter="{Binding}" />
                            <Button x:Name="RejectContactButton" Content="{l:T multiplayer.contacts.compare.no_match}" Command="{Binding $parent[ItemsControl].((vm:MultiplayerViewModel)DataContext).RejectContactCommand}" CommandParameter="{Binding}" />
                          </WrapPanel>
                        </StackPanel>
                        <WrapPanel ItemSpacing="6" LineSpacing="6" IsVisible="{Binding IsAskingMe}">
                          <Button Content="{l:T multiplayer.contacts.accept}" Command="{Binding $parent[ItemsControl].((vm:MultiplayerViewModel)DataContext).AcceptContactCommand}" CommandParameter="{Binding}" />
                          <Button Content="{l:T multiplayer.contacts.ignore}" Command="{Binding $parent[ItemsControl].((vm:MultiplayerViewModel)DataContext).DismissContactCommand}" CommandParameter="{Binding}" />
                        </WrapPanel>
                        <Button Classes="small" HorizontalAlignment="Left" Content="{l:T multiplayer.contacts.cancel}" IsVisible="{Binding CanCancel}"
                                Command="{Binding $parent[ItemsControl].((vm:MultiplayerViewModel)DataContext).DismissContactCommand}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="{l:T multiplayer.contacts.list}" FontWeight="SemiBold" Margin="0,6,0,0" />
              <TextBlock x:Name="ContactsEmpty" Classes="hint" Text="{l:T multiplayer.contacts.empty}" IsVisible="{Binding !HasContacts}" />
              <ItemsControl x:Name="ContactListView" ItemsSource="{Binding ContactList}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:ContactItem">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                      <Border Classes="face large" Background="{Binding Name, Converter={x:Static v:FaceBrush.Instance}}" />
                      <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ContactJay" Text="{Binding JayText}" Classes="hint" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding HasJay}" />
                        <TextBlock Text="{Binding Fingerprint}" Classes="hint" FontSize="12" FontFamily="Consolas,Menlo,monospace" TextWrapping="Wrap" IsVisible="{Binding HasOneDevice}" />
                        <!-- Person + devices: each device's safety code, and a lost one can be removed alone. -->
                        <StackPanel x:Name="ContactDevices" Spacing="2" IsVisible="{Binding HasSeveralDevices}">
                          <TextBlock Text="{Binding DevicesText}" Classes="hint" FontSize="12" />
                          <ItemsControl ItemsSource="{Binding DeviceItems}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="vm:ContactDeviceItem">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                  <TextBlock Text="{Binding Fingerprint}" Classes="hint" FontSize="12" FontFamily="Consolas,Menlo,monospace" TextWrapping="Wrap" VerticalAlignment="Center" />
                                  <Button Grid.Column="1" Classes="small" Margin="6,0,0,0" Content="{l:T multiplayer.contacts.remove_device}"
                                          Command="{Binding $parent[ItemsControl;1].((vm:MultiplayerViewModel)DataContext).RemoveContactDeviceCommand}" CommandParameter="{Binding}" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </StackPanel>
                      <Button Grid.Column="2" Classes="small" Content="{l:T multiplayer.contacts.remove}" VerticalAlignment="Center"
                              Command="{Binding $parent[ItemsControl].((vm:MultiplayerViewModel)DataContext).RemoveContactCommand}" CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <!-- Friend list backup, locked with the Jay account: restore it on a new computer and friends reconnect. -->
              <WrapPanel ItemSpacing="6" LineSpacing="6" Margin="0,6,0,0">
                <Button x:Name="BackupFriendsButton" Classes="small" Content="{l:T multiplayer.friends.backup}" Command="{Binding BackupFriendsCommand}" />
                <Button x:Name="RestoreFriendsButton" Classes="small" Content="{l:T multiplayer.friends.restore}" Command="{Binding RestoreFriendsCommand}" />
              </WrapPanel>
              <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.friends.backup_hint}" />
            </StackPanel>
          </Border>

          <!-- Invites and alerts -->
          <Border Classes="card" Margin="0">
            <StackPanel Spacing="8">
              <TextBlock Classes="h2" Text="{l:T multiplayer.settings.invites}" Margin="0" />
              <CheckBox IsChecked="{Binding AutoCopyInvite}">
                <TextBlock Text="{l:T multiplayer.lobby.auto_copy}" TextWrapping="Wrap" />
              </CheckBox>
              <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.clipboard.autoclear_hint}" />
              <TextBlock Text="{l:T multiplayer.settings.knock_wait}" TextWrapping="Wrap" />
              <ComboBox x:Name="DefaultKnockWaitBox" ItemsSource="{Binding KnockWaitChoices}" SelectedItem="{Binding SelectedDefaultKnockWait}" MinWidth="160">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="vm:KnockWaitChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <CheckBox x:Name="RequestPopupBox" IsChecked="{Binding RequestPopup}">
                <TextBlock Text="{l:T multiplayer.settings.request_popup}" TextWrapping="Wrap" />
              </CheckBox>
              <!-- Long-lived invites for regular friends: 30 days, revoke any time, still asks me and shows the safety code. -->
              <TextBlock Text="{l:T multiplayer.longinvite.title}" FontWeight="SemiBold" Margin="0,6,0,0" />
              <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.longinvite.hint}" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="LongInviteLabelBox" Text="{Binding LongInviteLabel}" PlaceholderText="{l:T multiplayer.longinvite.label_placeholder}" MaxLength="40"
                         c:EnterSubmit.Command="{Binding CreateLongInviteCommand}" />
                <Button x:Name="CreateLongInviteButton" Grid.Column="1" Margin="6,0,0,0" Command="{Binding CreateLongInviteCommand}">
                  <TextBlock Text="{l:T multiplayer.longinvite.create}" TextWrapping="Wrap" />
                </Button>
              </Grid>
              <ItemsControl x:Name="LongInviteList" ItemsSource="{Binding LongInviteItems}" IsVisible="{Binding HasLongInvites}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:LongInviteItem">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                      <StackPanel Spacing="2">
                        <TextBlock TextWrapping="Wrap"><Run Text="{Binding Label}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding Left}" /></TextBlock>
                        <SelectableTextBlock Text="{Binding CodeDisplay}" FontFamily="Consolas,Menlo,monospace" FontSize="12" TextWrapping="Wrap" />
                      </StackPanel>
                      <WrapPanel Grid.Column="1" ItemSpacing="6" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button Classes="small" Content="{l:T multiplayer.invite.show}" Command="{Binding $parent[ItemsControl].((vm:MultiplayerViewModel)DataContext).ToggleLongInviteShownCommand}" CommandParameter="{Binding}" />
                        <Button Classes="small" Content="{l:T common.copy}" Command="{Binding $parent[ItemsControl].((vm:MultiplayerViewModel)DataContext).CopyLongInviteCommand}" CommandParameter="{Binding}" />
                        <Button Classes="small long-revoke" Content="{l:T multiplayer.longinvite.revoke}" Command="{Binding $parent[ItemsControl].((vm:MultiplayerViewModel)DataContext).RevokeLongInviteCommand}" CommandParameter="{Binding}" />
                      </WrapPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Relay servers -->
          <Border x:Name="RelayGroup" Classes="card" Margin="0">
            <StackPanel Spacing="8">
              <WrapPanel ItemSpacing="2">
                <TextBlock x:Name="RelayHeader" Classes="h2" Text="{Binding NodesHeaderText}" Margin="0" TextWrapping="Wrap" VerticalAlignment="Center" />
                <c:TermHint x:Name="RelayTermHint" Term="relay" />
              </WrapPanel>
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="{l:T multiplayer.nodes.hint}" />
                <Button Grid.Column="1" Content="{l:T multiplayer.nodes.test_latency}" Command="{Binding TestNodesCommand}" Margin="12,0,0,0" VerticalAlignment="Top" />
              </Grid>
              <!-- 内置节点：默认开，和自己的节点一起用（双方都开着就能在同一个节点上碰面）。 -->
              <StackPanel Spacing="2" IsVisible="{Binding HasBuiltInNodes}">
                <CheckBox Content="{l:T multiplayer.nodes.builtin_toggle}" IsChecked="{Binding UseBuiltInNodes}" />
                <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.nodes.builtin_hint}" />
                <ItemsControl ItemsSource="{Binding BuiltInNodes}" IsVisible="{Binding UseBuiltInNodes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:NodeItem">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <TextBlock Text="{Binding Url}" FontFamily="Consolas,monospace" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Url}" />
                        <TextBlock Grid.Column="1" Text="{Binding LatencyText}" Classes="hint" VerticalAlignment="Center" Margin="10,0" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <TextBlock Classes="hint" Text="{l:T multiplayer.nodes.empty}" IsVisible="{Binding !Nodes.Count}" />
              <ItemsControl ItemsSource="{Binding Nodes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:NodeItem">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                      <TextBlock Text="{Binding Url}" FontFamily="Consolas,monospace" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Url}" />
                      <TextBlock Grid.Column="1" Text="{Binding LatencyText}" Classes="hint" VerticalAlignment="Center" Margin="10,0" />
                      <Button Grid.Column="2" Content="{l:T common.delete}" Command="{Binding $parent[ItemsControl].((vm:MultiplayerViewModel)DataContext).RemoveNodeCommand}" CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding NewNodeUrl}" PlaceholderText="{l:T multiplayer.nodes.address_placeholder}" FontFamily="Consolas,monospace" />
                <Button Grid.Column="1" Content="{l:T common.add}" Command="{Binding AddNodeCommand}" Margin="6,0,0,0" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox Text="{Binding ShareCodeText}" PlaceholderText="{l:T multiplayer.nodes.share_placeholder}" />
                <Button Grid.Column="1" Content="{l:T common.import}" Command="{Binding ImportNodesCommand}" Margin="6,0,0,0" />
                <Button Grid.Column="2" Content="{l:T multiplayer.nodes.export}" Command="{Binding ExportNodesCommand}" Margin="6,0,0,0" />
              </Grid>
              <StackPanel x:Name="NodeSharePassphrasePanel" Spacing="4" IsVisible="{Binding ShareCodeIsSealed}">
                <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.nodes.sealed_hint}" />
                <TextBox x:Name="NodeSharePassphraseBox" Text="{Binding SharePassphrase}" FontFamily="Consolas,monospace" PlaceholderText="{l:T multiplayer.nodes.passphrase_placeholder}" />
              </StackPanel>
            </StackPanel>
            </StackPanel>
          </Border>

          <!-- Public networks -->
          <Border x:Name="NetworksCard" Classes="card" Margin="0" IsVisible="{Binding ShowPublicNetworks}">
            <StackPanel Spacing="8">
              <TextBlock Classes="h2" Text="{l:T multiplayer.settings.public}" Margin="0" />
              <Expander Header="{l:T multiplayer.network.title}" HorizontalAlignment="Stretch">
                <StackPanel Spacing="6">
                  <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.network.hint}" />
                  <ComboBox ItemsSource="{Binding NetworkChoices}" SelectedItem="{Binding SelectedNetworkChoice}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="vm:NetworkChoice">
                        <StackPanel Spacing="1">
                          <TextBlock Text="{Binding Label}" />
                          <TextBlock Classes="hint" FontSize="12" Text="{Binding Detail}" TextWrapping="Wrap" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <WrapPanel ItemSpacing="6" LineSpacing="6" IsVisible="{Binding CanRemoveNetwork}">
                    <Button Content="{l:T multiplayer.network.copy}" Command="{Binding CopyNetworkCommand}" />
                    <Button Content="{l:T multiplayer.network.remove}" Command="{Binding RemoveNetworkCommand}" />
                  </WrapPanel>
                  <TextBox Text="{Binding NetworkInput}" FontFamily="Consolas,monospace" TextWrapping="Wrap" MaxLength="40960" MaxHeight="96"
                           PlaceholderText="{l:T multiplayer.network.input_placeholder}" />
                  <Button Content="{l:T multiplayer.network.add}" Command="{Binding AddNetworkCommand}" HorizontalAlignment="Left" />
                  <Border Classes="card" Margin="0" IsVisible="{Binding NetworkConfirmOpen}">
                    <StackPanel Spacing="6">
                      <TextBlock TextWrapping="Wrap" Text="{Binding NetworkConfirmText}" />
                      <WrapPanel ItemSpacing="6" LineSpacing="6">
                        <Button Classes="primary" Content="{l:T multiplayer.network.confirm_add}" Command="{Binding ConfirmAddNetworkCommand}" />
                        <Button Content="{l:T common.cancel}" Command="{Binding CancelAddNetworkCommand}" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Expander>
              <Expander Header="{l:T multiplayer.public.nodes_title}" IsExpanded="{Binding !HasPublicNodes, Mode=OneTime}" HorizontalAlignment="Stretch">
                <StackPanel Spacing="6">
                  <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.public.nodes_hint}" />
                  <TextBox Text="{Binding PublicNodesText}" AcceptsReturn="True" MinHeight="56" FontFamily="Consolas,monospace" PlaceholderText="tcp://1.2.3.4:11010" />
                  <Button Content="{l:T multiplayer.public.save_nodes}" Command="{Binding SavePublicNodesCommand}" HorizontalAlignment="Left" />
                </StackPanel>
              </Expander>
              <Expander Header="{l:T multiplayer.volunteer.title}" HorizontalAlignment="Stretch" IsVisible="{Binding VolunteersAllowed}">
                <StackPanel Spacing="6">
                  <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.volunteer.hint}" />
                  <TextBlock FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.volunteer.privacy}" />
                  <CheckBox IsChecked="{Binding VolunteerEnabled}" Content="{l:T multiplayer.volunteer.enable}" />
                  <StackPanel Spacing="6" IsEnabled="{Binding VolunteerEnabled}">
                    <TextBlock FontSize="12" Text="{l:T multiplayer.volunteer.address}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                      <TextBox Text="{Binding VolunteerAddress}" FontFamily="Consolas,monospace" MaxLength="253" PlaceholderText="203.0.113.5 / jay.example.org" />
                      <Button Grid.Column="1" Content="{l:T multiplayer.volunteer.detect}" Command="{Binding DetectVolunteerAddressCommand}" IsEnabled="{Binding !IsCheckingVolunteer}" />
                    </Grid>
                    <WrapPanel ItemSpacing="12" LineSpacing="6">
                      <StackPanel Spacing="4">
                        <TextBlock FontSize="12" Text="{l:T multiplayer.volunteer.port}" />
                        <TextBox Text="{Binding VolunteerPort}" Width="110" MaxLength="5" />
                      </StackPanel>
                      <StackPanel Spacing="4">
                        <TextBlock FontSize="12" Text="{l:T multiplayer.volunteer.limit}" />
                        <TextBox Text="{Binding VolunteerLimit}" Width="110" MaxLength="7" />
                      </StackPanel>
                    </WrapPanel>
                    <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.volunteer.port_hint}" />
                  </StackPanel>
                  <WrapPanel ItemSpacing="6" LineSpacing="6">
                    <Button Content="{l:T multiplayer.volunteer.save}" Command="{Binding SaveVolunteerCommand}" />
                    <Button Content="{l:T multiplayer.volunteer.test}" Command="{Binding TestVolunteerPortCommand}" IsEnabled="{Binding !IsCheckingVolunteer}" />
                  </WrapPanel>
                  <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding VolunteerStatus}" IsVisible="{Binding VolunteerStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>

          <!-- Device verification (off by default) -->
          <Border Classes="card" Margin="0">
            <StackPanel Spacing="8">
              <StackPanel Spacing="6">
                <TextBlock Classes="h2" Text="{l:T multiplayer.device.title}" Margin="0" />
                <StackPanel Spacing="6">
                  <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.device.hint}" />
                  <Button Classes="primary" Content="{l:T multiplayer.device.enable}" Command="{Binding EnableDeviceCommand}" IsVisible="{Binding !DeviceEnabled}" HorizontalAlignment="Left" />
                  <StackPanel Spacing="6" IsVisible="{Binding DeviceEnabled}">
                    <TextBlock FontSize="12" Text="{Binding DeviceIdText}" />
                    <SelectableTextBlock Text="{Binding MyFingerprintCode}" FontFamily="Consolas,monospace" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <WrapPanel ItemSpacing="6" LineSpacing="6">
                      <Button Classes="primary" Content="{l:T multiplayer.device.new_code}" Command="{Binding NewFingerprintCodeCommand}" />
                      <Button Content="{l:T multiplayer.device.copy}" Command="{Binding CopyFingerprintCodeCommand}" />
                      <Button Content="{l:T multiplayer.device.rotate}" Command="{Binding RotateDeviceCommand}" />
                      <Button Content="{l:T multiplayer.device.disable}" Command="{Binding DisableDeviceCommand}" />
                    </WrapPanel>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- The multiplayer component -->
          <StackPanel Spacing="6">
            <TextBlock Classes="h2" Text="{l:T multiplayer.settings.component}" Margin="0" />
          <Border Classes="card" Margin="0">
            <StackPanel Spacing="8">
              <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                <TextBlock Text="{Binding ComponentText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <WrapPanel Grid.Row="1" ItemSpacing="6" LineSpacing="6" IsVisible="{Binding !IsComponentReady}">
                  <Button Classes="primary" Content="{l:T multiplayer.component.download}" Command="{Binding DownloadComponentCommand}" IsVisible="{Binding !IsDownloading}" />
                  <Button Content="{l:T multiplayer.component.import}" Click="ImportComponent_Click" IsVisible="{Binding !IsDownloading}" />
                </WrapPanel>
              </Grid>
              <c:ProgressLine x:Name="ComponentLineSettings" IsVisible="{Binding IsDownloading}" Step="{Binding Status}"
                              Percent="{Binding ComponentWork.Percent}" IsIndeterminate="{Binding ComponentWork.IsIndeterminate}"
                              BytesPerSecond="{Binding ComponentWork.BytesPerSecond}" Remaining="{Binding ComponentWork.Remaining}"
                              CancelCommand="{Binding CancelDownloadCommand}" />
              <SelectableTextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{Binding ManualHintText}" IsVisible="{Binding !IsComponentReady}" />
              <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{Binding LicenseText}" />
            </StackPanel>
          </Border>
          </StackPanel>

          <!-- Advanced (collapsed; the header says what is not default) -->
          <Expander x:Name="AdvancedExpander" IsVisible="{Binding IsIdle}" HorizontalAlignment="Stretch">
            <Expander.Header>
              <TextBlock Text="{Binding AdvancedHeaderText}" TextWrapping="Wrap" FontWeight="SemiBold" />
            </Expander.Header>
            <StackPanel Spacing="14">
              <StackPanel Spacing="4">
                <CheckBox Content="{l:T multiplayer.lan.full_mode}" IsChecked="{Binding FullLanMode}" IsEnabled="{Binding CanUseFullLan}" />
                <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap"
                           Text="{l:T multiplayer.lan.full_mode_hint}" />
                <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource WarningText}"
                           Text="{Binding FullLanUnavailableText}" IsVisible="{Binding !CanUseFullLan}" />
                <CheckBox Content="{l:T multiplayer.exit.allow}" IsChecked="{Binding AllowExitNode}" IsEnabled="{Binding FullLanMode}" IsVisible="{Binding ShowNetworkExit}" Margin="0,6,0,0" />
                <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding AllowExitNode}" Foreground="{DynamicResource WarningText}"
                           Text="{l:T multiplayer.exit.warning}" />
                <CheckBox Content="{l:T multiplayer.proxy.allow}" IsChecked="{Binding AllowGameProxy}" Margin="0,6,0,0" />
                <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding AllowGameProxy}" Foreground="{DynamicResource WarningText}"
                           Text="{l:T multiplayer.proxy.allow_warning}" />
              </StackPanel>

              <!-- 数据封装（开房间时选；加入时按房间码） -->
              <StackPanel Spacing="4">
                <!-- 窄窗口、长译文时自动换行。 -->
                <WrapPanel ItemSpacing="8" LineSpacing="4">
                  <TextBlock Text="{l:T multiplayer.transport.label}" VerticalAlignment="Center" FontWeight="SemiBold" />
                  <ComboBox ItemsSource="{Binding TransportChoices}" SelectedItem="{Binding SelectedTransport}" MinWidth="140">
                    <!-- 下拉里每种模式带一句说明；选中后框里只显示名字 -->
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="vm:TransportChoice">
                        <StackPanel MaxWidth="420">
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Privacy}" FontSize="12" TextWrapping="Wrap" Opacity="0.75" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.SelectionBoxItemTemplate>
                      <DataTemplate DataType="vm:TransportChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
                    </ComboBox.SelectionBoxItemTemplate>
                  </ComboBox>
                  <CheckBox Content="{l:T multiplayer.transport.disguise}" IsChecked="{Binding DisguiseAsMinecraft}" IsEnabled="{Binding CanDisguise}" />
                </WrapPanel>
                <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding SelectedTransport.Privacy}" />
                <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{Binding SelectedTransport.Detail}" />
                <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap"
                           Text="{l:T multiplayer.transport.hint}" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="{l:T multiplayer.direct.stun_heading}" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBox Text="{Binding StunText}" PlaceholderText="{l:T multiplayer.direct.stun_placeholder}" />
              </StackPanel>
            </StackPanel>
          </Expander>

          <!-- Diagnostics -->
          <Border Classes="card" Margin="0">
            <StackPanel Spacing="8">
              <TextBlock Classes="h2" Text="{l:T multiplayer.settings.diagnostics}" Margin="0" />
              <WrapPanel ItemSpacing="6" LineSpacing="4">
                <Button Content="{l:T multiplayer.network.check}" Command="{Binding CheckNetworkCommand}" IsEnabled="{Binding !IsCheckingNetwork}" />
                <CheckBox Content="{l:T multiplayer.diagnostics.debug_mode}" IsChecked="{Binding DebugMode}" ToolTip.Tip="{l:T multiplayer.diagnostics.debug_tooltip}" />
              </WrapPanel>
              <SelectableTextBlock Text="{Binding NetworkCheckText}" TextWrapping="Wrap" FontSize="12" IsVisible="{Binding NetworkCheckText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Debug log: in a room and in settings, while debug mode is on -->
        <Panel IsVisible="{Binding !IsServersTab}">
          <!-- 调试日志 -->
          <Border Classes="card" Margin="0" IsVisible="{Binding DebugMode}">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Classes="h2" Text="{l:T multiplayer.diagnostics.title}" Margin="0" VerticalAlignment="Center" />
                <CheckBox Grid.Column="1" Content="{l:T multiplayer.diagnostics.include_ips}" IsChecked="{Binding IncludePublicIps}" Margin="0,0,8,0" />
                <Button Grid.Column="2" Content="{l:T multiplayer.diagnostics.export}" Click="ExportDiagnostics_Click" />
              </Grid>
              <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.diagnostics.hint}" />
              <Border Background="{DynamicResource PageBg}" CornerRadius="6" Padding="8" Height="260">
                <ScrollViewer Name="DebugScroll">
                  <ItemsControl ItemsSource="{Binding DebugLines}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate><SelectableTextBlock Text="{Binding}" FontFamily="Consolas,monospace" FontSize="{DynamicResource FontCaption}" TextWrapping="Wrap" /></DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
            </StackPanel>
          </Border>
        </Panel>

      </StackPanel>
    </ScrollViewer>

    <!-- 消息被 ✕ 关掉后整张卡片一起收起，不留空卡片 -->
    <Border svc:ThemeRegion.Name="multiplayer.status" Grid.Row="4" Classes="card" Margin="0" IsVisible="{Binding #PageStatus.IsShowing}">
      <c:StatusBar x:Name="PageStatus" Message="{Binding StatusInfo}" />
    </Border>

    <!-- "Connection problems?" (official §6.18): a 560 drawer over the page (full width in compact windows). One check, a plain
         conclusion, suggestions, and the technical details folded away. Esc closes; Ctrl+Shift+D opens. -->
    <Border x:Name="DiagnosticsDrawer" Grid.Row="0" Grid.RowSpan="5" Width="560" HorizontalAlignment="Right" ZIndex="10"
            Classes="card" Margin="0" Padding="16" BoxShadow="0 4 24 0 #40000000" IsVisible="{Binding DiagnosticsOpen}">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
          <TextBlock Classes="h2" Text="{l:T multiplayer.room.problems}" Margin="0" VerticalAlignment="Center" />
          <Button x:Name="CloseDiagnosticsButton" Grid.Column="1" Classes="ghost small" Content="✕" Command="{Binding CloseDiagnosticsCommand}" ToolTip.Tip="{l:T common.close}" />
        </Grid>
        <ScrollViewer>
          <StackPanel Spacing="10">
            <TextBlock Classes="hint" TextWrapping="Wrap" Text="{l:T multiplayer.diag.intro}" />
            <Button x:Name="DiagnosticsCheckButton" Classes="primary" Content="{l:T multiplayer.network.check}" Command="{Binding CheckNetworkCommand}" IsEnabled="{Binding !IsCheckingNetwork}" HorizontalAlignment="Left" />
            <TextBlock x:Name="DiagnosticsVerdict" Text="{Binding NetworkVerdict}" FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="{Binding HasNetworkVerdict}" />
            <TextBlock Text="{l:T multiplayer.diag.suggest}" FontWeight="SemiBold" />
            <WrapPanel ItemSpacing="6" LineSpacing="6">
              <Button x:Name="SwitchRelayButton" Content="{l:T multiplayer.diag.switch_relay}" Command="{Binding SwitchRelayCommand}" />
              <Button x:Name="DebugOnButton" Content="{l:T multiplayer.diag.debug_on}" Command="{Binding TurnOnDebugModeCommand}" IsVisible="{Binding !DebugMode}" />
              <Button x:Name="DrawerExportButton" Content="{l:T multiplayer.diagnostics.export}" Click="ExportDiagnostics_Click" />
            </WrapPanel>
            <CheckBox Content="{l:T multiplayer.diagnostics.include_ips}" IsChecked="{Binding IncludePublicIps}" />
            <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.diag.export_hint}" />
            <Expander x:Name="DiagnosticsDetails" Header="{l:T multiplayer.diag.details}" HorizontalAlignment="Stretch">
              <StackPanel Spacing="8">
                <SelectableTextBlock Text="{Binding NetworkDetails}" FontFamily="Consolas,Menlo,monospace" FontSize="12" TextWrapping="Wrap"
                                     IsVisible="{Binding NetworkDetails, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <SelectableTextBlock Text="{Binding TransportText}" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding !IsIdle}" />
                <ItemsControl ItemsSource="{Binding Peers}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:PeerItem">
                      <SelectableTextBlock FontFamily="Consolas,Menlo,monospace" FontSize="12" TextWrapping="Wrap" Text="{Binding Meta}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding DebugLines}" IsVisible="{Binding DebugMode}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate><SelectableTextBlock Text="{Binding}" FontFamily="Consolas,Menlo,monospace" FontSize="11" TextWrapping="Wrap" /></DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Expander>
            <!-- Try a download (it used to be in the toolbox): fetch one file, optionally checking its SHA-1 -->
            <Expander x:Name="DownloadTest" Header="{l:T tools.download.title}" HorizontalAlignment="Stretch" DataContext="{Binding Tools}">
              <StackPanel Spacing="8" x:DataType="vm:ToolsViewModel">
                <TextBox x:Name="DownloadUrlBox" Text="{Binding DownloadUrl}" PlaceholderText="{l:T tools.download.url_hint}" AutomationProperties.Name="{l:T tools.download.url_hint}" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Text="{Binding DownloadFolder}" PlaceholderText="{l:T tools.download.folder_hint}" AutomationProperties.Name="{l:T tools.download.folder_hint}" />
                  <Button Grid.Column="1" Content="{l:T common.browse}" Margin="8,0,0,0" Click="BrowseDownloadFolder_Click" />
                </Grid>
                <TextBox Text="{Binding DownloadSha1}" PlaceholderText="{l:T tools.download.sha1_hint}" AutomationProperties.Name="{l:T tools.download.sha1_hint}" />
                <Button x:Name="DownloadTestButton" Classes="secondary" Content="{l:T tools.download.start}" Command="{Binding DownloadFileCommand}" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Left" />
                <c:ProgressLine x:Name="DownloadTestLine" Title="{Binding BusyTitle}" Step="{Binding Status}" IsIndeterminate="True" BytesPerSecond="{Binding BytesPerSecond}"
                                CancelCommand="{Binding CancelCommand}" IsVisible="{Binding IsDownloadingFile}" />
                <c:StatusBar Message="{Binding DownloadMessage}" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Drill mode (official §9.5): a pretend friend plays the risky moments; each answer is explained on the spot.
         Same drawer shape as the diagnostics one. Nothing in it connects anywhere. -->
    <Border x:Name="DrillDrawer" Grid.Row="0" Grid.RowSpan="5" Width="560" HorizontalAlignment="Right" ZIndex="11"
            Classes="card" Margin="0" Padding="16" BoxShadow="0 4 24 0 #40000000" IsVisible="{Binding DrillOpen}">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
          <TextBlock Classes="h2" Text="{l:T drill.title}" Margin="0" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button x:Name="CloseDrillButton" Grid.Column="1" Classes="ghost small" Content="✕" Command="{Binding CloseDrillCommand}" ToolTip.Tip="{l:T common.close}" />
        </Grid>
        <ScrollViewer>
          <StackPanel Spacing="12">
            <TextBlock Classes="hint" TextWrapping="Wrap" Text="{l:T drill.intro}" />
            <StackPanel Spacing="12" IsVisible="{Binding !DrillDone}">
              <TextBlock x:Name="DrillProgressText" Classes="hint" Text="{Binding DrillProgress}" />
              <Border Classes="card" Padding="14" Margin="0">
                <StackPanel Spacing="10">
                  <TextBlock x:Name="DrillPromptText" Text="{Binding DrillPrompt}" TextWrapping="Wrap" FontWeight="SemiBold" />
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6" IsVisible="{Binding DrillShowsCodes}">
                    <TextBlock Classes="hint" Text="{l:T drill.code_shown}" VerticalAlignment="Center" />
                    <TextBlock x:Name="DrillShownCodeText" Grid.Column="1" Text="{Binding DrillShownCode}" FontFamily="Consolas,Menlo,monospace" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Classes="hint" Text="{l:T drill.code_said}" VerticalAlignment="Center" />
                    <TextBlock x:Name="DrillSaidCodeText" Grid.Row="1" Grid.Column="1" Text="{Binding DrillSaidCode}" FontFamily="Consolas,Menlo,monospace" FontSize="18" FontWeight="SemiBold" />
                  </Grid>
                  <WrapPanel ItemSpacing="8" LineSpacing="6" IsVisible="{Binding DrillAsking}">
                    <Button x:Name="DrillNoButton" Content="{Binding DrillNoText}" Command="{Binding DrillAnswerNoCommand}" />
                    <Button x:Name="DrillYesButton" Content="{Binding DrillYesText}" Command="{Binding DrillAnswerYesCommand}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <StackPanel x:Name="DrillFeedback" Spacing="6" IsVisible="{Binding DrillExplaining}">
                <TextBlock x:Name="DrillVerdictText" Text="{Binding DrillVerdict}" FontWeight="SemiBold" Classes.ok="{Binding DrillRight}" Classes.warn="{Binding !DrillRight}" />
                <TextBlock x:Name="DrillLessonText" Text="{Binding DrillLesson}" TextWrapping="Wrap" />
                <Button x:Name="DrillNextButton" Classes="primary" Content="{l:T drill.next}" Command="{Binding DrillNextCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </StackPanel>
            <StackPanel x:Name="DrillDonePanel" Spacing="10" IsVisible="{Binding DrillDone}">
              <TextBlock x:Name="DrillScoreText" Text="{Binding DrillScore}" TextWrapping="Wrap" FontWeight="SemiBold" />
              <WrapPanel ItemSpacing="8" LineSpacing="6">
                <Button x:Name="DrillRestartButton" Content="{l:T drill.again}" Command="{Binding DrillRestartCommand}" />
                <Button x:Name="DrillFinishButton" Content="{l:T common.close}" Command="{Binding CloseDrillCommand}" />
              </WrapPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- The two short lessons (official §9.5): five illustrated cards each, ← → to page, Esc closes. -->
    <Border x:Name="LessonDrawer" Grid.Row="0" Grid.RowSpan="5" Width="560" HorizontalAlignment="Right" ZIndex="11"
            Classes="card" Margin="0" Padding="16" BoxShadow="0 4 24 0 #40000000" IsVisible="{Binding LessonOpen}">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
          <TextBlock x:Name="LessonHeadingText" Classes="h2" Text="{Binding LessonHeading}" Margin="0" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button x:Name="CloseLessonButton" Grid.Column="1" Classes="ghost small" Content="✕" Command="{Binding CloseLessonCommand}" ToolTip.Tip="{l:T common.close}" />
        </Grid>
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
          <Button x:Name="LessonPreviousButton" Content="{l:T lesson.previous}" Command="{Binding LessonPreviousCommand}" IsVisible="{Binding LessonHasPrevious}" />
          <TextBlock x:Name="LessonStepText" Grid.Column="1" Classes="hint" Text="{Binding LessonStep}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Panel Grid.Column="2">
            <Button x:Name="LessonNextButton" Classes="primary" Content="{l:T lesson.next}" Command="{Binding LessonNextCommand}" IsVisible="{Binding LessonHasNext}" />
            <Button x:Name="LessonDoneButton" Classes="primary" Content="{l:T lesson.done}" Command="{Binding LessonNextCommand}" IsVisible="{Binding LessonIsLast}" />
          </Panel>
        </Grid>
        <ScrollViewer>
          <StackPanel Spacing="12">
            <c:LineArt x:Name="LessonArt" Picture="{Binding LessonPicture}" MaxHeight="160" HorizontalAlignment="Center" />
            <TextBlock x:Name="LessonTitleText" Text="{Binding LessonTitle}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="{DynamicResource FontSubtitle}" />
            <TextBlock x:Name="LessonBodyText" Text="{Binding LessonBody}" TextWrapping="Wrap" />
            <WrapPanel ItemSpacing="8" LineSpacing="6" IsVisible="{Binding LessonIsLast}">
              <Button x:Name="LessonDiagnosticsButton" Content="{l:T multiplayer.room.problems}" Command="{Binding LessonDiagnosticsCommand}" IsVisible="{Binding LessonOffersDiagnostics}" />
              <Button x:Name="LessonDrillButton" Content="{l:T multiplayer.lobby.drill}" Command="{Binding LessonDrillCommand}" IsVisible="{Binding LessonOffersDrill}" />
              <Button x:Name="LessonArticleButton" Classes="ghost" Content="{l:T lesson.article}" Command="{Binding LessonArticleCommand}" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
