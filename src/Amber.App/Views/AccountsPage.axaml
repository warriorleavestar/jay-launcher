<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="using:Amber.App.Services"
             xmlns:vm="using:Amber.App.ViewModels"
             xmlns:c="using:Amber.App.Views.Controls"
             xmlns:l="using:Amber.App.Localization"
             xmlns:auth="using:Amber.Core.Auth"
             x:Class="Amber.App.Views.AccountsPage"
             x:DataType="vm:AccountsViewModel">
  <!-- 按页面自己的宽度排版（不看窗口、不看屏幕）：
       窄（< 640）：右边“添加账号”卡片收窄，皮肤预览收起，账号列表留够宽度；
       账号条目再按列表宽度判断，放不下一行时“使用”“移除”换到第二行。 -->
  <UserControl.Styles>
    <!-- 会被下面按宽度改掉的属性只能写在样式里：控件上直接写的值优先级比样式高，容器查询就改不动了 -->
    <Style Selector="Border#AddCard">
      <Setter Property="Width" Value="320" />
    </Style>
    <Style Selector="WrapPanel.account-actions">
      <Setter Property="Grid.Column" Value="2" />
    </Style>
    <!-- 添加账号卡片窄时，按钮文字（尤其是较长的翻译）换行而不是被截掉 -->
    <Style Selector="Border#AddCard Button /template/ ContentPresenter">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Explanations stay at a readable line length on wide windows -->
    <Style Selector="TextBlock.hint[TextWrapping=Wrap]">
      <Setter Property="MaxWidth" Value="720" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <ContainerQuery Name="AccountsPageRoot" Query="max-width:640">
      <Style Selector="Border#AddCard">
        <Setter Property="Width" Value="240" />
      </Style>
      <Style Selector="Panel#SkinPreviewHost">
        <Setter Property="IsVisible" Value="False" />
      </Style>
    </ContainerQuery>
    <ContainerQuery Name="AccountItem" Query="max-width:420">
      <Style Selector="WrapPanel.account-actions">
        <Setter Property="Grid.Row" Value="1" />
        <Setter Property="Grid.Column" Value="1" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="12,8,0,0" />
      </Style>
    </ContainerQuery>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,Auto" Container.Name="AccountsPageRoot" Container.Sizing="Width">
    <TextBlock svc:ThemeRegion.Name="me.title" Classes="h1" Text="{l:T me.title}" Grid.ColumnSpan="2" />

    <!-- Left column scrolls as a whole: the MC account list, then the Jay account card (its create / restore steps can be tall). -->
    <ScrollViewer x:Name="AccountsLeftScroll" Grid.Row="1" Margin="0,0,0,14">
    <StackPanel Spacing="14">
    <Border svc:ThemeRegion.Name="me.accounts" x:Name="GameAccountsCard" Classes="card" Padding="8" Margin="0">
      <!-- 皮肤预览放在列表左边一块固定大小的区域里，不再挤在下面留一大块空白；页面窄时收起，给列表让位置 -->
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,*">
        <TextBlock Classes="h2" Text="{l:T me.accounts.title}" Grid.ColumnSpan="2" Margin="8,4,8,6" />
        <Panel x:Name="SkinPreviewHost" Grid.Row="1">
          <Border Width="104" Margin="4,4,10,4" VerticalAlignment="Top" IsVisible="{Binding Current.Body, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Image Source="{Binding Current.Body}" Width="96" Height="192" Stretch="Uniform"
                   RenderOptions.BitmapInterpolationMode="None" ToolTip.Tip="{l:T accounts.skin.tooltip}" />
          </Border>
        </Panel>
        <ListBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Accounts}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:AccountItem">
              <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Margin="4" Container.Name="AccountItem" Container.Sizing="Width">
                <Border Width="40" Height="40" CornerRadius="6" Background="{DynamicResource Accent}" ClipToBounds="True">
                  <Panel>
                    <TextBlock Text="{Binding Initial}" IsVisible="{Binding HasNoAvatar}" Foreground="{DynamicResource OnAccent}" FontWeight="Bold" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding Head}" RenderOptions.BitmapInterpolationMode="None" />
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                  <!-- 名字太长时省略，“当前”标签始终看得见 -->
                  <!-- 靠左的 Grid：放得下时星号列就是名字的宽度，“当前”紧跟在后面；放不下时只压缩名字 -->
                  <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                    <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{l:T accounts.current.label}" IsVisible="{Binding IsCurrent}" Foreground="{DynamicResource AccentText}" />
                  </Grid>
                  <TextBlock Text="{Binding KindText}" Classes="hint" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding KindText}" />
                  <TextBlock Text="{l:T accounts.external.insecure_saved}" IsVisible="{Binding InsecureServer}" Foreground="{DynamicResource WarningText}"
                             FontSize="12" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding JayText}" IsVisible="{Binding HasJay}" Classes="hint" FontSize="12" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <WrapPanel Classes="account-actions" ItemSpacing="6" LineSpacing="6" VerticalAlignment="Center">
                  <Button Content="{l:T common.use}" IsVisible="{Binding !IsCurrent}" Command="{Binding $parent[ListBox].((vm:AccountsViewModel)DataContext).UseCommand}" CommandParameter="{Binding}" />
                  <Button Content="{l:T accounts.jay.unbind}" IsVisible="{Binding HasJay}" Command="{Binding $parent[ListBox].((vm:AccountsViewModel)DataContext).UnbindJayCommand}" CommandParameter="{Binding}" />
                  <c:ConfirmButton Content="{l:T common.remove}" ConfirmText="{l:T common.confirm_remove}" ObjectName="{Binding Name}" Command="{Binding $parent[ListBox].((vm:AccountsViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}" />
                </WrapPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>


    <!-- Jay account (recovery-phrase identity): list, create (words → check → save), restore. Words are never copied or saved. -->
    <Border svc:ThemeRegion.Name="me.jay" x:Name="JayCard" Classes="card" Margin="0">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="{l:T accounts.jay.title}" Margin="0" />

          <Border x:Name="JaySuggestion" Classes="callout info" IsVisible="{Binding HasJaySuggestion}">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding JaySuggestionText}" TextWrapping="Wrap" />
              <WrapPanel ItemSpacing="8" LineSpacing="8">
                <Button Classes="primary" Content="{l:T accounts.jay.suggest_create}" Command="{Binding StartCreateJayCommand}" />
                <Button Content="{l:T accounts.jay.suggest_later}" Command="{Binding DismissJaySuggestionCommand}" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <TextBlock Classes="hint" Text="{l:T accounts.jay.intro}" TextWrapping="Wrap" IsVisible="{Binding ShowJayIntro}" />

          <ItemsControl x:Name="JayAccountList" ItemsSource="{Binding JayAccounts}" IsVisible="{Binding JayIdle}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:JayAccountItem">
                <Border Background="{DynamicResource PageBg}" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                  <StackPanel Spacing="4">
                    <SelectableTextBlock Text="{Binding Address}" FontFamily="{DynamicResource MonoFont}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CheckWords}" Classes="hint" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding BoundText}" Classes="hint" FontSize="12" TextWrapping="Wrap" />
                    <WrapPanel ItemSpacing="6" LineSpacing="6" Margin="0,4,0,0">
                      <Button Content="{l:T accounts.jay.bind}" Command="{Binding #JayAccountList.((vm:AccountsViewModel)DataContext).BindJayCommand}" CommandParameter="{Binding}" />
                      <Button Content="{l:T accounts.jay.copy_address}" Command="{Binding #JayAccountList.((vm:AccountsViewModel)DataContext).CopyJayAddressCommand}" CommandParameter="{Binding}" />
                      <c:ConfirmButton Content="{l:T accounts.jay.remove}" ConfirmText="{l:T accounts.jay.remove_confirm}" ObjectName="{Binding ShortAddress}"
                                       Command="{Binding #JayAccountList.((vm:AccountsViewModel)DataContext).RemoveJayCommand}" CommandParameter="{Binding}" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <WrapPanel ItemSpacing="8" LineSpacing="8" IsVisible="{Binding JayIdle}">
            <Button x:Name="CreateJayButton" Content="{l:T accounts.jay.create}" Command="{Binding StartCreateJayCommand}" />
            <Button x:Name="RestoreJayButton" Content="{l:T accounts.jay.restore}" Command="{Binding StartRestoreJayCommand}" />
          </WrapPanel>

          <!-- Step 1: the new words, numbered, in a grid that wraps. -->
          <StackPanel Spacing="10" IsVisible="{Binding JayShowingWords}">
            <TextBlock FontWeight="SemiBold" FontSize="15" Text="{l:T accounts.jay.words_title}" />
            <Border Classes="callout warning">
              <TextBlock Text="{l:T accounts.jay.words_warning}" TextWrapping="Wrap" />
            </Border>
            <CheckBox Content="{l:T accounts.jay.words_chinese}" IsChecked="{Binding JayChineseWords}" />
            <ItemsControl x:Name="NewWordsList" ItemsSource="{Binding NewWords}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemSpacing="6" LineSpacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:MnemonicWord">
                  <Border Background="{DynamicResource PageBg}" CornerRadius="6" Padding="8,4" MinWidth="104">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Number}" Classes="hint" FontSize="12" VerticalAlignment="Center" MinWidth="18" />
                      <TextBlock Text="{Binding Word}" FontWeight="SemiBold" FontSize="15" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Expander Header="{l:T accounts.jay.passphrase_title}" HorizontalAlignment="Stretch">
              <StackPanel Spacing="8">
                <TextBlock Classes="hint" Text="{l:T accounts.jay.passphrase_hint}" TextWrapping="Wrap" />
                <TextBox Text="{Binding NewPassphrase}" PasswordChar="●" PlaceholderText="{l:T accounts.jay.passphrase_placeholder}" />
                <TextBox Text="{Binding NewPassphraseRepeat}" PasswordChar="●" PlaceholderText="{l:T accounts.jay.passphrase_repeat_placeholder}" />
              </StackPanel>
            </Expander>
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button x:Name="WordsWrittenButton" Classes="primary" Content="{l:T accounts.jay.written}" Command="{Binding WordsWrittenDownCommand}" />
              <Button Content="{l:T common.cancel}" Command="{Binding CancelJayCommand}" />
            </WrapPanel>
          </StackPanel>

          <!-- Step 2: three random words by position. -->
          <StackPanel Spacing="10" IsVisible="{Binding JayQuiz}">
            <TextBlock FontWeight="SemiBold" FontSize="15" Text="{l:T accounts.jay.quiz_title}" />
            <ItemsControl x:Name="QuizList" ItemsSource="{Binding QuizQuestions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:QuizQuestion">
                  <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" MinWidth="90" />
                    <TextBox Grid.Column="1" Text="{Binding Answer}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button x:Name="FinishJayButton" Classes="primary" Content="{l:T accounts.jay.quiz_finish}" Command="{Binding FinishCreateJayCommand}" />
              <Button Content="{l:T accounts.jay.quiz_back}" Command="{Binding BackToWordsCommand}" />
              <Button Content="{l:T common.cancel}" Command="{Binding CancelJayCommand}" />
            </WrapPanel>
          </StackPanel>

          <!-- Restore: words + optional extra password. -->
          <StackPanel Spacing="10" IsVisible="{Binding JayRestoring}">
            <TextBlock FontWeight="SemiBold" FontSize="15" Text="{l:T accounts.jay.restore_title}" />
            <TextBox x:Name="RestoreWordsBox" Text="{Binding RestoreText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                     PlaceholderText="{l:T accounts.jay.restore_placeholder}" />
            <Expander Header="{l:T accounts.jay.passphrase_title}" HorizontalAlignment="Stretch">
              <TextBox Text="{Binding RestorePassphrase}" PasswordChar="●" PlaceholderText="{l:T accounts.jay.passphrase_placeholder}" />
            </Expander>
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button x:Name="RestoreJayConfirm" Classes="primary" Content="{l:T accounts.jay.restore_button}" Command="{Binding RestoreJayCommand}" />
              <Button Content="{l:T common.cancel}" Command="{Binding CancelJayCommand}" />
            </WrapPanel>
          </StackPanel>

          <Border Classes="callout warning" IsVisible="{Binding HasJayError}">
            <TextBlock x:Name="JayErrorText" Text="{Binding JayError}" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
    </Border>

    <!-- My friend code: what a friend needs to ask to add me. Adding and managing friends is on the Friends page. -->
    <Border svc:ThemeRegion.Name="me.code" x:Name="FriendCodeCard" Classes="card" Margin="0">
      <StackPanel Spacing="8">
        <TextBlock Classes="h2" Text="{l:T multiplayer.contacts.my_code}" Margin="0" />
        <StackPanel Spacing="8" IsVisible="{Binding ShowFriendCode}">
          <Grid ColumnDefinitions="*,Auto">
            <SelectableTextBlock x:Name="MyFriendCodeText" Text="{Binding MyFriendCode}" FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                 TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button x:Name="CopyFriendCodeButton" Grid.Column="1" Classes="small" Margin="8,0,0,0" Content="{l:T common.copy}"
                    Command="{Binding CopyFriendCodeCommand}" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Classes="hint" FontSize="12" Text="{l:T me.code.hint}" TextWrapping="Wrap" />
          <Button x:Name="OpenPeopleButton" Classes="secondary small" Content="{l:T me.code.people}" Command="{Binding OpenPeopleCommand}" HorizontalAlignment="Left" />
        </StackPanel>
        <TextBlock x:Name="FriendCodeChildNote" Classes="hint" Text="{l:T me.code.child}" IsVisible="{Binding !ShowFriendCode}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <StackPanel svc:ThemeRegion.Name="me.devices" Spacing="14">
      <!-- My devices: this computer's identity, and device verification. Computers under the same Jay account count as one person. -->
      <Border x:Name="DevicesCard" Classes="card" Margin="0">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="{l:T me.devices.title}" Margin="0" />
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Border Classes="led online" VerticalAlignment="Top" Margin="0,6,0,0" />
            <StackPanel Grid.Column="1" Spacing="1">
              <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                <Run Text="{l:T me.devices.this}" /><Run Text=" · " /><Run Text="{Binding ThisDeviceName, Mode=OneWay}" />
              </TextBlock>
              <SelectableTextBlock x:Name="ThisDeviceCodeText" Classes="hint" FontSize="12" Text="{Binding ThisDeviceCode}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
          <TextBlock x:Name="DevicesNote" Classes="hint" FontSize="12" Text="{Binding DevicesNote}" TextWrapping="Wrap" />
          <Button x:Name="DevicesCreateJay" Classes="small" Content="{l:T me.devices.create_jay}" Command="{Binding StartCreateJayCommand}"
                  IsVisible="{Binding ShowJayIntro}" HorizontalAlignment="Left" />
          <!-- This computer's multiplayer identity (it used to be in the lobby's settings tab). A new identity changes the
               safety code above: friends have to compare emoji again. -->
          <StackPanel x:Name="IdentityCard" Spacing="6" Margin="0,6,0,0" DataContext="{Binding Multiplayer}" x:DataType="vm:MultiplayerViewModel">
            <TextBlock Text="{l:T multiplayer.identity.title}" FontWeight="SemiBold" />
            <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.identity.reset_hint}" />
            <Button x:Name="ResetIdentityButton" Content="{l:T multiplayer.identity.reset}" Command="{Binding ResetIdentityCommand}" IsEnabled="{Binding IsIdle}" HorizontalAlignment="Left" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Device verification (off by default): a code from this computer's hardware that a host can ask for. -->
      <Border x:Name="DeviceCheckCard" Classes="card" Margin="0" DataContext="{Binding Multiplayer}" x:DataType="vm:MultiplayerViewModel">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="{l:T multiplayer.device.title}" Margin="0" />
          <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.device.hint}" />
          <Button x:Name="EnableDeviceButton" Classes="secondary" Content="{l:T multiplayer.device.enable}" Command="{Binding EnableDeviceCommand}" IsVisible="{Binding !DeviceEnabled}" HorizontalAlignment="Left" />
          <StackPanel Spacing="6" IsVisible="{Binding DeviceEnabled}">
            <TextBlock FontSize="12" Text="{Binding DeviceIdText}" />
            <SelectableTextBlock Text="{Binding MyFingerprintCode}" FontFamily="Consolas,monospace" FontWeight="SemiBold" TextWrapping="Wrap" />
            <WrapPanel ItemSpacing="6" LineSpacing="6">
              <Button Classes="secondary" Content="{l:T multiplayer.device.new_code}" Command="{Binding NewFingerprintCodeCommand}" />
              <Button Content="{l:T multiplayer.device.copy}" Command="{Binding CopyFingerprintCodeCommand}" />
              <Button Content="{l:T multiplayer.device.rotate}" Command="{Binding RotateDeviceCommand}" />
              <Button Content="{l:T multiplayer.device.disable}" Command="{Binding DisableDeviceCommand}" />
            </WrapPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Appearance: light/dark and the language right here; theme packs are in the settings. -->
    <Border svc:ThemeRegion.Name="me.appearance" x:Name="AppearanceCard" Classes="card" Margin="0">
      <StackPanel Spacing="8">
        <TextBlock Classes="h2" Text="{l:T settings.group.appearance}" Margin="0" />
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" DataContext="{Binding Appearance}" x:DataType="vm:QuickAppearanceViewModel">
          <TextBlock Text="{l:T me.appearance.mode}" VerticalAlignment="Center" />
          <UniformGrid x:Name="MeTheme" Grid.Column="1" Columns="3" Classes="segmented" MaxWidth="360" HorizontalAlignment="Left">
            <RadioButton x:Name="MeThemeSystem" GroupName="MeTheme" IsChecked="{Binding IsSystemTheme}" ToolTip.Tip="{l:T settings.theme.system}">
              <TextBlock Text="{l:T settings.theme.system}" TextTrimming="CharacterEllipsis" />
            </RadioButton>
            <RadioButton x:Name="MeThemeLight" GroupName="MeTheme" IsChecked="{Binding IsLightTheme}" ToolTip.Tip="{l:T settings.theme.light}">
              <TextBlock Text="{l:T settings.theme.light}" TextTrimming="CharacterEllipsis" />
            </RadioButton>
            <RadioButton x:Name="MeThemeDark" GroupName="MeTheme" IsChecked="{Binding IsDarkTheme}" ToolTip.Tip="{l:T settings.theme.dark}">
              <TextBlock Text="{l:T settings.theme.dark}" TextTrimming="CharacterEllipsis" />
            </RadioButton>
          </UniformGrid>
        </Grid>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" DataContext="{Binding Appearance}" x:DataType="vm:QuickAppearanceViewModel">
          <TextBlock Text="{l:T me.appearance.language}" VerticalAlignment="Center" />
          <ComboBox x:Name="MeLanguage" Grid.Column="1" MinWidth="180" HorizontalAlignment="Left"
                    ItemsSource="{Binding LanguageOptions}" SelectedIndex="{Binding LanguageIndex}"
                    AutomationProperties.Name="{l:T me.appearance.language}" />
        </Grid>
        <WrapPanel ItemSpacing="8" LineSpacing="6">
          <Button x:Name="MeThemesButton" Classes="secondary small" Content="{l:T me.appearance.themes}" Command="{Binding OpenThemesCommand}" />
          <Button x:Name="MeAboutButton" Classes="ghost small" Content="{l:T about.title}" Command="{Binding OpenAboutCommand}" />
        </WrapPanel>
      </StackPanel>
    </Border>
    </StackPanel>
    </ScrollViewer>

    <Border svc:ThemeRegion.Name="me.add" x:Name="AddCard" Grid.Row="1" Grid.Column="1" Classes="card" Margin="14,0,0,14">
      <ScrollViewer>
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="{l:T accounts.add.title}" Margin="0" />
          <!-- 三段式选择器（改版规格 3.5）：正版 | 离线 | 皮肤站，每段一样宽，放不下时省略并给 ToolTip。 -->
          <UniformGrid x:Name="LoginKindSwitch" Columns="3" Classes="segmented">
            <RadioButton GroupName="LoginKind" IsChecked="{Binding IsMicrosoftTab}" ToolTip.Tip="{l:T accounts.tab.microsoft}">
              <TextBlock Text="{l:T accounts.tab.microsoft}" TextTrimming="CharacterEllipsis" />
            </RadioButton>
            <RadioButton GroupName="LoginKind" IsChecked="{Binding IsOfflineTab}" ToolTip.Tip="{l:T accounts.tab.offline}">
              <TextBlock Text="{l:T accounts.tab.offline}" TextTrimming="CharacterEllipsis" />
            </RadioButton>
            <RadioButton GroupName="LoginKind" IsChecked="{Binding IsExternalTab}" ToolTip.Tip="{l:T accounts.tab.external}">
              <TextBlock Text="{l:T accounts.tab.external}" TextTrimming="CharacterEllipsis" />
            </RadioButton>
          </UniformGrid>

          <StackPanel Spacing="10" IsVisible="{Binding IsOfflineTab}">
            <TextBox x:Name="OfflineNameBox" Text="{Binding OfflineName}" PlaceholderText="{l:T accounts.offline.name_placeholder}" MaxLength="16" c:EnterSubmit.Command="{Binding AddOfflineCommand}" />
            <Button Classes="primary" Content="{l:T accounts.offline.add}" Command="{Binding AddOfflineCommand}" />
            <TextBlock Classes="hint" Text="{l:T accounts.offline.hint}" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Spacing="10" IsVisible="{Binding IsMicrosoftTab}">
            <Button x:Name="MicrosoftLoginButton" Classes="primary" Content="{l:T accounts.microsoft.login}" Command="{Binding LoginMicrosoftCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="16,10" IsVisible="{Binding !HasDeviceCode}" />

            <!-- 设备码：已自动复制并打开网页；旁边【复制代码】、倒计时；过期后留着给【重新获取代码】。 -->
            <Border IsVisible="{Binding HasDeviceCode}" Background="{DynamicResource PageBg}" CornerRadius="8" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding CodeCopiedText}" TextWrapping="Wrap" IsVisible="{Binding CodeActive}" />
                <SelectableTextBlock x:Name="DeviceCodeText" Text="{Binding DeviceCode}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AccentText}"
                                     AutomationProperties.Name="{l:T accounts.microsoft.code_name}" />
                <SelectableTextBlock Text="{Binding DeviceUri}" Classes="hint" TextWrapping="Wrap" />
                <TextBlock x:Name="CountdownText" Classes="hint" Text="{Binding CountdownText}" IsVisible="{Binding CodeActive}" />
                <TextBlock Text="{l:T accounts.microsoft.expired}" Foreground="{DynamicResource WarningText}" TextWrapping="Wrap" IsVisible="{Binding CodeExpired}" />
                <WrapPanel ItemSpacing="8" LineSpacing="8">
                  <Button x:Name="CopyCodeButton" Content="{Binding CopyCodeLabel}" Command="{Binding CopyCodeCommand}" IsVisible="{Binding CodeActive}" />
                  <Button Content="{l:T accounts.microsoft.open_browser}" Command="{Binding OpenDeviceUriCommand}" IsVisible="{Binding CodeActive}" />
                  <Button x:Name="RenewCodeButton" Classes="primary" Content="{l:T accounts.microsoft.renew}" Command="{Binding LoginMicrosoftCommand}" IsVisible="{Binding CodeExpired}" />
                  <Button Content="{l:T common.cancel}" Command="{Binding CancelLoginCommand}" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <!-- 失败：原因 + 按种类给的按钮（改版规格 3.5 失败状态表）。 -->
            <Border x:Name="LoginFailureCard" Classes="callout warning" IsVisible="{Binding HasLoginFailure}">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding LoginFailure}" TextWrapping="Wrap" />
                <ItemsControl x:Name="LoginActionList" ItemsSource="{Binding LoginActions}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel ItemSpacing="8" LineSpacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:LoginAction">
                      <Button Content="{Binding Label}" Command="{Binding #LoginActionList.((vm:AccountsViewModel)DataContext).RunLoginActionCommand}" CommandParameter="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="callout info" IsVisible="{Binding HasLoginSuccess}">
              <TextBlock x:Name="LoginSuccessText" Text="{Binding LoginSuccess}" TextWrapping="Wrap" />
            </Border>

            <!-- Client ID 一般不用填，收进默认折叠的“高级”。 -->
            <Expander x:Name="MicrosoftAdvanced" HorizontalAlignment="Stretch">
              <Expander.Header><TextBlock Text="{l:T accounts.microsoft.advanced}" TextWrapping="Wrap" /></Expander.Header>
              <StackPanel Spacing="8">
                <TextBlock Text="{l:T accounts.microsoft.client_id_label}" TextWrapping="Wrap" />
                <TextBox Text="{Binding ClientIdInput}" PlaceholderText="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" />
                <TextBlock Classes="hint" Text="{l:T accounts.microsoft.client_id_hint}" TextWrapping="Wrap" />
              </StackPanel>
            </Expander>
          </StackPanel>

          <StackPanel Spacing="10" IsVisible="{Binding IsExternalTab}">
            <TextBox Text="{Binding ServerUrl}" PlaceholderText="{l:T accounts.external.server_placeholder}" />
            <TextBox Text="{Binding ExternalUser}" PlaceholderText="{l:T accounts.external.user_placeholder}" />
            <TextBox Text="{Binding ExternalPassword}" PasswordChar="●" PlaceholderText="{l:T accounts.external.password_placeholder}" c:EnterSubmit.Command="{Binding LoginExternalCommand}" />
            <Button Classes="primary" Content="{l:T accounts.external.login}" Command="{Binding LoginExternalCommand}" />
            <StackPanel Spacing="8" IsVisible="{Binding NeedsProfileChoice}">
              <TextBlock Text="{l:T accounts.external.choose_profile}" />
              <ComboBox ItemsSource="{Binding ExternalProfiles}" SelectedItem="{Binding SelectedProfile}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="auth:ExternalProfile">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Content="{l:T common.confirm}" Command="{Binding ConfirmProfileCommand}" />
            </StackPanel>
            <TextBlock Classes="hint" Text="{l:T accounts.external.hint}" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border svc:ThemeRegion.Name="me.status" Grid.Row="2" Grid.ColumnSpan="2" Classes="card" Margin="0">
      <Border.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.Or}">
          <Binding Path="IsShowing" ElementName="PageStatus" />
          <Binding Path="IsBusy" />
        </MultiBinding>
      </Border.IsVisible>
      <StackPanel Spacing="6">
        <c:StatusBar x:Name="PageStatus" Message="{Binding StatusInfo}" />
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
