<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Amber.App.ViewModels"
             xmlns:c="using:Amber.App.Views.Controls"
             xmlns:l="using:Amber.App.Localization"
             xmlns:auth="using:Amber.Core.Auth"
             x:Class="Amber.App.Views.AccountsPage"
             x:DataType="vm:AccountsViewModel">
  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,Auto">
    <TextBlock Classes="h1" Text="{l:T accounts.title}" Grid.ColumnSpan="2" />

    <Border Grid.Row="1" Classes="card" Padding="8">
      <!-- 皮肤预览放在列表左边一块固定大小的区域里，不再挤在下面留一大块空白 -->
      <Grid ColumnDefinitions="Auto,*">
        <Border Width="104" Margin="4,4,10,4" VerticalAlignment="Top" IsVisible="{Binding Current.Body, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Image Source="{Binding Current.Body}" Width="96" Height="192" Stretch="Uniform"
                 RenderOptions.BitmapInterpolationMode="None" ToolTip.Tip="{l:T accounts.skin.tooltip}" />
        </Border>
        <ListBox Grid.Column="1" ItemsSource="{Binding Accounts}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:AccountItem">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="4">
                <Border Width="40" Height="40" CornerRadius="6" Background="{DynamicResource Accent}" ClipToBounds="True">
                  <Panel>
                    <TextBlock Text="{Binding Initial}" IsVisible="{Binding HasNoAvatar}" Foreground="{DynamicResource OnAccent}" FontWeight="Bold" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding Head}" RenderOptions.BitmapInterpolationMode="None" />
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                    <TextBlock Text="{l:T accounts.current.label}" IsVisible="{Binding IsCurrent}" Foreground="{DynamicResource AccentText}" />
                  </StackPanel>
                  <TextBlock Text="{Binding KindText}" Classes="hint" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding KindText}" />
                  <TextBlock Text="{l:T accounts.external.insecure_saved}" IsVisible="{Binding InsecureServer}" Foreground="{DynamicResource AmberAccent}"
                             FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Button Content="{l:T common.use}" IsVisible="{Binding !IsCurrent}" Command="{Binding $parent[ListBox].((vm:AccountsViewModel)DataContext).UseCommand}" CommandParameter="{Binding}" />
                  <c:ConfirmButton Content="{l:T common.remove}" ConfirmText="{l:T common.confirm_remove}" ObjectName="{Binding Name}" Command="{Binding $parent[ListBox].((vm:AccountsViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="1" Classes="card" Margin="14,0,0,14" Width="320" MinWidth="240">
      <ScrollViewer>
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="{l:T accounts.add.title}" Margin="0" />
          <ComboBox ItemsSource="{Binding LoginKinds}" SelectedIndex="{Binding LoginTab}" HorizontalAlignment="Stretch" />

          <StackPanel Spacing="10" IsVisible="{Binding IsOfflineTab}">
            <TextBox Text="{Binding OfflineName}" PlaceholderText="{l:T accounts.offline.name_placeholder}" MaxLength="16" />
            <Button Classes="primary" Content="{l:T accounts.offline.add}" Command="{Binding AddOfflineCommand}" />
            <TextBlock Classes="hint" Text="{l:T accounts.offline.hint}" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Spacing="10" IsVisible="{Binding IsMicrosoftTab}">
            <TextBlock Text="{l:T accounts.microsoft.client_id_label}" TextWrapping="Wrap" />
            <TextBox Text="{Binding ClientIdInput}" PlaceholderText="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" />
            <TextBlock Classes="hint"
                       Text="{l:T accounts.microsoft.client_id_hint}" />
            <Button Classes="primary" Content="{l:T accounts.microsoft.login}" Command="{Binding LoginMicrosoftCommand}" />
            <Border IsVisible="{Binding HasDeviceCode}" Background="{DynamicResource PageBg}" CornerRadius="8" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock Text="{l:T accounts.microsoft.device_code_hint}" />
                <SelectableTextBlock Text="{Binding DeviceCode}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AccentText}" />
                <SelectableTextBlock Text="{Binding DeviceUri}" Classes="hint" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{l:T accounts.microsoft.open_browser}" Command="{Binding OpenDeviceUriCommand}" />
                  <Button Content="{l:T common.cancel}" Command="{Binding CancelLoginCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Spacing="10" IsVisible="{Binding IsExternalTab}">
            <TextBox Text="{Binding ServerUrl}" PlaceholderText="{l:T accounts.external.server_placeholder}" />
            <TextBox Text="{Binding ExternalUser}" PlaceholderText="{l:T accounts.external.user_placeholder}" />
            <TextBox Text="{Binding ExternalPassword}" PasswordChar="●" PlaceholderText="{l:T accounts.external.password_placeholder}" />
            <Button Classes="primary" Content="{l:T accounts.external.login}" Command="{Binding LoginExternalCommand}" />
            <StackPanel Spacing="8" IsVisible="{Binding NeedsProfileChoice}">
              <TextBlock Text="{l:T accounts.external.choose_profile}" />
              <ComboBox ItemsSource="{Binding ExternalProfiles}" SelectedItem="{Binding SelectedProfile}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="auth:ExternalProfile">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Content="{l:T common.confirm}" Command="{Binding ConfirmProfileCommand}" />
            </StackPanel>
            <TextBlock Classes="hint" Text="{l:T accounts.external.hint}" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="2" Grid.ColumnSpan="2" Classes="card" Margin="0">
      <Border.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.Or}">
          <Binding Path="IsShowing" ElementName="PageStatus" />
          <Binding Path="IsBusy" />
        </MultiBinding>
      </Border.IsVisible>
      <StackPanel Spacing="6">
        <c:StatusBar x:Name="PageStatus" Message="{Binding StatusInfo}" />
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
