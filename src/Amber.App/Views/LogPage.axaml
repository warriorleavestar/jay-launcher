<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="using:Amber.App.Services"
             xmlns:l="using:Amber.App.Localization"
             xmlns:vm="using:Amber.App.ViewModels"
             x:Class="Amber.App.Views.LogPage"
             x:DataType="vm:LogViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.log-level, SelectableTextBlock.log-message">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="TextBlock.log-level.muted, SelectableTextBlock.log-message.muted">
      <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
    </Style>
    <Style Selector="TextBlock.log-level.warning, SelectableTextBlock.log-message.warning">
      <Setter Property="Foreground" Value="{DynamicResource WarningText}" />
    </Style>
    <Style Selector="TextBlock.log-level.error, SelectableTextBlock.log-message.error">
      <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
    </Style>
    <Style Selector="Button.chip">
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
      <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="2" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <StackPanel svc:ThemeRegion.Name="log.header">
      <TextBlock Classes="h1" Text="{l:T log.heading}" Margin="0,0,0,2" />
      <TextBlock Classes="caption" Text="{Binding RunSummary}" IsVisible="{Binding HasRun}" TextWrapping="Wrap" Margin="0,0,0,10" />
      <!-- 多开时选看哪一次启动的日志。 -->
      <ComboBox x:Name="RunPicker" ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" IsVisible="{Binding HasSeveralRuns}"
                MinWidth="240" MaxWidth="480" Margin="0,0,0,10" AutomationProperties.Name="{l:T log.pick_run}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:RunLog">
            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>
    <!-- 计数芯片也是按钮：点一次跳到下一个错误 / 警告，到末尾回到第一个。 -->
    <WrapPanel svc:ThemeRegion.Name="log.jump" Grid.Row="1" Margin="0,0,0,8" ItemSpacing="8" LineSpacing="6">
      <Button x:Name="ErrorChip" Classes="ghost chip" Background="{DynamicResource DangerTint}"
              Command="{Binding NextErrorCommand}" IsEnabled="{Binding HasErrors}"
              ToolTip.Tip="{l:T log.next_error}" AutomationProperties.HelpText="{l:T log.next_error}">
        <TextBlock x:Name="ErrorSummary" Text="{Binding ErrorSummary}" Foreground="{DynamicResource DangerText}" TextWrapping="Wrap" />
      </Button>
      <Button x:Name="WarningChip" Classes="ghost chip" Background="{DynamicResource WarningTint}"
              Command="{Binding NextWarningCommand}" IsEnabled="{Binding HasWarnings}"
              ToolTip.Tip="{l:T log.next_warning}" AutomationProperties.HelpText="{l:T log.next_warning}">
        <TextBlock x:Name="WarningSummary" Text="{Binding WarningSummary}" Foreground="{DynamicResource WarningText}" TextWrapping="Wrap" />
      </Button>
    </WrapPanel>
    <WrapPanel svc:ThemeRegion.Name="log.filters" Grid.Row="2" Margin="0,0,0,8" ItemSpacing="12" LineSpacing="6">
      <CheckBox x:Name="ProblemsFilter" IsChecked="{Binding OnlyProblems}">
        <TextBlock Text="{l:T log.filter.problems}" TextWrapping="Wrap" />
      </CheckBox>
      <CheckBox x:Name="FollowLatest" IsChecked="{Binding FollowLatest}">
        <TextBlock Text="{l:T log.follow_latest}" TextWrapping="Wrap" />
      </CheckBox>
      <Button Classes="primary" Command="{Binding CopyCommand}">
        <TextBlock Text="{Binding CopyLabel}" TextWrapping="Wrap" />
      </Button>
    </WrapPanel>
    <Border svc:ThemeRegion.Name="log.list" Grid.Row="3" Classes="card" Padding="8" Margin="0">
      <Panel>
        <TextBlock Classes="hint" Text="{Binding EmptyMessage}" IsVisible="{Binding !Lines.Count}"
                   Margin="12" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <ListBox x:Name="List" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" Background="Transparent"
                 FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FontCaption}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:LogEntry">
              <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                <TextBlock Text="{Binding Time}" Foreground="{DynamicResource TextTertiary}" LineHeight="18" />
                <TextBlock Grid.Column="1" Text="{Binding Level}" Classes="log-level" LineHeight="18"
                           Classes.error="{Binding IsError}" Classes.warning="{Binding IsWarning}" Classes.muted="{Binding IsMuted}" />
                <SelectableTextBlock Grid.Column="2" Text="{Binding Message}" Classes="log-message" TextWrapping="Wrap" LineHeight="18"
                                     Classes.error="{Binding IsError}" Classes.warning="{Binding IsWarning}" Classes.muted="{Binding IsMuted}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Panel>
    </Border>
  </Grid>
</UserControl>
