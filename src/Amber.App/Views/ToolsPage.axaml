<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="using:Amber.App.Services"
             xmlns:l="using:Amber.App.Localization"
             xmlns:vm="using:Amber.App.ViewModels"
             xmlns:c="using:Amber.App.Views.Controls"
             x:Class="Amber.App.Views.ToolsPage"
             x:DataType="vm:ToolsViewModel">
  <Grid RowDefinitions="Auto,*,Auto">
    <TextBlock svc:ThemeRegion.Name="tools.title" Classes="h1" Text="{l:T tools.title}" />
    <ScrollViewer svc:ThemeRegion.Name="tools.body" Grid.Row="1">
      <StackPanel>
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="{l:T tools.junk.title}" Margin="0" />
            <TextBlock Classes="hint" Text="{Binding JunkStatus}" />
            <ItemsControl ItemsSource="{Binding Junk}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:JunkItem">
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                    <CheckBox IsChecked="{Binding Selected}" Content="{Binding Name}" />
                    <TextBlock Grid.Column="1" Classes="hint" FontSize="12" Text="{Binding Description}" VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Description}" />
                    <TextBlock Grid.Column="2" Text="{Binding Size}" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{l:T tools.junk.scan}" Command="{Binding ScanJunkCommand}" />
              <Button Classes="primary" Content="{l:T tools.junk.clean}" Command="{Binding CleanJunkCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="{l:T tools.download.title}" Margin="0" />
            <TextBox Text="{Binding DownloadUrl}" PlaceholderText="{l:T tools.download.url_hint}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding DownloadFolder}" PlaceholderText="{l:T tools.download.folder_hint}" />
              <Button Grid.Column="1" Content="{l:T common.browse}" Margin="8,0,0,0" Click="BrowseFolder_Click" />
            </Grid>
            <TextBox Text="{Binding DownloadSha1}" PlaceholderText="{l:T tools.download.sha1_hint}" />
            <Button Classes="primary" Content="{l:T tools.download.start}" Command="{Binding DownloadFileCommand}" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="{l:T tools.java.title}" Margin="0" />
            <TextBlock Classes="hint" Text="{l:T tools.java.hint}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ComboBox ItemsSource="{Binding JavaMajors}" SelectedItem="{Binding SelectedJavaMajor}" MinWidth="90" />
              <Button Content="{l:T download.title}" Command="{Binding InstallJavaCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="{l:T common.check_updates}" Margin="0" />
            <TextBlock Classes="hint" Text="{l:T tools.update.hint}" />
            <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{l:T tools.update.check}" Command="{Binding CheckUpdateCommand}" />
              <Button Content="{l:T tools.update.open_page}" Command="{Binding OpenUpdateUrlCommand}" IsVisible="{Binding UpdateUrl, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border svc:ThemeRegion.Name="tools.status" Grid.Row="2" Classes="card" Margin="0">
      <Border.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.Or}">
          <Binding Path="IsShowing" ElementName="PageStatus" />
          <Binding Path="IsBusy" />
        </MultiBinding>
      </Border.IsVisible>
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="6" VerticalAlignment="Center">
          <c:StatusBar x:Name="PageStatus" Message="{Binding StatusInfo}" />
          <ProgressBar Value="{Binding Progress}" Maximum="100" IsVisible="{Binding IsBusy}" />
        </StackPanel>
        <Button Grid.Column="1" Content="{l:T common.cancel}" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" Margin="12,0,0,0" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
