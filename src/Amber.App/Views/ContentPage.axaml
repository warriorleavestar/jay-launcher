<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="using:Amber.App.Services"
             xmlns:l="using:Amber.App.Localization"
             xmlns:vm="using:Amber.App.ViewModels"
             xmlns:c="using:Amber.App.Views.Controls"
             x:Class="Amber.App.Views.ContentPage"
             x:DataType="vm:ContentViewModel">
  <!-- Short windows scroll the whole page with a fixed-height result list (the bars stay reachable); otherwise the
       list takes the room that is left. -->
  <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
  <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,*,Auto,Auto">
    <!-- Title, type chips (a drop-down when compact), source segment: official design §6.12. -->
    <Grid x:Name="HeaderGrid" svc:ThemeRegion.Name="content.header" ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,6">
      <TextBlock x:Name="ContentTitle" Classes="h1" Text="{l:T content.title}" Margin="0,0,16,0" VerticalAlignment="Center" />
      <ListBox x:Name="TypeChips" Grid.Column="1" Classes="subtabs" ItemsSource="{Binding TypeNames}" SelectedIndex="{Binding TypeIndex}" Background="Transparent"
               VerticalAlignment="Center" AutomationProperties.Name="{l:T content.type.label}">
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="4" LineSpacing="4" /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="l:OptionItem"><TextBlock Text="{Binding Label}" /></DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <ComboBox x:Name="TypeCombo" Grid.Column="1" ItemsSource="{Binding TypeNames}" SelectedIndex="{Binding TypeIndex}" MinWidth="110" IsVisible="False"
                VerticalAlignment="Center" AutomationProperties.Name="{l:T content.type.label}" />
      <!-- CurseForge stays selectable without a key: the list area then explains how to get one. -->
      <ListBox x:Name="SourceChips" Grid.Column="2" Classes="subtabs" ItemsSource="{Binding SourceOptions}" SelectedIndex="{Binding SourceIndex}" Background="Transparent"
               VerticalAlignment="Center" Margin="8,0" AutomationProperties.Name="{l:T content.source.label}">
        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:SourceOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Button x:Name="ImportPackButton" Grid.Column="3" Classes="ghost" Content="{l:T content.modpack.import}" Click="ImportPack_Click" VerticalAlignment="Center" />
    </Grid>

    <StackPanel svc:ThemeRegion.Name="content.filters" x:Name="ContentFilters" Grid.Row="1" Spacing="8" Margin="0,0,0,10">
      <!-- Context mode (from an instance's "add mods"): where you came from and [Done, go back]. -->
      <Border x:Name="Breadcrumb" Classes="callout info" IsVisible="{Binding HasReturn}">
        <DockPanel>
          <Button x:Name="DoneReturnButton" DockPanel.Dock="Right" Classes="secondary" Content="{l:T content.context.done}" Command="{Binding ReturnCommand}" VerticalAlignment="Center" Margin="8,0,0,0" />
          <TextBlock Text="{Binding ReturnContext}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
      <!-- 先占用可用宽度再限宽，避免左对齐时搜索框缩到占位文字大小。 -->
      <Grid x:Name="SearchToolbar" ColumnDefinitions="*,Auto" Width="{Binding #ContentFilters.Bounds.Width}" MaxWidth="720" HorizontalAlignment="Left">
        <TextBox x:Name="SearchInput" Text="{Binding Query}" PlaceholderText="{l:T common.search_placeholder}" Margin="0,0,8,0" KeyDown="Query_KeyDown" />
        <Button Grid.Column="1" Classes="secondary" Content="{l:T common.search}" Command="{Binding SearchCommand}" Padding="20,6" />
      </Grid>
      <WrapPanel ItemSpacing="10" LineSpacing="4" IsVisible="{Binding !IsModpack}">
        <TextBlock Text="{l:T content.install.target}" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding Instances}" SelectedItem="{Binding TargetInstance}" MinWidth="260" />
        <Border IsVisible="{Binding IsSharedTarget}" Background="{DynamicResource AccentTint}" CornerRadius="{DynamicResource RadiusPill}" Padding="8,2" VerticalAlignment="Center"
                ToolTip.Tip="{l:T content.install.shared_hint}">
          <TextBlock Text="{l:T content.install.shared}" Foreground="{DynamicResource AccentText}" FontSize="{DynamicResource FontCaption}" />
        </Border>
        <CheckBox Content="{l:T content.search.filter_by_instance}" IsChecked="{Binding FilterByInstance}" />
      </WrapPanel>
      <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsDatapack}">
        <TextBlock Text="{l:T content.install.world}" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding Worlds}" SelectedItem="{Binding TargetWorld}" MinWidth="260" PlaceholderText="{l:T content.world.empty}">
          <ComboBox.ItemTemplate>
            <DataTemplate DataType="vm:WorldChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
    </StackPanel>

    <Grid svc:ThemeRegion.Name="content.body" x:Name="BodyGrid" Grid.Row="2" ColumnDefinitions="*,Auto">
      <Border Classes="card" Padding="6">
        <Grid RowDefinitions="*,Auto">
          <TextBlock Classes="hint" Text="{l:T content.search.empty_hint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding IsIdle}" />
          <!-- 三种状态（改版规格 4.5）：加载中（超过 10 秒补一句并给【切换来源】）、空结果（一键取消过滤）、出错（【重试】）。 -->
          <StackPanel x:Name="SearchingState" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" IsVisible="{Binding IsSearching}">
            <ProgressBar IsIndeterminate="True" Width="180" HorizontalAlignment="Center" />
            <TextBlock Classes="hint" Text="{Binding SearchingText}" TextAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Spacing="6" IsVisible="{Binding IsSlow}">
              <TextBlock Text="{Binding SlowText}" TextAlignment="Center" TextWrapping="Wrap" />
              <Button HorizontalAlignment="Center" Content="{l:T content.search.switch_source}" Command="{Binding SwitchSourceCommand}" IsVisible="{Binding CanSwitchSource}" />
            </StackPanel>
          </StackPanel>
          <StackPanel x:Name="EmptyState" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" IsVisible="{Binding IsEmptyResult}">
            <TextBlock Text="{Binding EmptyText}" TextAlignment="Center" TextWrapping="Wrap" />
            <Button x:Name="ShowAllVersionsButton" HorizontalAlignment="Center" Content="{l:T content.search.show_all}" Command="{Binding ShowAllVersionsCommand}" IsVisible="{Binding CanShowAllVersions}" />
          </StackPanel>
          <StackPanel x:Name="ErrorState" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" IsVisible="{Binding IsSearchError}">
            <TextBlock Text="{Binding SearchError}" Foreground="{DynamicResource DangerText}" TextAlignment="Center" TextWrapping="Wrap" />
            <WrapPanel HorizontalAlignment="Center" ItemSpacing="8">
              <Button x:Name="RetrySearchButton" Classes="primary" Content="{l:T common.retry}" Command="{Binding SearchCommand}" />
              <Button Content="{l:T content.search.switch_source}" Command="{Binding SwitchSourceCommand}" IsVisible="{Binding CanSwitchSource}" />
            </WrapPanel>
          </StackPanel>
          <StackPanel x:Name="KeyState" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" IsVisible="{Binding NeedsCurseForgeKey}">
            <TextBlock Text="{l:T content.source.needs_key}" TextAlignment="Center" TextWrapping="Wrap" />
            <WrapPanel HorizontalAlignment="Center" ItemSpacing="8">
              <Button x:Name="ConfigureCurseForgeButton" Classes="primary" Content="{l:T content.source.go_fill}" Command="{Binding GoToCurseForgeKeyCommand}" />
              <Button x:Name="UseModrinthButton" Content="{l:T content.source.use_modrinth}" Command="{Binding UseModrinthCommand}" />
            </WrapPanel>
          </StackPanel>
          <!-- 空列表仍会接走鼠标点击；没有结果时隐藏，让下层状态卡按钮可用。 -->
          <ListBox x:Name="ResultsList" IsVisible="{Binding !!Results.Count}" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:ProjectItem">
                <Grid ColumnDefinitions="48,*,Auto" Margin="2">
                  <Border Width="48" Height="48" CornerRadius="6" Background="{DynamicResource PageBg}" ClipToBounds="True" VerticalAlignment="Top">
                    <Image Source="{Binding Icon}" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                    <TextBlock x:Name="ProjectSummary" Text="{Binding Summary}" Classes="hint" MaxWidth="640" HorizontalAlignment="Left" MaxLines="2" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Summary}" />
                    <TextBlock Text="{Binding Meta}" Classes="caption" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Meta}" />
                  </StackPanel>
                  <Button Grid.Column="2" Classes="secondary small" Content="{Binding QueueLabel}" Classes.queued="{Binding Queued}" VerticalAlignment="Center" Margin="10,0,0,0"
                          Command="{Binding $parent[ListBox].((vm:ContentViewModel)DataContext).ToggleQueueCommand}" CommandParameter="{Binding}"
                          IsVisible="{Binding !$parent[ListBox].((vm:ContentViewModel)DataContext).IsModpack}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,6,0,2" IsVisible="{Binding !!Results.Count}">
            <Button Content="{l:T common.previous_page}" Command="{Binding PreviousPageCommand}" />
            <Button Content="{l:T common.next_page}" Command="{Binding NextPageCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Detail: a 400 column when wide, a drawer over the list on medium, the whole area when compact (code-behind). -->
      <Border x:Name="DetailPane" Grid.Column="1" Classes="card" Width="400" Margin="14,0,0,0" IsVisible="{Binding HasSelection}">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
              <TextBlock Classes="h2" Text="{Binding Detail.Title}" Margin="0" TextWrapping="Wrap" />
              <Button Classes="ghost" Content="{l:T content.project.open_page}" Command="{Binding OpenPageCommand}" Padding="8,3" FontSize="12" />
            </StackPanel>
            <Button x:Name="CloseDetailButton" Grid.Column="1" Classes="ghost" Content="✕" VerticalAlignment="Top" Command="{Binding CloseDetailCommand}"
                    ToolTip.Tip="{l:T common.close}" AutomationProperties.Name="{l:T common.close}" />
          </Grid>
          <CheckBox Grid.Row="1" Content="{l:T common.show_unstable}" IsChecked="{Binding ShowUnstable}" Margin="0,6" />
          <ListBox Grid.Row="2" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:FileItem">
                <StackPanel>
                  <c:MiddleEllipsisTextBlock FullText="{Binding Name}" FontSize="13" />
                  <TextBlock Text="{Binding Meta}" Classes="caption" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Meta}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="3" Spacing="8" Margin="0,8,0,0">
            <StackPanel Spacing="4" IsVisible="{Binding IsModpack}">
              <TextBlock Text="{l:T content.modpack.instance_name}" />
              <TextBox Text="{Binding NewInstanceName}" />
            </StackPanel>
            <!-- 可选依赖（#22）：默认不勾，勾上的和主文件一起装。 -->
            <StackPanel Spacing="2" IsVisible="{Binding HasOptionalDependencies}">
              <TextBlock Text="{l:T content.install.optional_heading}" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding OptionalDependencies}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:OptionalDependencyItem">
                    <CheckBox IsChecked="{Binding Include}">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <Border Classes="callout warning" IsVisible="{Binding HasLoaderNote}">
              <TextBlock Text="{Binding LoaderNote}" TextWrapping="Wrap" />
            </Border>
            <!-- 光影要 Iris / Oculus / OptiFine 才生效（旧规格 N3）：原版实例拦下；缺 Iris 时默认一并安装 -->
            <Border x:Name="ShaderNoteBox" Classes="callout warning" IsVisible="{Binding HasShaderNote}">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding ShaderNote}" TextWrapping="Wrap" />
                <CheckBox x:Name="AlsoInstallRendererBox" IsChecked="{Binding AlsoInstallRenderer}" IsVisible="{Binding CanInstallRenderer}">
                  <TextBlock Text="{Binding AlsoInstallRendererLabel}" TextWrapping="Wrap" />
                </CheckBox>
              </StackPanel>
            </Border>
            <!-- Mods, packs, shaders, datapacks: [+ Queue] (blue) or [Install now]. -->
            <WrapPanel ItemSpacing="8" LineSpacing="8" IsVisible="{Binding !IsModpack}">
              <Button x:Name="QueueSelectedButton" Classes="primary" Content="{l:T content.queue.add_selected}" Command="{Binding QueueSelectedCommand}" IsVisible="{Binding !SelectedRequiresManualDownload}" />
              <Button x:Name="InstallNowButton" Content="{l:T content.install.now}" Command="{Binding InstallCommand}" IsVisible="{Binding !SelectedRequiresManualDownload}"
                      ToolTip.Tip="{Binding InstallHint}" ToolTip.ShowOnDisabled="True" />
            </WrapPanel>
            <!-- Modpacks: [Install and play] is the one amber button on this screen. -->
            <WrapPanel ItemSpacing="8" LineSpacing="8" IsVisible="{Binding IsModpack}">
              <Button x:Name="InstallPlayButton" Classes="play" Content="{l:T content.modpack.install_play}" Command="{Binding InstallModpackAndPlayCommand}" IsVisible="{Binding !SelectedRequiresManualDownload}" />
              <Button x:Name="InstallOnlyButton" Content="{l:T content.modpack.install_only}" Command="{Binding InstallCommand}" IsVisible="{Binding !SelectedRequiresManualDownload}" />
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- "To install" bar: everything queued goes in as one task (Ctrl+Enter). -->
    <Border x:Name="QueueBar" Grid.Row="3" Classes="card" Margin="0,10,0,0" Padding="12,8" IsVisible="{Binding HasQueue}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding QueueText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding QueueText}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
          <Button Classes="ghost" Content="{l:T content.queue.clear}" Command="{Binding ClearQueueCommand}" />
          <Button x:Name="InstallQueueButton" Classes="primary" Content="{Binding InstallQueueLabel}" Command="{Binding InstallQueueCommand}" HotKey="Ctrl+Enter" />
        </StackPanel>
      </Grid>
    </Border>

    <Border svc:ThemeRegion.Name="content.status" Grid.Row="4" Classes="card" Margin="0,10,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="6" VerticalAlignment="Center">
          <c:StatusBar Message="{Binding StatusInfo}" />
          <StackPanel Spacing="6" IsVisible="{Binding HasManualDownload}" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="{Binding ManualDownloadHint}" TextWrapping="Wrap" />
            <Button Content="{l:T content.curseforge.open_manual}" Command="{Binding OpenManualDownloadCommand}" />
          </StackPanel>
          <ProgressBar Value="{Binding Progress}" Maximum="100" IsVisible="{Binding IsBusy}" />
        </StackPanel>
        <Button Grid.Column="1" Content="{l:T common.cancel}" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" Margin="12,0,0,0" />
      </Grid>
    </Border>
  </Grid>
  </ScrollViewer>
</UserControl>
