<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="using:Amber.App.Services"
             xmlns:vm="using:Amber.App.ViewModels"
             xmlns:v="using:Amber.App.Views"
             xmlns:c="using:Amber.App.Views.Controls"
             xmlns:safety="using:Amber.App.Controls.Safety"
             xmlns:l="using:Amber.App.Localization"
             x:Class="Amber.App.Views.PeoplePage"
             x:DataType="vm:PeopleViewModel">
  <!-- People on the left, the conversation with the selected one on the right. Below 640 the list comes first and
       picking someone replaces it (a back button returns). Which card shows is decided by classes on the cards
       themselves (haslist, picked), so it keeps working when a theme pack moves the regions around. Properties the
       width changes are set in styles (a value on the control would win). -->
  <UserControl.Styles>
    <Style Selector="Border#FriendListCard">
      <Setter Property="Grid.Row" Value="2" />
      <Setter Property="Width" Value="280" />
      <Setter Property="Margin" Value="0,0,14,0" />
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border#FriendListCard.haslist">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Border#FriendDetailCard">
      <Setter Property="Grid.Row" Value="2" />
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Button.narrow-only, TextBlock.narrow-only">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- A line of the conversation: mine on the right, theirs on the left, what happened in the middle. -->
    <Style Selector="Border.bubble">
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="MaxWidth" Value="420" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Background" Value="{DynamicResource Sunken}" />
    </Style>
    <Style Selector="Panel.line-file > c|FileCard">
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Panel.line-file.mine > c|FileCard">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Border.bubble.mine">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Background" Value="{DynamicResource AccentTint}" />
    </Style>
    <ContainerQuery Name="PeoplePageRoot" Query="max-width:640">
      <Style Selector="TextBlock#PeopleTitle">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="Border#FriendListCard">
        <Setter Property="Grid.ColumnSpan" Value="2" />
        <Setter Property="Width" Value="NaN" />
        <Setter Property="Margin" Value="0" />
      </Style>
      <Style Selector="Border#FriendListCard.haslist.picked">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="Border#FriendDetailCard">
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
      </Style>
      <Style Selector="Border#FriendDetailCard.haslist:not(.picked)">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="Button.narrow-only, TextBlock.narrow-only">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="TextBlock.wide-only">
        <Setter Property="IsVisible" Value="False" />
      </Style>
    </ContainerQuery>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="Auto,*" Container.Name="PeoplePageRoot" Container.Sizing="Width">
    <TextBlock svc:ThemeRegion.Name="people.title" x:Name="PeopleTitle" Grid.ColumnSpan="2" Classes="h1" Text="{l:T shell.nav.people}" TextTrimming="CharacterEllipsis" />

    <!-- Which network delivers to friends (handled in place), add a friend, backup. Under it, the add panel. -->
    <StackPanel svc:ThemeRegion.Name="people.status" x:Name="PeopleStatusCard" Grid.Row="1" Grid.ColumnSpan="2" Spacing="10" Margin="0,0,0,12"
                IsVisible="{Binding ShowTopRow}">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
        <Border x:Name="DeliveryChip" Classes="chip" Classes.ok="{Binding CanDeliver}" HorizontalAlignment="Left" VerticalAlignment="Center"
                ToolTip.Tip="{Binding DeliveryText}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
            <Border Classes="led" Classes.online="{Binding CanDeliver}" Classes.off="{Binding !CanDeliver}" />
            <TextBlock x:Name="DeliveryText" Grid.Column="1" Text="{Binding DeliveryText}" TextTrimming="CharacterEllipsis" />
          </Grid>
        </Border>
        <Button x:Name="ConnectNetworkButton" Grid.Column="1" Classes="small" Content="{l:T people.delivery.connect}" Command="{Binding ConnectCommand}"
                IsVisible="{Binding ShowConnect}" VerticalAlignment="Center" />
        <Button x:Name="AddFriendButton" Grid.Column="2" Classes="primary" Command="{Binding OpenAddCommand}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Classes="icon sm" Data="{StaticResource Icon.UserPlus}" />
            <TextBlock Text="{l:T people.add}" />
          </StackPanel>
        </Button>
        <Button x:Name="PeopleMoreButton" Grid.Column="3" Classes="ghost icon-only" ToolTip.Tip="{l:T people.more}" AutomationProperties.Name="{l:T people.more}"
                VerticalAlignment="Center">
          <Path Classes="icon" Data="{StaticResource Icon.More}" Width="16" Height="16" />
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <!-- The friend list backup is locked with the Jay account: restore it on a new computer and friends reconnect. -->
              <StackPanel x:Name="PeopleMoreMenu" Spacing="8" MaxWidth="320">
                <Button x:Name="BackupFriendsButton" Content="{l:T multiplayer.friends.backup}" Command="{Binding BackupCommand}" HorizontalAlignment="Stretch" />
                <Button x:Name="RestoreFriendsButton" Content="{l:T multiplayer.friends.restore}" Command="{Binding RestoreCommand}" HorizontalAlignment="Stretch" />
                <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.friends.backup_hint}" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </Grid>

      <Grid x:Name="RequestsLine" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding ShowRequestsLine}">
        <TextBlock x:Name="RequestsText" Text="{Binding RequestsText}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button x:Name="OpenRequestsButton" Grid.Column="1" Classes="small" Content="{l:T people.requests.open}" Command="{Binding OpenAddCommand}"
                VerticalAlignment="Center" />
      </Grid>

      <!-- Add a friend, the one way there is: send my code or paste theirs, then compare four emoji. -->
      <!-- In a short window the panel is as tall as the page allows and its content scrolls (the header with × stays). -->
      <Border x:Name="AddFriendCard" Classes="card" Margin="0" IsVisible="{Binding ShowAddPanel}">
        <Grid RowDefinitions="Auto,*" RowSpacing="10">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Path Classes="icon" Data="{StaticResource Icon.UserPlus}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="h2" Margin="0" Text="{l:T people.add}" VerticalAlignment="Center" />
            <Button x:Name="CloseAddButton" Grid.Column="2" Classes="ghost icon-only" Command="{Binding CloseAddCommand}" ToolTip.Tip="{l:T common.close}"
                    AutomationProperties.Name="{l:T common.close}">
              <Path Classes="icon" Data="{StaticResource Icon.Close}" Width="16" Height="16" />
            </Button>
          </Grid>

          <ScrollViewer x:Name="AddFriendScroll" Grid.Row="1">
          <StackPanel Spacing="10">
          <Border x:Name="MyCodeCard" Classes="code-card">
            <Panel>
              <Border Classes="wing-edge" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="16,10,10,10">
                <StackPanel Spacing="2" VerticalAlignment="Center" ToolTip.Tip="{l:T multiplayer.contacts.my_code_hint}">
                  <TextBlock Text="{l:T multiplayer.contacts.my_code}" FontWeight="SemiBold" />
                  <!-- Left out in a short window (the tooltip still has it), so the box for their code stays in sight. -->
                  <TextBlock x:Name="MyCodeHint" Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.contacts.my_code_hint}" />
                </StackPanel>
                <Button x:Name="CopyMyCodeButton" Grid.Column="1" Classes="small" Content="{l:T common.copy}" Command="{Binding CopyMyCodeCommand}"
                        VerticalAlignment="Center" />
              </Grid>
            </Panel>
          </Border>

          <!-- The box for their code stops at 420: a friend code is short, the box must not run across a wide window. -->
          <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MaxWidth="420" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FriendCodeBox" MaxWidth="420" HorizontalAlignment="Stretch" Text="{Binding CodeInput}" PlaceholderText="{l:T multiplayer.contacts.add_placeholder}"
                     c:EnterSubmit.Command="{Binding AddCommand}" />
            <Button x:Name="AddFriendCodeButton" Grid.Column="1" Classes="primary" Content="{l:T multiplayer.contacts.add}" Command="{Binding AddCommand}" />
          </Grid>

          <TextBlock Text="{l:T multiplayer.contacts.requests}" FontWeight="SemiBold" IsVisible="{Binding HasRequests}" />
          <ItemsControl x:Name="FriendRequestList" ItemsSource="{Binding Multiplayer.ContactRequests}" IsVisible="{Binding HasRequests}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:ContactRequestItem">
                <StackPanel Margin="0,3">
                  <!-- The emoji check is a safety decision: Jay's own locked card, which a theme pack cannot restyle. -->
                  <safety:SafetyPanel Classes="emoji-check" Title="{Binding Title}" IsVisible="{Binding IsComparing}">
                    <safety:SafetyPanel.Body>
                      <StackPanel Spacing="8">
                        <ItemsControl ItemsSource="{Binding Emoji}" AutomationProperties.Name="{Binding EmojiSpoken}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel ItemSpacing="14" LineSpacing="6" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:EmojiItem">
                              <StackPanel Spacing="2" MinWidth="56" AutomationProperties.Name="{Binding Name}">
                                <TextBlock Text="{Binding Emoji}" FontSize="34" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="80" TextAlignment="Center" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock FontSize="12" TextWrapping="Wrap" Text="{l:T multiplayer.contacts.compare.hint}" />
                        <WrapPanel ItemSpacing="8" LineSpacing="6">
                          <safety:SafetyButton Classes="emoji-differ" Kind="Safe" Content="{l:T multiplayer.contacts.compare.no_match}"
                                               Command="{Binding $parent[ItemsControl].((vm:PeopleViewModel)DataContext).Multiplayer.RejectContactCommand}" CommandParameter="{Binding}" />
                          <safety:SafetyButton Classes="emoji-same" Kind="Confirm" Content="{l:T multiplayer.contacts.compare.match}"
                                               Command="{Binding $parent[ItemsControl].((vm:PeopleViewModel)DataContext).Multiplayer.ConfirmContactCommand}" CommandParameter="{Binding}" />
                        </WrapPanel>
                      </StackPanel>
                    </safety:SafetyPanel.Body>
                  </safety:SafetyPanel>
                  <Border Classes="callout info" IsVisible="{Binding !IsComparing}">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                      <WrapPanel ItemSpacing="6" LineSpacing="6" IsVisible="{Binding IsAskingMe}">
                        <Button Classes="request-accept" Content="{l:T multiplayer.contacts.accept}"
                                Command="{Binding $parent[ItemsControl].((vm:PeopleViewModel)DataContext).Multiplayer.AcceptContactCommand}" CommandParameter="{Binding}" />
                        <Button Classes="request-ignore" Content="{l:T multiplayer.contacts.ignore}"
                                Command="{Binding $parent[ItemsControl].((vm:PeopleViewModel)DataContext).Multiplayer.DismissContactCommand}" CommandParameter="{Binding}" />
                      </WrapPanel>
                      <Button Classes="small request-cancel" HorizontalAlignment="Left" Content="{l:T multiplayer.contacts.cancel}" IsVisible="{Binding CanCancel}"
                              Command="{Binding $parent[ItemsControl].((vm:PeopleViewModel)DataContext).Multiplayer.DismissContactCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </StackPanel>

    <!-- The people: friends (emoji compared), then the ones I have only met in a room. One row per person. -->
    <Border svc:ThemeRegion.Name="people.list" x:Name="FriendListCard" Classes="card" Classes.haslist="{Binding HasList}" Classes.picked="{Binding HasPicked}" Padding="6">
      <ScrollViewer>
        <StackPanel Spacing="2">
          <TextBlock x:Name="FriendsCaption" Classes="caption" Margin="8,6,8,2" Text="{l:T multiplayer.contacts.title}" IsVisible="{Binding HasFriends}" />
          <ListBox x:Name="FriendList" ItemsSource="{Binding Friends}" SelectedItem="{Binding Selected}" Background="Transparent" IsVisible="{Binding HasFriends}"
                   ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="{l:T multiplayer.contacts.title}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:FriendRow">
                <Grid ColumnDefinitions="Auto,*" Margin="2,4" AutomationProperties.Name="{Binding Summary}">
                  <Border Classes="face" Background="{Binding Name, Converter={x:Static v:FaceBrush.Instance}}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                      <Border Classes="led small" Classes.online="{Binding IsHere}" Classes.busy="{Binding IsInRoom}" Classes.warning="{Binding NeedsLook}" Classes.off="{Binding IsQuiet}" />
                      <TextBlock Grid.Column="1" Classes="hint" Classes.warn="{Binding NeedsLook}" FontSize="12" Text="{Binding StateText}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock x:Name="MetCaption" Classes="caption" Margin="8,8,8,2" Text="{l:T people.met.title}" IsVisible="{Binding HasMet}" />
          <ListBox x:Name="MetList" ItemsSource="{Binding MetPeople}" SelectedItem="{Binding SelectedMet}" Background="Transparent" IsVisible="{Binding HasMet}"
                   ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="{l:T people.met.title}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:MetPersonItem">
                <Grid ColumnDefinitions="Auto,*" Margin="2,4" AutomationProperties.Name="{Binding Summary}">
                  <Border Classes="face" Background="{Binding DisplayName, Converter={x:Static v:FaceBrush.Instance}}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="hint" FontSize="12" Text="{Binding StateText}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- The selected person, or what to do when there is nobody yet. -->
    <Border svc:ThemeRegion.Name="people.detail" x:Name="FriendDetailCard" Classes="card" Classes.haslist="{Binding HasList}" Classes.picked="{Binding HasPicked}">
      <Panel>
        <StackPanel x:Name="PeopleChildNote" Classes="empty-state" IsVisible="{Binding ShowChildNote}">
          <Path Classes="icon" Data="{StaticResource Icon.Chat}" />
          <TextBlock Classes="hint" Text="{l:T people.child}" />
        </StackPanel>

        <!-- In a short window (or a long translation) the two buttons wrap under the text: it scrolls instead of being cut. -->
        <ScrollViewer x:Name="PeopleEmptyScroll" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding ShowEmpty}">
        <StackPanel x:Name="PeopleEmpty" Classes="empty-state">
          <Path Classes="icon" Data="{StaticResource Icon.Chat}" />
          <TextBlock Classes="title" Text="{l:T people.empty.title}" />
          <TextBlock Classes="hint" Text="{l:T people.empty.body}" />
          <WrapPanel HorizontalAlignment="Center" ItemSpacing="8" LineSpacing="8" Margin="0,8,0,0">
            <Button x:Name="EmptyCopyButton" Content="{l:T people.empty.copy}" Command="{Binding CopyMyCodeCommand}" />
            <Button x:Name="EmptyAddButton" Content="{l:T people.empty.paste}" Command="{Binding OpenAddCommand}" />
          </WrapPanel>
        </StackPanel>
        </ScrollViewer>

        <StackPanel x:Name="PeoplePickHint" Classes="empty-state" IsVisible="{Binding ShowPickHint}">
          <Path Classes="icon" Data="{StaticResource Icon.Chat}" />
          <TextBlock Classes="hint" Text="{l:T people.detail.pick}" />
        </StackPanel>

        <!-- A friend: who they are and what is known right now, what I can do, the conversation, the composer. -->
        <Grid x:Name="FriendDetail" RowDefinitions="Auto,*,Auto" RowSpacing="10" IsVisible="{Binding HasSelected}">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
            <Button x:Name="BackToListButton" Classes="ghost icon-only narrow-only" Command="{Binding BackToListCommand}" ToolTip.Tip="{l:T people.back}"
                    AutomationProperties.Name="{l:T people.back}" VerticalAlignment="Center">
              <Path Classes="icon" Data="{StaticResource Icon.ChevronLeft}" Width="16" Height="16" />
            </Button>
            <Border Grid.Column="1" Classes="face large" Background="{Binding Selected.Name, Converter={x:Static v:FaceBrush.Instance}}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <TextBlock x:Name="FriendName" Classes="h2" Margin="0" Text="{Binding Selected.Name}" TextTrimming="CharacterEllipsis" />
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                <Border Classes="led" Classes.online="{Binding Selected.IsHere}" Classes.busy="{Binding Selected.IsInRoom}" Classes.warning="{Binding Selected.NeedsLook}"
                        Classes.off="{Binding Selected.IsQuiet}" />
                <TextBlock x:Name="FriendStateText" Grid.Column="1" Classes="hint" FontSize="12" Text="{Binding Selected.StateText}" TextTrimming="CharacterEllipsis" />
              </Grid>
            </StackPanel>
            <!-- Always there: the conversation is end to end and this friend was checked. It opens their safety codes and devices. -->
            <Button x:Name="SafetyChipButton" Grid.Column="3" Classes="small" Command="{Binding ToggleSafetyCommand}" ToolTip.Tip="{l:T people.detail.devices}"
                    AutomationProperties.Name="{Binding SafetyText}" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="icon sm" Data="{StaticResource Icon.Lock}" IsVisible="{Binding SafetyIsFine}" />
                <Path Classes="icon sm" Data="{StaticResource Icon.Warning}" IsVisible="{Binding SafetyNeedsLook}" />
                <TextBlock x:Name="SafetyChipText" Classes="wide-only" Text="{Binding SafetyText}" />
                <TextBlock Classes="narrow-only" Text="{Binding SafetyShortText}" />
                <Path Classes="icon sm" Data="{StaticResource Icon.ChevronRight}" />
              </StackPanel>
            </Button>
          </Grid>

          <ScrollViewer x:Name="ConversationScroll" Grid.Row="1">
            <StackPanel Spacing="10">
              <!-- A call with this friend (reserved): the panel sits at the top of the conversation. -->
              <Panel x:Name="FriendCallHost" IsVisible="{Binding Call.ShowInPeople, FallbackValue=False}">
                <c:CallPanel x:Name="FriendCallPanel" DataContext="{Binding Call}" />
              </Panel>
              <TextBlock x:Name="FriendCallEnded" Classes="hint" Text="{Binding Call.EndedText, FallbackValue=''}" TextWrapping="Wrap"
                         IsVisible="{Binding Call.ShowEndedInPeople, FallbackValue=False}" />
              <Border x:Name="FriendSafetyPanel" Classes="callout info" IsVisible="{Binding ShowSafety}">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding SafetyHint}" TextWrapping="Wrap" />
                  <TextBlock Classes="hint" FontSize="12" Text="{Binding Selected.JayText}" IsVisible="{Binding Selected.HasJay}" TextWrapping="Wrap" />
                  <TextBlock Classes="hint" FontSize="12" Text="{l:T people.detail.no_jay}" IsVisible="{Binding Selected.HasNoJay}" TextWrapping="Wrap" />
                  <TextBlock Text="{l:T people.detail.devices}" FontWeight="SemiBold" />
                  <ItemsControl x:Name="FriendDevices" ItemsSource="{Binding Selected.DeviceItems}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:ContactDeviceItem">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2">
                          <SelectableTextBlock Text="{Binding Fingerprint}" FontFamily="Consolas,Menlo,monospace" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                          <WrapPanel Grid.Column="1" ItemSpacing="6" LineSpacing="4" VerticalAlignment="Center">
                            <Button Classes="small device-confirm" Content="{l:T multiplayer.contacts.new_device_ok}" IsVisible="{Binding IsNew}"
                                    Command="{Binding $parent[ItemsControl].((vm:PeopleViewModel)DataContext).ConfirmDeviceCommand}" CommandParameter="{Binding}" />
                            <Button Classes="small device-remove" Content="{l:T multiplayer.contacts.remove_device}" IsVisible="{Binding Person.HasSeveralDevices}"
                                    Command="{Binding $parent[ItemsControl].((vm:PeopleViewModel)DataContext).RemoveDeviceCommand}" CommandParameter="{Binding}" />
                          </WrapPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button x:Name="RemoveFriendButton" Classes="small" Content="{l:T people.safety.remove}" Command="{Binding RemoveFriendCommand}" HorizontalAlignment="Left"
                          IsVisible="{Binding !IsConfirmingRemove}" />
                  <StackPanel x:Name="RemoveFriendConfirm" Spacing="6" IsVisible="{Binding IsConfirmingRemove}">
                    <TextBlock TextWrapping="Wrap" Text="{Binding RemoveQuestion}" />
                    <WrapPanel ItemSpacing="8" LineSpacing="6">
                      <safety:SafetyButton x:Name="KeepFriendButton" Kind="Safe" Content="{l:T people.safety.remove_keep}" Command="{Binding KeepFriendCommand}" />
                      <safety:SafetyButton x:Name="ConfirmRemoveFriendButton" Kind="Confirm" Content="{l:T people.safety.remove_yes}" Command="{Binding ConfirmRemoveFriendCommand}" />
                    </WrapPanel>
                  </StackPanel>
                </StackPanel>
              </Border>

              <WrapPanel ItemSpacing="8" LineSpacing="8">
                <Button x:Name="JoinFriendRoomButton" Classes="play" Command="{Binding JoinRoomCommand}" IsVisible="{Binding CanJoinRoom}">
                  <TextBlock Text="{Binding JoinRoomText}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                </Button>
                <Button x:Name="InviteFriendButton" Content="{l:T people.detail.invite}" Command="{Binding InviteCommand}" IsEnabled="{Binding CanInvite}" />
                <!-- Calls (reserved; hidden while calls are off): voice, video, or straight to sharing the screen. -->
                <Button x:Name="CallVoiceButton" Content="{l:T call.voice}" Command="{Binding CallVoiceCommand}" IsVisible="{Binding ShowCallButtons}" IsEnabled="{Binding CanCall}" />
                <Button x:Name="CallVideoButton" Content="{l:T call.video}" Command="{Binding CallVideoCommand}" IsVisible="{Binding ShowVideoButton}" IsEnabled="{Binding CanCall}" />
                <Button x:Name="CallShareButton" Content="{l:T call.share}" Command="{Binding CallShareCommand}" IsVisible="{Binding ShowCallButtons}" IsEnabled="{Binding CanCall}" />
              </WrapPanel>
              <TextBlock x:Name="InviteHintText" Classes="hint" FontSize="12" Text="{l:T people.detail.invite_hint}" IsVisible="{Binding ShowInviteHint}" TextWrapping="Wrap" />

              <!-- The old trusted list, as one switch on the person. -->
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{l:T people.auto_admit}" TextWrapping="Wrap" />
                  <TextBlock Classes="hint" FontSize="12" Text="{l:T people.auto_admit.hint}" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch x:Name="AutoAdmitSwitch" Grid.Column="1" Classes="compact" IsChecked="{Binding AutoAdmit}" OnContent="" OffContent="" MinWidth="0"
                              AutomationProperties.Name="{l:T people.auto_admit}" VerticalAlignment="Center" />
              </Grid>

              <TextBlock x:Name="NoLinesText" Classes="hint" FontSize="12" Text="{l:T people.chat.empty}" IsVisible="{Binding HasNoLines}" />
              <ItemsControl x:Name="ConversationList" ItemsSource="{Binding Lines}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:FriendLine">
                    <Panel AutomationProperties.Name="{Binding Spoken}">
                      <!-- Something that happened: an invite and where it is. -->
                      <WrapPanel HorizontalAlignment="Center" ItemSpacing="6" LineSpacing="2" IsVisible="{Binding IsNote}">
                        <Path Classes="icon sm" Data="{StaticResource Icon.Lock}" VerticalAlignment="Center" />
                        <TextBlock Classes="hint" FontSize="12" Text="{Binding TimeText}" />
                        <TextBlock Classes="hint" FontSize="12" Text="{Binding Text}" TextWrapping="Wrap" />
                        <TextBlock Classes="line-delivery" FontSize="12" FontWeight="SemiBold" Text="{Binding DeliveryText}" IsVisible="{Binding HasDelivery}"
                                   Classes.warn="{Binding IsHeld}" />
                      </WrapPanel>
                      <!-- A file: its card, on my side when I sent it. -->
                      <Panel Classes="line-file" Classes.mine="{Binding IsFileMine}" IsVisible="{Binding IsFile}">
                        <c:FileCard DataContext="{Binding File}" />
                      </Panel>
                      <Border Classes="bubble" Classes.mine="{Binding IsMine}" IsVisible="{Binding IsBubble}">
                        <StackPanel Spacing="2">
                          <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                          <TextBlock Classes="caption" Text="{Binding TimeText}" HorizontalAlignment="Right" />
                        </StackPanel>
                      </Border>
                    </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Row="2" Spacing="4">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
              <!-- The paperclip (batch 12): a file, a world, a mod list, a screenshot, a log or a folder. Works when they're
                   not here too: the file waits until you're both online. Dropping files on the conversation sends them. -->
              <Button x:Name="AttachButton" Classes="secondary icon-only" IsEnabled="{Binding CanAttach}"
                      ToolTip.Tip="{l:T files.attach}" AutomationProperties.Name="{l:T files.attach}">
                <Path Classes="icon sm" Data="{StaticResource Icon.Paperclip}" />
                <Button.Flyout>
                  <MenuFlyout Placement="TopEdgeAlignedLeft">
                    <MenuItem x:Name="AttachFileItem" Header="{l:T files.menu.file_pick}" Command="{Binding AttachCommand}" CommandParameter="file" />
                    <MenuItem x:Name="AttachWorldItem" Header="{l:T files.menu.world}" Command="{Binding AttachCommand}" CommandParameter="world" />
                    <MenuItem x:Name="AttachModsItem" Header="{l:T files.menu.mods}" Command="{Binding AttachCommand}" CommandParameter="mods" />
                    <MenuItem x:Name="AttachShotItem" Header="{l:T files.menu.screenshot}" Command="{Binding AttachCommand}" CommandParameter="screenshot" />
                    <MenuItem x:Name="AttachLogItem" Header="{l:T files.menu.log}" Command="{Binding AttachCommand}" CommandParameter="log" />
                    <MenuItem x:Name="AttachFolderItem" Header="{l:T files.menu.folder_pick}" Command="{Binding AttachCommand}" CommandParameter="folder" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <TextBox x:Name="DraftBox" Grid.Column="1" Text="{Binding Draft}" PlaceholderText="{Binding DraftPlaceholder}" MaxLength="2000" IsEnabled="{Binding CanMessage}"
                       c:EnterSubmit.Command="{Binding SendCommand}" />
              <Button x:Name="SendDraftButton" Grid.Column="2" Classes="primary" Command="{Binding SendCommand}" IsEnabled="{Binding CanMessage}"
                      ToolTip.Tip="{l:T common.send}" AutomationProperties.Name="{l:T common.send}">
                <Path Classes="icon sm" Data="{StaticResource Icon.Send}" />
              </Button>
            </Grid>
            <TextBlock x:Name="MessageHintText" Classes="hint" FontSize="12" Text="{l:T people.chat.needs_room}" IsVisible="{Binding ShowMessageHint}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>

        <!-- Someone I have only met in a room: no conversation, the way to become friends and the same switch. -->
        <ScrollViewer x:Name="MetDetail" IsVisible="{Binding HasSelectedMet}">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
              <Button x:Name="MetBackButton" Classes="ghost icon-only narrow-only" Command="{Binding BackToListCommand}" ToolTip.Tip="{l:T people.back}"
                      AutomationProperties.Name="{l:T people.back}" VerticalAlignment="Center">
                <Path Classes="icon" Data="{StaticResource Icon.ChevronLeft}" Width="16" Height="16" />
              </Button>
              <Border Grid.Column="1" Classes="face large" Background="{Binding SelectedMet.DisplayName, Converter={x:Static v:FaceBrush.Instance}}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock x:Name="MetName" Classes="h2" Margin="0" Text="{Binding SelectedMet.DisplayName}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="MetStateText" Classes="hint" FontSize="12" Text="{Binding SelectedMet.StateText}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
            <TextBlock Text="{l:T people.met.hint}" TextWrapping="Wrap" />
            <SelectableTextBlock x:Name="MetFingerprint" Text="{Binding SelectedMet.Fingerprint}" FontFamily="Consolas,Menlo,monospace" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Classes="hint" FontSize="12" Text="{Binding SelectedMet.JayText}" IsVisible="{Binding SelectedMet.HasJay}" TextWrapping="Wrap" />
            <Button x:Name="AddMetButton" Classes="primary" Content="{l:T people.met.add}" Command="{Binding AddMetCommand}" IsVisible="{Binding CanAddMet}" HorizontalAlignment="Left" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{l:T people.auto_admit}" TextWrapping="Wrap" />
                <TextBlock Classes="hint" FontSize="12" Text="{l:T people.auto_admit.met_hint}" TextWrapping="Wrap" />
                <TextBlock x:Name="KnocksAlwaysAskText" Classes="hint" FontSize="12" Text="{l:T people.auto_admit.child}" IsVisible="{Binding ShowKnocksAlwaysAsk}" TextWrapping="Wrap" />
                <TextBlock x:Name="MetUncheckedText" Classes="hint" FontSize="12" Text="{l:T people.auto_admit.unchecked}" IsVisible="{Binding ShowMetUnchecked}" TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch x:Name="MetAutoAdmitSwitch" Grid.Column="1" Classes="compact" IsChecked="{Binding MetAutoAdmit}" IsEnabled="{Binding CanChangeMetAutoAdmit}"
                            OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="{l:T people.auto_admit}" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Panel>
    </Border>
  </Grid>
</UserControl>
