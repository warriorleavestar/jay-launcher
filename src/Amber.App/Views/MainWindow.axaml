<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Amber.App.Localization"
        xmlns:vm="using:Amber.App.ViewModels"
        xmlns:views="using:Amber.App.Views"
        xmlns:c="using:Amber.App.Views.Controls"
        x:Class="Amber.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{l:T main.title}"
        Icon="/Assets/jay.ico"
        MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        xmlns:svc="using:Amber.App.Services"
        xmlns:safety="using:Amber.App.Controls.Safety">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:LibraryViewModel"><views:LibraryPage /></DataTemplate>
    <DataTemplate DataType="vm:HomeViewModel"><views:HomePage /></DataTemplate>
    <DataTemplate DataType="vm:AccountsViewModel"><views:AccountsPage /></DataTemplate>
    <DataTemplate DataType="vm:InstanceViewModel"><views:InstancePage /></DataTemplate>
    <DataTemplate DataType="vm:DownloadViewModel"><views:DownloadPage /></DataTemplate>
    <DataTemplate DataType="vm:ContentViewModel"><views:ContentPage /></DataTemplate>
    <DataTemplate DataType="vm:MultiplayerViewModel"><views:MultiplayerPage /></DataTemplate>
    <DataTemplate DataType="vm:ToolsViewModel"><views:ToolsPage /></DataTemplate>
    <DataTemplate DataType="vm:LogViewModel"><views:LogPage /></DataTemplate>

    <!-- 设置页：即改即存（改版规格 3.10）。下拉框、复选框改了就存；文本框失焦时校验，通过才存，不通过在下面写原因并保留输入。
         XAML 里的声明顺序和行顺序一致，Tab 键从上到下走。 -->
    <DataTemplate DataType="vm:SettingsViewModel">
      <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock Classes="h1" Text="{l:T instance.settings.title}" />
        <ScrollViewer Grid.Row="1">
          <StackPanel Margin="0,0,14,0">
            <Border Classes="card">
              <Grid Classes="form" ColumnSpacing="12" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Text="{l:T settings.directory.label}" VerticalAlignment="Center" />
                <TextBox x:Name="GameDirectoryBox" Grid.Column="1" Text="{Binding GameDirectory, UpdateSourceTrigger=LostFocus}" />
                <Button Grid.Column="2" Content="{l:T common.browse}" Margin="8,0,0,0" Click="BrowseGameDir_Click" />

                <TextBlock Grid.Row="1" Text="{l:T settings.source.label}" VerticalAlignment="Center" Margin="0,12,0,0" />
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SourceOptions}" SelectedIndex="{Binding SourceIndex}"
                          HorizontalAlignment="Stretch" Margin="0,12,0,0" />
                <Button Grid.Row="1" Grid.Column="2" Classes="ghost reset" Content="↺" Margin="8,12,0,0" Command="{Binding ResetFieldCommand}" CommandParameter="source"
                        ToolTip.Tip="{l:T settings.reset}" AutomationProperties.Name="{l:T settings.reset}" />

                <TextBlock Grid.Row="2" Text="{l:T settings.download.concurrency}" VerticalAlignment="Top" Margin="0,18,0,0" />
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" Spacing="4">
                  <TextBox x:Name="ConcurrencyBox" Text="{Binding Concurrency, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left" />
                  <TextBlock Classes="field-error" Text="{Binding ConcurrencyError}" IsVisible="{Binding HasConcurrencyError}" />
                </StackPanel>
                <Button Grid.Row="2" Grid.Column="2" Classes="ghost reset" Content="↺" Margin="8,12,0,0" VerticalAlignment="Top" Command="{Binding ResetFieldCommand}" CommandParameter="concurrency"
                        ToolTip.Tip="{l:T settings.reset}" AutomationProperties.Name="{l:T settings.reset}" />

                <TextBlock Grid.Row="3" Text="{l:T instance.settings.isolation}" VerticalAlignment="Center" Margin="0,12,0,0" />
                <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding IsolateVersions}" Margin="0,12,0,0"
                          Content="{l:T settings.isolation.hint}" />

                <TextBlock Grid.Row="4" Text="{l:T settings.theme.label}" VerticalAlignment="Center" Margin="0,12,0,0" />
                <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedIndex="{Binding SelectedThemeIndex}" MinWidth="160" Margin="0,12,0,0" />
                <Button Grid.Row="4" Grid.Column="2" Classes="ghost reset" Content="↺" Margin="8,12,0,0" Command="{Binding ResetFieldCommand}" CommandParameter="theme"
                        ToolTip.Tip="{l:T settings.reset}" AutomationProperties.Name="{l:T settings.reset}" />

                <TextBlock Grid.Row="5" Text="{l:T settings.language.label}" VerticalAlignment="Center" Margin="0,12,0,0" />
                <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding LanguageOptions}" SelectedIndex="{Binding SelectedLanguageIndex}" MinWidth="160" Margin="0,12,0,0" />

                <TextBlock Grid.Row="6" Text="{l:T settings.motion.label}" VerticalAlignment="Top" Margin="0,18,0,0" />
                <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,12,0,0" Spacing="4">
                  <ComboBox x:Name="MotionBox" ItemsSource="{Binding MotionOptions}" SelectedIndex="{Binding SelectedMotionIndex}" MinWidth="160"
                            AutomationProperties.Name="{l:T settings.motion.label}" />
                  <TextBlock Classes="hint" Text="{l:T settings.motion.hint}" />
                </StackPanel>
                <Button Grid.Row="6" Grid.Column="2" Classes="ghost reset" Content="↺" Margin="8,12,0,0" VerticalAlignment="Top" Command="{Binding ResetFieldCommand}" CommandParameter="motion"
                        ToolTip.Tip="{l:T settings.reset}" AutomationProperties.Name="{l:T settings.reset}" />

                <TextBlock Grid.Row="7" Text="{l:T settings.sidebar.label}" VerticalAlignment="Center" Margin="0,12,0,0" />
                <ComboBox x:Name="SidebarBox" Grid.Row="7" Grid.Column="1" ItemsSource="{Binding SidebarOptions}" SelectedIndex="{Binding SelectedSidebarIndex}" MinWidth="160" Margin="0,12,0,0"
                          AutomationProperties.Name="{l:T settings.sidebar.label}" />
                <Button Grid.Row="7" Grid.Column="2" Classes="ghost reset" Content="↺" Margin="8,12,0,0" Command="{Binding ResetFieldCommand}" CommandParameter="sidebar"
                        ToolTip.Tip="{l:T settings.reset}" AutomationProperties.Name="{l:T settings.reset}" />
              </Grid>
            </Border>
            <!-- 界面主题包（.jaytheme）：导入、切换、删除、导出。“恢复默认主题”固定在这里，主题包改不了它。 -->
            <Border Classes="card">
              <Grid Classes="form" ColumnSpacing="12" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                <TextBlock Text="{l:T settings.themepack.label}" VerticalAlignment="Center" />
                <ComboBox x:Name="ThemePackBox" Grid.Column="1" ItemsSource="{Binding ThemePacks}" SelectedItem="{Binding SelectedThemePack}"
                          HorizontalAlignment="Stretch" AutomationProperties.Name="{l:T settings.themepack.label}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate DataType="vm:ThemePackOption">
                      <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="2" Classes="ghost reset" Content="↺" Margin="8,0,0,0" Command="{Binding ResetThemePackCommand}"
                        ToolTip.Tip="{l:T settings.themepack.reset}" AutomationProperties.Name="{l:T settings.themepack.reset}" />
                <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0" ItemSpacing="8" LineSpacing="8">
                  <Button Classes="secondary" Content="{l:T settings.themepack.import}" Click="ImportTheme_Click" />
                  <Button Classes="secondary" Content="{l:T settings.themepack.export}" Click="ExportTheme_Click" />
                  <Button Classes="danger" Content="{l:T settings.themepack.remove}" Command="{Binding RemoveThemePackCommand}" IsEnabled="{Binding CanRemoveThemePack}" />
                </WrapPanel>
                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Classes="hint" Margin="0,8,0,0" Text="{l:T settings.themepack.hint}" />
                <CheckBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0" IsChecked="{Binding AllowNetworkThemes}">
                  <TextBlock Text="{l:T settings.themepack.allow_network}" TextWrapping="Wrap" />
                </CheckBox>
              </Grid>
            </Border>
            <Border Classes="callout warning" Margin="0,0,0,12" IsVisible="{Binding ThemePackStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Classes="hint" Text="{Binding ThemePackStatus}" />
            </Border>
            <Border Classes="card">
              <Grid Classes="form" ColumnSpacing="12" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Text="Java" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding JavaOptions}" SelectedItem="{Binding SelectedJava}"
                          HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate DataType="vm:JavaOption">
                      <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="2" Content="{l:T settings.java.rescan}" Margin="8,0,0,0" Command="{Binding RefreshJavaCommand}" />

                <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding AutoJavaDownload}" Margin="0,8,0,0"
                          Content="{l:T settings.java.auto_download}" />

                <TextBlock Grid.Row="2" Text="{l:T instance.settings.window_size}" VerticalAlignment="Top" Margin="0,18,0,0" />
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" Spacing="4">
                  <WrapPanel ItemSpacing="8" LineSpacing="8">
                    <TextBox x:Name="WindowWidthBox" Text="{Binding WindowWidth, UpdateSourceTrigger=LostFocus}" Width="90" PlaceholderText="{l:T instance.settings.width}" />
                    <TextBlock Text="×" VerticalAlignment="Center" />
                    <TextBox x:Name="WindowHeightBox" Text="{Binding WindowHeight, UpdateSourceTrigger=LostFocus}" Width="90" PlaceholderText="{l:T instance.settings.height}" />
                    <CheckBox IsChecked="{Binding Fullscreen}" Content="{l:T instance.settings.fullscreen}" />
                  </WrapPanel>
                  <TextBlock Classes="field-error" Text="{Binding WindowError}" IsVisible="{Binding HasWindowError}" />
                </StackPanel>
                <Button Grid.Row="2" Grid.Column="2" Classes="ghost reset" Content="↺" Margin="8,12,0,0" VerticalAlignment="Top" Command="{Binding ResetFieldCommand}" CommandParameter="window"
                        ToolTip.Tip="{l:T settings.reset}" AutomationProperties.Name="{l:T settings.reset}" />

                <TextBlock Grid.Row="3" Text="{l:T instance.settings.jvm_args}" VerticalAlignment="Top" Margin="0,18,0,0" />
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,12,0,0" Spacing="4">
                  <TextBox x:Name="JvmArgsBox" Text="{Binding JvmArgs, UpdateSourceTrigger=LostFocus}" />
                  <TextBlock Classes="field-error" Text="{Binding JvmArgsError}" IsVisible="{Binding HasJvmArgsError}" />
                </StackPanel>
                <Button Grid.Row="3" Grid.Column="2" Classes="ghost reset" Content="↺" Margin="8,12,0,0" VerticalAlignment="Top" Command="{Binding ResetFieldCommand}" CommandParameter="jvm"
                        ToolTip.Tip="{l:T settings.reset}" AutomationProperties.Name="{l:T settings.reset}" />

                <TextBlock Grid.Row="4" Text="{l:T instance.settings.game_args}" VerticalAlignment="Top" Margin="0,18,0,0" />
                <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,12,0,0" Spacing="4">
                  <TextBox Text="{Binding GameArgs, UpdateSourceTrigger=LostFocus}" />
                  <TextBlock Classes="field-error" Text="{Binding GameArgsError}" IsVisible="{Binding HasGameArgsError}" />
                </StackPanel>
                <Button Grid.Row="4" Grid.Column="2" Classes="ghost reset" Content="↺" Margin="8,12,0,0" VerticalAlignment="Top" Command="{Binding ResetFieldCommand}" CommandParameter="game_args"
                        ToolTip.Tip="{l:T settings.reset}" AutomationProperties.Name="{l:T settings.reset}" />

                <TextBlock Grid.Row="5" Text="{l:T instance.settings.pre_launch}" VerticalAlignment="Center" Margin="0,12,0,0" />
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding PreLaunch, UpdateSourceTrigger=LostFocus}" Margin="0,12,0,0" />
                <Button Grid.Row="5" Grid.Column="2" Classes="ghost reset" Content="↺" Margin="8,12,0,0" Command="{Binding ResetFieldCommand}" CommandParameter="pre"
                        ToolTip.Tip="{l:T settings.reset}" AutomationProperties.Name="{l:T settings.reset}" />

                <TextBlock Grid.Row="6" Text="{l:T instance.settings.post_exit}" VerticalAlignment="Center" Margin="0,12,0,0" />
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding PostExit, UpdateSourceTrigger=LostFocus}" Margin="0,12,0,0" />
                <Button Grid.Row="6" Grid.Column="2" Classes="ghost reset" Content="↺" Margin="8,12,0,0" Command="{Binding ResetFieldCommand}" CommandParameter="post"
                        ToolTip.Tip="{l:T settings.reset}" AutomationProperties.Name="{l:T settings.reset}" />

                <!-- 无痕模式：游戏日志里不写聊天行 -->
                <TextBlock Grid.Row="7" Text="{l:T settings.notrace.label}" VerticalAlignment="Top" Margin="0,12,0,0" />
                <StackPanel Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Spacing="4">
                  <CheckBox x:Name="NoTraceBox" IsChecked="{Binding NoTrace}" Content="{l:T settings.notrace.toggle}" />
                  <TextBlock Classes="hint" FontSize="12" Text="{l:T settings.notrace.hint}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>
            <!-- 联机安全：设备验证、熔断和重启前的倒计时 -->
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="{l:T settings.security.title}" Margin="0" />
                <TextBlock Classes="hint" FontSize="12" Text="{l:T settings.security.hint}" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="10">
                  <TextBlock Text="{l:T settings.security.attest.label}" VerticalAlignment="Center" />
                  <ComboBox x:Name="AttestationBox" Grid.Column="1" ItemsSource="{Binding AttestationOptions}" SelectedIndex="{Binding AttestationIndex}" HorizontalAlignment="Stretch" />
                  <TextBlock Grid.Row="1" Text="{l:T settings.security.breaker.label}" VerticalAlignment="Center" />
                  <CheckBox x:Name="BreakerBox" Grid.Row="1" Grid.Column="1" IsChecked="{Binding SecurityBreaker}" Content="{l:T settings.security.breaker.toggle}" />
                  <TextBlock Grid.Row="2" Text="{l:T settings.security.delay.label}" VerticalAlignment="Top" Margin="0,6,0,0" />
                  <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                    <TextBox x:Name="BreakerDelayBox" Text="{Binding BreakerRestartDelay, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding !BreakerSkipDelay}" MaxWidth="120" HorizontalAlignment="Left" />
                    <TextBlock Classes="field-error" Text="{Binding BreakerDelayError}" IsVisible="{Binding HasBreakerDelayError}" />
                  </StackPanel>
                  <CheckBox x:Name="BreakerSkipBox" Grid.Row="3" Grid.Column="1" IsChecked="{Binding BreakerSkipDelay}" Content="{l:T settings.security.skip.toggle}" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="6">
                <TextBlock Classes="h2" Text="{l:T settings.bake.title}" Margin="0" />
                <CheckBox IsChecked="{Binding ExperimentalBake}" Content="{l:T settings.bake.toggle}" />
                <TextBlock Classes="hint" FontSize="12" Text="{l:T settings.bake.hint}" TextWrapping="Wrap" />
                <TextBox Text="{Binding BakeLoaderPath, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding ExperimentalBake}" PlaceholderText="{l:T settings.bake.loader_hint}" />
              </StackPanel>
            </Border>
            <Border Classes="card">
              <Grid Classes="form" ColumnSpacing="12" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                <TextBlock Text="{l:T settings.curseforge.key}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding CurseForgeKey, UpdateSourceTrigger=LostFocus}" PasswordChar="●" PlaceholderText="{l:T settings.curseforge.key_hint}" />
                <TextBlock Grid.Row="1" Text="{l:T settings.curseforge.endpoint}" VerticalAlignment="Center" Margin="0,12,0,0" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CurseForgeRoot, UpdateSourceTrigger=LostFocus}" Margin="0,12,0,0" PlaceholderText="{l:T settings.curseforge.endpoint_hint}" />
                <TextBlock Grid.Row="2" Text="{l:T settings.update.feed}" VerticalAlignment="Center" Margin="0,12,0,0" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding UpdateFeed, UpdateSourceTrigger=LostFocus}" Margin="0,12,0,0" PlaceholderText="{l:T settings.update.feed_hint}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Classes="hint" FontSize="12" Margin="0,6,0,0" Text="{l:T settings.accounts.client_id_hint}" />
              </Grid>
            </Border>
            <!-- Storage › Recently deleted (§6.20): [Restore] on every row; [Delete forever] and [Empty] use the locked confirm. -->
            <Border x:Name="RecycleCard" Classes="card">
              <StackPanel Spacing="8">
                <DockPanel>
                  <c:ConfirmButton x:Name="EmptyRecycleButton" DockPanel.Dock="Right" Content="{l:T recycle.empty_all}" ConfirmText="{l:T recycle.empty_all.confirm}"
                                   ObjectName="{l:T recycle.title}" Command="{Binding Recycle.EmptyAllCommand}" IsVisible="{Binding Recycle.HasRows}" VerticalAlignment="Center" />
                  <StackPanel Spacing="2">
                    <TextBlock Classes="h2" Text="{l:T recycle.title}" Margin="0" />
                    <TextBlock Classes="hint" Text="{Binding Recycle.Summary}" IsVisible="{Binding Recycle.HasRows}" />
                  </StackPanel>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{l:T recycle.keep.label}" VerticalAlignment="Center" />
                  <ComboBox x:Name="RecycleKeepBox" ItemsSource="{Binding Recycle.KeepOptions}" SelectedIndex="{Binding Recycle.KeepIndex}" MinWidth="110"
                            AutomationProperties.Name="{l:T recycle.keep.label}" />
                </StackPanel>
                <TextBlock x:Name="RecycleEmptyText" Classes="hint" Text="{Binding Recycle.EmptyText}" IsVisible="{Binding Recycle.IsEmpty}" TextWrapping="Wrap" />
                <ItemsControl x:Name="RecycleList" ItemsSource="{Binding Recycle.Rows}" IsVisible="{Binding Recycle.HasRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:RecycledRow">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,4">
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Item.Entry.OriginalPath}" />
                          <TextBlock Classes="hint" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="hint" Text="{Binding When}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" Content="{l:T recycle.restore}" VerticalAlignment="Center"
                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).Recycle.RestoreCommand}" CommandParameter="{Binding}" />
                        <c:ConfirmButton Grid.Column="2" Content="{l:T recycle.delete_forever}" ConfirmText="{l:T recycle.delete_forever}" ObjectName="{Binding Name}"
                                         VerticalAlignment="Center"
                                         Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).Recycle.DeleteForeverCommand}" CommandParameter="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <c:StatusBar Message="{Binding Recycle.Message}" />
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="6">
                <TextBlock Classes="h2" Text="{l:T settings.privacy.title}" Margin="0" />
                <TextBlock Classes="hint" Text="{l:T settings.privacy.hint}" />
                <TextBlock Classes="hint" Text="{l:T settings.privacy.endpoints}" />
                <TextBlock Classes="hint" Text="{Binding SettingsPathLabel}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <c:StatusBar Grid.Row="2" x:Name="SettingsStatus" Message="{Binding StatusInfo}" Margin="0,4,0,0" />
      </Grid>
    </DataTemplate>

    <!-- 请求条上的一条请求（§6.22）：安全类用锁定的安全横幅和安全按钮，其余用普通横幅 -->
    <DataTemplate DataType="vm:RequestItem">
      <Panel>
        <safety:SafetyBanner IsVisible="{Binding IsSafety}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Body}" IsVisible="{Binding HasBody}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding RemainingText}" IsVisible="{Binding HasRemaining}" FontSize="12" />
            </StackPanel>
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Buttons}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:RequestButton">
                  <safety:SafetyButton Content="{Binding Label}" Command="{Binding ChooseCommand}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </safety:SafetyBanner>
        <Border Classes="banner request" IsVisible="{Binding !IsSafety}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Path Classes="icon" Data="{StaticResource Icon.Bell}" Width="20" Height="20" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Body}" IsVisible="{Binding HasBody}" Classes="hint" TextWrapping="Wrap" />
              <TextBlock Text="{Binding RemainingText}" IsVisible="{Binding HasRemaining}" Classes="hint" />
            </StackPanel>
            <ItemsControl Grid.Column="2" ItemsSource="{Binding Buttons}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:RequestButton">
                  <Button Classes="secondary small" Classes.primary="{Binding Choice.IsDefault}" Content="{Binding Label}" Command="{Binding ChooseCommand}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>
      </Panel>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid x:Name="ShellGrid" ColumnDefinitions="240,*">
    <!-- 主题包的窗口背景图（没有主题背景图时是空的）。放在最底层，不接收点击。 -->
    <Image x:Name="ThemeBackground" Grid.ColumnSpan="2" Source="{DynamicResource ThemeBackgroundImage}" Opacity="{DynamicResource ThemeBackgroundOpacity}"
           Stretch="UniformToFill" IsHitTestVisible="False" />
    <!-- 侧栏（官方设计 §2.1、§3.1）：品牌 → 三个一级入口 → 隐私行 → 设置 → 账号。展开 240，收成图标栏 76。 -->
    <Border x:Name="SidebarHost" Classes="sidebar">
      <Grid x:Name="SidebarGrid" RowDefinitions="Auto,*,Auto">
        <Button x:Name="SidebarHeader" Classes="ghost shell-brand" Command="{Binding Shell.GoSectionCommand}" CommandParameter="library"
                ToolTip.Tip="{Binding VersionText}" AutomationProperties.Name="Jay">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Image Source="/Assets/jay.png" Width="24" Height="24" Stretch="Uniform" />
            <TextBlock x:Name="BrandName" Text="Jay" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource SidebarText}" />
          </StackPanel>
        </Button>
        <ListBox x:Name="NavList" Grid.Row="1" Classes="nav" ItemsSource="{Binding Shell.Sections}" SelectedItem="{Binding Shell.SelectedSection}"
                 Background="Transparent" Margin="8,4" ClipToBounds="True" AutomationProperties.Name="{l:T shell.nav.label}">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
              <Setter Property="Margin" Value="0,1" />
              <Setter Property="Padding" Value="12,0" />
              <Setter Property="MinHeight" Value="40" />
              <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style Selector="ListBoxItem" x:DataType="vm:NavSection">
              <Setter Property="ToolTip.Tip" Value="{Binding ToolTip}" />
              <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            </Style>
            <!-- 图标栏：图标在上、短名在下 -->
            <Style Selector="ListBox.rail ListBoxItem">
              <Setter Property="Padding" Value="2,6" />
              <Setter Property="MinHeight" Value="52" />
              <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
            <Style Selector="StackPanel.nav-row">
              <Setter Property="Orientation" Value="Horizontal" />
              <Setter Property="Spacing" Value="12" />
            </Style>
            <Style Selector="ListBox.rail StackPanel.nav-row">
              <Setter Property="Orientation" Value="Vertical" />
              <Setter Property="Spacing" Value="2" />
              <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <Style Selector="ListBox.rail TextBlock.nav-title">
              <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="ListBox:not(.rail) TextBlock.nav-short">
              <Setter Property="IsVisible" Value="False" />
            </Style>
            <!-- 很矮的窗口：图标栏只留图标，短名放进提示 -->
            <Style Selector="ListBox.rail.tight TextBlock.nav-short">
              <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="ListBox.rail.tight ListBoxItem">
              <Setter Property="MinHeight" Value="40" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:NavSection">
              <Panel>
                <!-- 选中项左边的指示条：不占位置，图标不动 -->
                <Border Classes="nav-indicator" Width="3" Height="16" CornerRadius="2" Background="{DynamicResource Accent}" Margin="-10,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding IsActive}" />
                <StackPanel Classes="nav-row">
                  <Panel HorizontalAlignment="Center">
                    <Path Classes="icon" Data="{Binding Icon}" Stroke="{DynamicResource SidebarText}" Width="20" Height="20" />
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Danger}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0"
                             IsVisible="{Binding HasBadge}" />
                  </Panel>
                  <TextBlock Classes="nav-title" Text="{Binding Title}" Foreground="{DynamicResource SidebarText}" FontSize="14" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="nav-short" Text="{Binding ShortTitle}" Foreground="{DynamicResource SidebarText}" FontSize="{DynamicResource FontCaption}"
                             HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="64" />
                </StackPanel>
              </Panel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <!-- 侧栏底部：隐私行（锁定，任何尺寸都看得见）、设置、账号 -->
        <StackPanel x:Name="SidebarFooter" Grid.Row="2" Margin="8,4,8,10" Spacing="2">
          <safety:PrivacyRow x:Name="PrivacyRow" Margin="8,4" />
          <Button x:Name="SettingsButton" Classes="ghost shell-foot" Command="{Binding Shell.OpenSettingsCommand}"
                  Classes.active="{Binding Shell.IsSettingsActive}" ToolTip.Tip="{l:T shell.settings_tip}" AutomationProperties.Name="{l:T shell.settings}">
            <StackPanel Classes="foot-row" Orientation="Horizontal" Spacing="12">
              <Panel>
                <Path Classes="icon" Data="{StaticResource Icon.Settings}" Stroke="{DynamicResource SidebarText}" Width="20" Height="20" />
                <Ellipse Width="8" Height="8" Fill="{DynamicResource Danger}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0"
                         IsVisible="{Binding Shell.HasSettingsBadge}" />
              </Panel>
              <TextBlock Classes="foot-title" Text="{l:T shell.settings}" Foreground="{DynamicResource SidebarText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Button>
          <Button x:Name="AccountButton" Classes="ghost shell-foot" Command="{Binding Shell.OpenAccountsCommand}"
                  Classes.active="{Binding Shell.IsAccountsActive}" ToolTip.Tip="{Binding Shell.AccountName}" AutomationProperties.Name="{l:T shell.account}">
            <StackPanel Classes="foot-row" Orientation="Horizontal" Spacing="12">
              <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource AccentTint}">
                <TextBlock Text="{Binding Shell.AccountInitial}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Classes="foot-title" Text="{Binding Shell.AccountName}" Foreground="{DynamicResource SidebarText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 内容列：顶栏、子页页签、“东西搬到哪了”、页面 -->
    <Grid x:Name="ContentColumn" Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto,*">
      <!-- 顶栏（§3.1）：← 返回 + 标题或面包屑；带上下文跳过来时有【完成，返回】 -->
      <Grid x:Name="TopBar" Height="48" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="8,0,16,0">
        <Button x:Name="BackButton" Classes="ghost icon-only" Command="{Binding Shell.BackCommand}" IsEnabled="{Binding Shell.CanGoBack}"
                ToolTip.Tip="{l:T shell.back_tip}" AutomationProperties.Name="{l:T shell.back}" VerticalAlignment="Center">
          <Path Classes="icon" Data="{StaticResource Icon.ChevronLeft}" Width="20" Height="20" />
        </Button>
        <Button x:Name="ForwardButton" Grid.Column="1" Classes="ghost icon-only" Command="{Binding Shell.ForwardCommand}" IsVisible="{Binding Shell.CanGoForward}"
                ToolTip.Tip="{l:T shell.forward_tip}" AutomationProperties.Name="{l:T shell.forward}" VerticalAlignment="Center">
          <Path Classes="icon" Data="{StaticResource Icon.ChevronRight}" Width="20" Height="20" />
        </Button>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="ShellTitle" Text="{Binding Shell.Title}" FontSize="{DynamicResource FontSubtitle}" FontWeight="SemiBold"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Shell.ReturnLabel}" IsVisible="{Binding Shell.HasReturn}" Classes="hint" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Column="3" Classes="secondary small" Content="{l:T shell.return_done}" Command="{Binding Shell.ReturnCommand}"
                IsVisible="{Binding Shell.HasReturn}" VerticalAlignment="Center" />
        <!-- 正在玩胶囊：有游戏准备中、运行中或刚崩溃时才出现；点它去游戏库 -->
        <Button x:Name="PlayingPill" Grid.Column="4" Classes="pill-play" Classes.crash="{Binding Activity.PillIsCrash}" Command="{Binding Activity.OpenPillCommand}"
                IsVisible="{Binding Activity.HasPill}" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip.Tip="{Binding Activity.PillText}"
                AutomationProperties.Name="{Binding Activity.PillText}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Classes="pill-dot" Width="8" Height="8" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Activity.PillText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220" />
          </StackPanel>
        </Button>
        <!-- 活动：铃铛；有任务时外圈是总进度，有没看过的失败或请求时红点。Ctrl+J -->
        <Button x:Name="ActivityButton" Grid.Column="5" Classes="ghost icon-only" Command="{Binding Activity.ToggleCommand}" Margin="4,0,0,0"
                VerticalAlignment="Center" ToolTip.Tip="{Binding Activity.ActivityTip}" AutomationProperties.Name="{l:T activity.title}">
          <Panel Width="28" Height="28">
            <Arc Stroke="{DynamicResource Accent}" StrokeThickness="2" StartAngle="-90" SweepAngle="{Binding Activity.RingSweep}" Width="28" Height="28"
                 IsVisible="{Binding Activity.HasRunningTasks}" />
            <Path Classes="icon" Data="{StaticResource Icon.Bell}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Ellipse Width="8" Height="8" Fill="{DynamicResource Danger}" HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding Activity.HasAttention}" />
          </Panel>
        </Button>
      </Grid>
      <!-- 请求条（§6.22）：要你处理、有时限的事。多条时折叠成“N 件事等你处理 ▾” -->
      <StackPanel x:Name="RequestBar" Grid.Row="1" Margin="16,0,16,8" Spacing="6" IsVisible="{Binding Activity.HasRequests}">
        <ContentControl Content="{Binding Activity.FirstRequest}" />
        <Button Classes="ghost small" Command="{Binding Activity.ToggleRequestsCommand}" IsVisible="{Binding Activity.HasMoreRequests}" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{Binding Activity.MoreRequestsText}" />
            <Path Classes="icon sm" Data="{StaticResource Icon.ChevronDown}" Width="14" Height="14" />
          </StackPanel>
        </Button>
        <ItemsControl ItemsSource="{Binding Activity.Requests}" IsVisible="{Binding Activity.RequestsExpanded}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
      <!-- 入口里的子页：游戏库 = 游戏库 / 实例 / 新建实例 / 运行记录；设置 = 设置 / 工具 -->
      <ListBox x:Name="SubPageTabs" Grid.Row="2" Classes="subtabs" ItemsSource="{Binding Shell.SubPages}" SelectedItem="{Binding Shell.SelectedSubPage}"
               IsVisible="{Binding Shell.HasSubPages}" Background="Transparent" Margin="16,0,16,4"
               ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
               AutomationProperties.Name="{Binding Shell.Title}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:PageViewModel">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
              <Ellipse Width="6" Height="6" Fill="{DynamicResource Danger}" VerticalAlignment="Center" IsVisible="{Binding HasBadge}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <!-- 第一次打开新版：东西搬到哪了（可关闭） -->
      <Border x:Name="MovedNotice" Grid.Row="3" Classes="banner" Margin="16,0,16,8" IsVisible="False">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <Path Classes="icon" Data="{StaticResource Icon.Info}" Width="20" Height="20" VerticalAlignment="Top" />
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="{l:T shell.moved.title}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{l:T shell.moved.body}" TextWrapping="Wrap" Classes="hint" />
          </StackPanel>
          <Button x:Name="MovedNoticeClose" Grid.Column="2" Classes="ghost small" Content="{l:T shell.moved.ok}" VerticalAlignment="Top" Click="MovedNotice_Close" />
        </Grid>
      </Border>
      <ContentControl x:Name="PageHost" Grid.Row="4" Content="{Binding CurrentPage}" Margin="24,4,24,20" />

      <!-- 活动中心（§6.22）：盖在内容区右侧的抽屉 400，紧凑档全宽。Esc 或点外面关 -->
      <Panel x:Name="ActivityLayer" Grid.RowSpan="5" IsVisible="{Binding Activity.IsOpen}">
        <Border x:Name="ActivityScrim" Background="{DynamicResource Scrim}" Opacity="0.4" PointerPressed="ActivityScrim_Pressed" />
        <Border x:Name="ActivityDrawer" Width="400" HorizontalAlignment="Right" Background="{DynamicResource Overlay}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1,0,0,0" BoxShadow="{DynamicResource Elevation3}">
          <DockPanel Margin="16,12,16,16">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
              <TextBlock Text="{l:T activity.title}" FontSize="{DynamicResource FontSubtitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button x:Name="ActivityClose" Grid.Column="1" Classes="ghost icon-only" Command="{Binding Activity.CloseCommand}"
                      ToolTip.Tip="{l:T common.close}" AutomationProperties.Name="{l:T common.close}">
                <Path Classes="icon" Data="{StaticResource Icon.Close}" Width="18" Height="18" />
              </Button>
            </Grid>
            <ListBox x:Name="ActivityTabs" DockPanel.Dock="Top" Classes="subtabs" ItemsSource="{Binding Activity.TabOptions}" SelectedIndex="{Binding Activity.Tab}"
                     Background="Transparent" Margin="-4,0,0,8" ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="l:OptionItem"><TextBlock Text="{Binding Label}" /></DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
              <Button Classes="secondary small" Content="{l:T activity.clear_finished}" Command="{Binding Activity.ClearFinishedCommand}"
                      IsVisible="{Binding Activity.IsTasksTab}" IsEnabled="{Binding Activity.HasFinishedTasks}" />
              <Button Classes="secondary small" Content="{l:T activity.clear_notices}" Command="{Binding Activity.ClearNoticesCommand}"
                      IsVisible="{Binding Activity.IsNoticesTab}" IsEnabled="{Binding Activity.HasNotices}" />
            </StackPanel>
            <Panel>
              <!-- 进行中 -->
              <Panel IsVisible="{Binding Activity.IsTasksTab}">
                <TextBlock Classes="hint" Text="{l:T activity.empty.tasks}" IsVisible="{Binding !Activity.HasTasks}" Margin="0,8" TextWrapping="Wrap" />
                <ScrollViewer>
                  <ItemsControl x:Name="ActivityTaskList" ItemsSource="{Binding Activity.Tasks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:TaskItem">
                        <Border Classes="card" Padding="12" Margin="0,0,0,8">
                          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding Percent}" Maximum="100" IsIndeterminate="{Binding Indeterminate}"
                                         IsVisible="{Binding IsRunning}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="2" Text="{Binding Detail}" Classes="hint" Classes.error="{Binding IsFailed}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <Button Grid.Column="1" Classes="ghost small" Content="{l:T common.cancel}" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Panel>
              <!-- 通知 -->
              <Panel IsVisible="{Binding Activity.IsNoticesTab}">
                <TextBlock Classes="hint" Text="{l:T activity.empty.notices}" IsVisible="{Binding !Activity.HasNotices}" Margin="0,8" TextWrapping="Wrap" />
                <ScrollViewer>
                  <ItemsControl ItemsSource="{Binding Activity.Notices}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:NoticeItem">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,4">
                          <TextBlock Text="{Binding TimeText}" Classes="hint" FontSize="12" VerticalAlignment="Top" />
                          <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" Classes.error="{Binding IsError}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Panel>
              <!-- 运行记录 -->
              <Panel IsVisible="{Binding Activity.IsRunsTab}">
                <TextBlock Classes="hint" Text="{l:T activity.empty.runs}" IsVisible="{Binding !Activity.HasRuns}" Margin="0,8" TextWrapping="Wrap" />
                <ScrollViewer>
                  <ItemsControl ItemsSource="{Binding Activity.Runs}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:RunItem">
                        <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,4"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Activity.OpenCommand}" CommandParameter="{Binding}">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <StackPanel>
                              <TextBlock Text="{Binding Instance}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding StateText}" Classes="hint" Classes.error="{Binding IsCrash}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding StartedText}" Classes="hint" FontSize="12" VerticalAlignment="Top" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Panel>
            </Panel>
          </DockPanel>
        </Border>
      </Panel>
    </Grid>

    <!-- First-run wizard (§6.1): covers the whole shell, under the breaker countdown. -->
    <views:FirstRunWizard x:Name="FirstRunLayer" Grid.ColumnSpan="2" DataContext="{Binding FirstRun}" />

    <!-- Drag-and-drop import (§6.25): one to three big zones for what is being dragged. Zones sit in a row on wide
         windows and stack when compact. Dropping outside a zone does nothing. -->
    <Border x:Name="DropLayer" Grid.ColumnSpan="2" IsVisible="{Binding Drop.IsActive}" Background="{DynamicResource Scrim}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Margin="16">
        <ItemsControl x:Name="DropTargets" ItemsSource="{Binding Drop.Targets}" HorizontalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel x:Name="DropTargetsPanel" ItemSpacing="14" LineSpacing="14" HorizontalAlignment="Center" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:DropTarget">
              <Border Classes="card drop-target" Classes.hovered="{Binding IsHovered}" MinHeight="130" Padding="18">
                <StackPanel Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="{DynamicResource FontSubtitle}" TextWrapping="Wrap" TextAlignment="Center" />
                  <TextBlock Classes="hint" Text="{Binding Hint}" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Classes="card" IsVisible="{Binding Drop.HasNote}" MaxWidth="520" HorizontalAlignment="Center">
          <TextBlock x:Name="DropNote" Text="{Binding Drop.Note}" TextWrapping="Wrap" TextAlignment="Center" />
        </Border>
      </StackPanel>
    </Border>

    <!-- 熔断倒计时：盖住整个窗口，按空格或点按钮取消重启 -->
    <Border x:Name="BreakerOverlay" Grid.ColumnSpan="2" IsVisible="{Binding Multiplayer.IsBreakerCounting}" Background="{DynamicResource Scrim}">
      <Border Classes="card" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="{l:T multiplayer.breaker.title}" Margin="0" />
          <TextBlock Text="{Binding Multiplayer.BreakerReason}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Multiplayer.BreakerCountdownText}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
          <TextBlock Classes="hint" FontSize="12" Text="{l:T multiplayer.breaker.hint}" TextWrapping="Wrap" />
          <Button x:Name="BreakerCancel" Content="{l:T multiplayer.breaker.cancel}" Command="{Binding Multiplayer.CancelBreakerRestartCommand}" HorizontalAlignment="Right" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
