<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Amber.App.Localization"
        xmlns:vm="using:Amber.App.ViewModels"
        xmlns:views="using:Amber.App.Views"
        xmlns:c="using:Amber.App.Views.Controls"
        x:Class="Amber.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{l:T main.title}"
        Icon="/Assets/jay.ico"
        MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        xmlns:svc="using:Amber.App.Services"
        xmlns:safety="using:Amber.App.Controls.Safety">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:LibraryViewModel"><views:LibraryPage /></DataTemplate>
    <DataTemplate DataType="vm:AccountsViewModel"><views:AccountsPage /></DataTemplate>
    <DataTemplate DataType="vm:InstanceViewModel"><views:InstancePage /></DataTemplate>
    <DataTemplate DataType="vm:DownloadViewModel"><views:DownloadPage /></DataTemplate>
    <DataTemplate DataType="vm:ContentViewModel"><views:ContentPage /></DataTemplate>
    <DataTemplate DataType="vm:MultiplayerViewModel"><views:MultiplayerPage /></DataTemplate>

    <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsPage /></DataTemplate>
    <DataTemplate DataType="vm:AboutViewModel"><views:AboutPage /></DataTemplate>
    <DataTemplate DataType="vm:PeopleViewModel"><views:PeoplePage /></DataTemplate>
    <DataTemplate DataType="vm:HelpCenterViewModel"><views:HelpCenterPage /></DataTemplate>

    <!-- 请求条上的一条请求（§6.22）：安全类用锁定的安全横幅和安全按钮，其余用普通横幅 -->
    <DataTemplate DataType="vm:RequestItem">
      <Panel>
        <safety:SafetyBanner IsVisible="{Binding IsSafety}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Body}" IsVisible="{Binding HasBody}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding RemainingText}" IsVisible="{Binding HasRemaining}" FontSize="12" />
            </StackPanel>
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Buttons}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:RequestButton">
                  <safety:SafetyButton Content="{Binding Label}" Command="{Binding ChooseCommand}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </safety:SafetyBanner>
        <Border Classes="banner request" IsVisible="{Binding !IsSafety}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Path Classes="icon" Data="{StaticResource Icon.Bell}" Width="20" Height="20" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Body}" IsVisible="{Binding HasBody}" Classes="hint" TextWrapping="Wrap" />
              <TextBlock Text="{Binding RemainingText}" IsVisible="{Binding HasRemaining}" Classes="hint" />
            </StackPanel>
            <ItemsControl Grid.Column="2" ItemsSource="{Binding Buttons}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:RequestButton">
                  <Button Classes="small" Classes.secondary="{Binding !Choice.IsDefault}" Classes.primary="{Binding Choice.IsDefault}" Content="{Binding Label}" Command="{Binding ChooseCommand}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>
      </Panel>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid x:Name="ShellGrid" ColumnDefinitions="240,*">
    <!-- The theme's background picture (empty without one): the bottom layer, takes no clicks. -->
    <c:SlotImage x:Name="ThemeBackground" Grid.ColumnSpan="2" Slot="background" />
    <!-- 侧栏（官方设计 §2.1、§3.1）：品牌 → 三个一级入口 → 隐私行 → 设置 → 账号。展开 240，收成图标栏 76。 -->
    <Border x:Name="SidebarHost" Classes="sidebar">
      <Panel>
      <!-- The theme's sidebar picture, under the entries (empty without one). -->
      <c:SlotImage x:Name="ThemeSidebar" Slot="sidebar" />
      <Grid x:Name="SidebarGrid" RowDefinitions="Auto,*,Auto">
        <Button x:Name="SidebarHeader" Classes="ghost shell-brand" Command="{Binding Shell.GoSectionCommand}" CommandParameter="library"
                ToolTip.Tip="{Binding VersionText}" AutomationProperties.Name="Jay">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Image Source="/Assets/jay.png" Width="24" Height="24" Stretch="Uniform" />
            <TextBlock x:Name="BrandName" Text="Jay" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource SidebarText}" />
          </StackPanel>
        </Button>
        <ListBox x:Name="NavList" Grid.Row="1" Classes="nav" ItemsSource="{Binding Shell.Sections}" SelectedItem="{Binding Shell.SelectedSection}"
                 Background="Transparent" Margin="8,4" ClipToBounds="True" AutomationProperties.Name="{l:T shell.nav.label}">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
              <Setter Property="Margin" Value="0,1" />
              <Setter Property="Padding" Value="12,0" />
              <Setter Property="MinHeight" Value="40" />
              <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style Selector="ListBoxItem" x:DataType="vm:NavSection">
              <Setter Property="ToolTip.Tip" Value="{Binding ToolTip}" />
              <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            </Style>
            <!-- 图标栏：图标在上、短名在下 -->
            <Style Selector="ListBox.rail ListBoxItem">
              <Setter Property="Padding" Value="2,6" />
              <Setter Property="MinHeight" Value="52" />
              <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
            <Style Selector="StackPanel.nav-row">
              <Setter Property="Orientation" Value="Horizontal" />
              <Setter Property="Spacing" Value="12" />
            </Style>
            <Style Selector="ListBox.rail StackPanel.nav-row">
              <Setter Property="Orientation" Value="Vertical" />
              <Setter Property="Spacing" Value="2" />
              <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <Style Selector="ListBox.rail TextBlock.nav-title">
              <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="ListBox:not(.rail) TextBlock.nav-short">
              <Setter Property="IsVisible" Value="False" />
            </Style>
            <!-- 很矮的窗口：图标栏只留图标，短名放进提示 -->
            <Style Selector="ListBox.rail.tight TextBlock.nav-short">
              <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="ListBox.rail.tight ListBoxItem">
              <Setter Property="MinHeight" Value="40" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:NavSection">
              <Panel>
                <!-- Selected item: the wing bars on its left edge (two periods tall). Takes no room, so the icon stays put. -->
                <Border Classes="nav-indicator" Width="4" Height="26" CornerRadius="1" Margin="-10,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding IsActive}" />
                <StackPanel Classes="nav-row">
                  <Panel HorizontalAlignment="Center">
                    <Path Classes="icon" Data="{Binding Icon}" Stroke="{DynamicResource SidebarText}" Width="20" Height="20" />
                    <Border Classes="led error" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0"
                             IsVisible="{Binding HasBadge}" />
                  </Panel>
                  <TextBlock Classes="nav-title" Text="{Binding Title}" Foreground="{DynamicResource SidebarText}" FontSize="14" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="nav-short" Text="{Binding ShortTitle}" Foreground="{DynamicResource SidebarText}" FontSize="{DynamicResource FontCaption}"
                             HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="64" />
                </StackPanel>
              </Panel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <!-- 侧栏底部：隐私行（锁定，任何尺寸都看得见）、设置、账号 -->
        <StackPanel x:Name="SidebarFooter" Grid.Row="2" Margin="8,4,8,10" Spacing="2">
          <safety:PrivacyRow x:Name="PrivacyRow" Margin="8,4" />
          <Button x:Name="SettingsButton" Classes="ghost shell-foot" Command="{Binding Shell.OpenSettingsCommand}"
                  Classes.active="{Binding Shell.IsSettingsActive}" ToolTip.Tip="{l:T shell.settings_tip}" AutomationProperties.Name="{l:T shell.settings}">
            <StackPanel Classes="foot-row" Orientation="Horizontal" Spacing="12">
              <Panel>
                <Path Classes="icon" Data="{StaticResource Icon.Settings}" Stroke="{DynamicResource SidebarText}" Width="20" Height="20" />
                <Border Classes="led error" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0"
                         IsVisible="{Binding Shell.HasSettingsBadge}" />
              </Panel>
              <TextBlock Classes="foot-title" Text="{l:T shell.settings}" Foreground="{DynamicResource SidebarText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Button>
          <!-- "Me": game accounts, Jay account, my friend code, my devices, light/dark and language. -->
          <Button x:Name="AccountButton" Classes="ghost shell-foot" Command="{Binding Shell.OpenMeCommand}"
                  Classes.active="{Binding Shell.IsMeActive}" ToolTip.Tip="{l:T shell.me_tip}" AutomationProperties.Name="{l:T me.title}">
            <StackPanel Classes="foot-row" Orientation="Horizontal" Spacing="12">
              <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource AccentTint}">
                <TextBlock Text="{Binding Shell.AccountInitial}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Classes="foot-title" Text="{Binding Shell.AccountName}" Foreground="{DynamicResource SidebarText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
      </Panel>
    </Border>

    <!-- Content column: top bar, request bar, "where things moved", page -->
    <Grid x:Name="ContentColumn" Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
      <!-- 顶栏（§3.1）：← 返回 + 标题或面包屑；带上下文跳过来时有【完成，返回】 -->
      <Grid x:Name="TopBar" Height="48" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto" Margin="8,0,16,0">
        <!-- Shown only when there is somewhere to go back to: on a section's first page it would be a button that does nothing. -->
        <Button x:Name="BackButton" Classes="ghost icon-only" Command="{Binding Shell.BackCommand}" IsVisible="{Binding Shell.CanGoBack}"
                ToolTip.Tip="{l:T shell.back_tip}" AutomationProperties.Name="{l:T shell.back}" VerticalAlignment="Center">
          <Path Classes="icon" Data="{StaticResource Icon.ChevronLeft}" Width="20" Height="20" />
        </Button>
        <Button x:Name="ForwardButton" Grid.Column="1" Classes="ghost icon-only" Command="{Binding Shell.ForwardCommand}" IsVisible="{Binding Shell.CanGoForward}"
                ToolTip.Tip="{l:T shell.forward_tip}" AutomationProperties.Name="{l:T shell.forward}" VerticalAlignment="Center">
          <Path Classes="icon" Data="{StaticResource Icon.ChevronRight}" Width="20" Height="20" />
        </Button>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" VerticalAlignment="Center">
          <!-- Breadcrumb: on library/{instance} and library/new the section name is a way back and the page's name follows it -->
          <Button x:Name="CrumbHome" Classes="ghost small" Content="{Binding Shell.Title}" Command="{Binding Shell.GoSectionHomeCommand}"
                  IsVisible="{Binding Shell.HasCrumb}" VerticalAlignment="Center" Margin="-8,0,-6,0" />
          <Path x:Name="CrumbSeparator" Classes="icon sm" Data="{StaticResource Icon.ChevronRight}" Width="14" Height="14" Opacity="0.6"
                IsVisible="{Binding Shell.HasCrumb}" VerticalAlignment="Center" />
          <TextBlock x:Name="ShellTitle" Text="{Binding Shell.Heading}" FontSize="{DynamicResource FontSubtitle}" FontWeight="SemiBold"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Shell.ReturnLabel}" IsVisible="{Binding Shell.HasReturn}" Classes="hint" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Column="3" Classes="secondary small" Content="{l:T shell.return_done}" Command="{Binding Shell.ReturnCommand}"
                IsVisible="{Binding Shell.HasReturn}" VerticalAlignment="Center" />
        <!-- Network status, on every page: which networks Jay is using now. The panel lists each one with what it can do. -->
        <Button x:Name="NetworkButton" Grid.Column="4" Classes="ghost small net-status" Margin="8,0,0,0" VerticalAlignment="Center"
                ToolTip.Tip="{Binding Shell.Network.Tip}" AutomationProperties.Name="{Binding Shell.Network.Tip}">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <Border DataContext="{Binding Shell.Network}">
                <StackPanel x:Name="NetworkPanel" Width="340" Spacing="8" x:DataType="vm:NetworkStatusViewModel">
                  <TextBlock Text="{l:T shell.network.title}" FontWeight="SemiBold" />
                  <ItemsControl x:Name="NetworkRows" ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:NetworkStatusRow">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                          <Border Classes="led" Classes.online="{Binding IsOn}" Classes.busy="{Binding IsConnecting}" Classes.off="{Binding IsOff}"
                                  VerticalAlignment="Top" Margin="0,6,0,0" />
                          <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Tip}" />
                            <TextBlock Classes="hint" FontSize="12" Text="{Binding TrustText}" Classes.warn="{Binding IsUnreviewed}" TextWrapping="Wrap" />
                            <TextBlock Classes="hint" FontSize="12" Text="{Binding CanText}" TextWrapping="Wrap" />
                            <TextBlock Classes="hint" FontSize="12" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" TextWrapping="Wrap" />
                          </StackPanel>
                          <ToggleSwitch Grid.Column="2" Classes="compact" IsChecked="{Binding Wanted}"
                                        OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Top" IsVisible="{Binding CanSwitch}"
                                        AutomationProperties.Name="{Binding SwitchName}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock x:Name="NetworkEmptyNote" Classes="hint" FontSize="12" Text="{l:T shell.network.empty}" IsVisible="{Binding ShowEmptyNote}" TextWrapping="Wrap" />
                  <TextBlock x:Name="NetworkChildNote" Classes="hint" FontSize="12" Text="{l:T shell.network.child}" IsVisible="{Binding IsChildMode}" TextWrapping="Wrap" />
                  <Separator Margin="0,2" />
                  <WrapPanel ItemSpacing="8" LineSpacing="6">
                    <Button x:Name="NetworkAdd" Classes="secondary small" Content="{l:T shell.network.add}" Command="{Binding AddNetworkCommand}"
                            IsVisible="{Binding CanAddNetworks}" />
                    <Button x:Name="NetworkSettings" Classes="ghost small" Command="{Binding OpenSettingsCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="2">
                        <TextBlock Text="{l:T shell.network.settings}" VerticalAlignment="Center" />
                        <Path Classes="icon sm" Data="{StaticResource Icon.ChevronRight}" Width="14" Height="14" />
                      </StackPanel>
                    </Button>
                  </WrapPanel>
                </StackPanel>
              </Border>
            </Flyout>
          </Button.Flyout>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Border x:Name="NetworkLight" Classes="led" Classes.online="{Binding Shell.Network.IsOn}" Classes.busy="{Binding Shell.Network.IsConnecting}"
                    Classes.off="{Binding Shell.Network.IsOff}" VerticalAlignment="Center" />
            <TextBlock x:Name="NetworkText" Text="{Binding Shell.Network.StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180" />
          </StackPanel>
        </Button>
        <!-- 正在玩胶囊：有游戏准备中、运行中或刚崩溃时才出现；点它去游戏库 -->
        <!-- In a call (reserved): a chip beside the playing pill; it goes back to the page that holds the call panel. -->
        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="CallChip" Classes="pill-play" Command="{Binding Call.OpenPanelCommand}" IsVisible="{Binding Call.IsInCall}" Margin="8,0,0,0"
                VerticalAlignment="Center" ToolTip.Tip="{Binding Call.ChipText}" AutomationProperties.Name="{Binding Call.ChipText}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Border Classes="led online" />
            <TextBlock Text="{Binding Call.ChipText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180" />
          </StackPanel>
        </Button>
        <Button x:Name="PlayingPill" Classes="pill-play" Classes.crash="{Binding Activity.PillIsCrash}" Command="{Binding Activity.OpenPillCommand}"
                IsVisible="{Binding Activity.HasPill}" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip.Tip="{Binding Activity.PillText}"
                AutomationProperties.Name="{Binding Activity.PillText}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Border Classes="led playing" />
            <TextBlock Text="{Binding Activity.PillText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220" />
          </StackPanel>
        </Button>
        </StackPanel>
        <!-- 活动：铃铛；有任务时外圈是总进度，有没看过的失败或请求时红点。Ctrl+J -->
        <Button x:Name="ActivityButton" Grid.Column="6" Classes="ghost icon-only" Command="{Binding Activity.ToggleCommand}" Margin="4,0,0,0"
                VerticalAlignment="Center" ToolTip.Tip="{Binding Activity.ActivityTip}" AutomationProperties.Name="{l:T activity.title}">
          <Panel Width="28" Height="28">
            <Arc Stroke="{DynamicResource Accent}" StrokeThickness="2" StartAngle="-90" SweepAngle="{Binding Activity.RingSweep}" Width="28" Height="28"
                 IsVisible="{Binding Activity.HasRunningTasks}" />
            <Path Classes="icon" Data="{StaticResource Icon.Bell}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border Classes="led error" HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding Activity.HasAttention}" />
          </Panel>
        </Button>
        <!-- Help: this page's article in a drawer. F1; Shift+F1 opens the help center -->
        <Button x:Name="HelpButton" Grid.Column="7" Classes="ghost icon-only" Command="{Binding OpenHelpCommand}" Margin="4,0,0,0"
                VerticalAlignment="Center" ToolTip.Tip="{l:T help.button_tip}" AutomationProperties.Name="{l:T help.title}">
          <Path Classes="icon" Data="{StaticResource Icon.Help}" Width="18" Height="18" />
        </Button>
      </Grid>
      <!-- 请求条（§6.22）：要你处理、有时限的事。多条时折叠成“N 件事等你处理 ▾” -->
      <StackPanel x:Name="RequestBar" Grid.Row="1" Margin="16,0,16,8" Spacing="6" IsVisible="{Binding Activity.HasRequests}">
        <ContentControl Content="{Binding Activity.FirstRequest}" />
        <Button Classes="ghost small" Command="{Binding Activity.ToggleRequestsCommand}" IsVisible="{Binding Activity.HasMoreRequests}" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{Binding Activity.MoreRequestsText}" />
            <Path Classes="icon sm" Data="{StaticResource Icon.ChevronDown}" Width="14" Height="14" />
          </StackPanel>
        </Button>
        <ItemsControl ItemsSource="{Binding Activity.Requests}" IsVisible="{Binding Activity.RequestsExpanded}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
      <!-- Someone controls this computer during a call (reserved): the locked red bar, with [Stop] and Ctrl+Shift+F12. -->
      <safety:SafetyBanner x:Name="CallControlBar" Grid.Row="2" Classes="remote" Margin="16,0,16,8" IsVisible="{Binding Call.IsControlled}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock x:Name="CallControlText" Text="{Binding Call.ControlBarText}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
          <safety:SafetyButton x:Name="CallControlStop" Grid.Column="1" Kind="Safe" Content="{l:T call.control.stop}" Command="{Binding Call.StopControlCommand}" />
        </Grid>
      </safety:SafetyBanner>
      <!-- 第一次打开新版：东西搬到哪了（可关闭） -->
      <StackPanel Grid.Row="3">
      <Border x:Name="MovedNotice" Classes="banner" Margin="16,0,16,8" IsVisible="False">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <Path Classes="icon" Data="{StaticResource Icon.Info}" Width="20" Height="20" VerticalAlignment="Top" />
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock x:Name="MovedNoticeTitle" Text="{l:T shell.moved.title}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxWidth="720" HorizontalAlignment="Left" />
            <TextBlock x:Name="MovedNoticeBody" Text="{l:T shell.moved.body}" TextWrapping="Wrap" Classes="hint" MaxWidth="720" HorizontalAlignment="Left" />
          </StackPanel>
          <Button x:Name="MovedNoticeClose" Grid.Column="2" Classes="ghost small" Content="{l:T shell.moved.ok}" VerticalAlignment="Top" Click="MovedNotice_Close" />
        </Grid>
      </Border>
      <!-- Contextual tip on short windows, or when it has nothing to point at (§9.3 rule 5): one line, read out politely. -->
      <Border x:Name="TipBar" Classes="banner" Margin="16,0,16,8" Padding="12,6" IsVisible="False">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
          <Path Classes="icon" Data="{StaticResource Icon.Info}" Width="18" Height="18" VerticalAlignment="Center" />
          <TextBlock x:Name="TipBarText" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
          <Button x:Name="TipBarMute" Grid.Column="2" Classes="ghost small" Content="{l:T tip.mute}" VerticalAlignment="Center" Click="TipMute_Click" />
          <Button x:Name="TipBarOk" Grid.Column="3" Classes="ghost small" Content="{l:T tip.ok}" VerticalAlignment="Center" Click="TipOk_Click" />
        </Grid>
      </Border>
      </StackPanel>
      <!-- Contextual tip bubble (Coachmark, §5): up to 320 wide, with an arrow, next to what it explains. It never takes focus. -->
      <Popup x:Name="TipPopup" Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="False" Focusable="False">
        <StackPanel>
          <Path x:Name="TipArrow" Data="M 0,8 L 8,0 L 16,8 Z" Fill="{DynamicResource Overlay}" Stroke="{DynamicResource BorderSubtle}" StrokeThickness="1"
                Margin="16,0,0,-1" HorizontalAlignment="Left" />
          <Border Background="{DynamicResource Overlay}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,10" MaxWidth="320">
            <StackPanel Spacing="8">
              <TextBlock x:Name="TipBubbleText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
              <WrapPanel ItemSpacing="8" LineSpacing="4" HorizontalAlignment="Right">
                <Button x:Name="TipBubbleMute" Classes="ghost small" Content="{l:T tip.mute}" Click="TipMute_Click" />
                <Button x:Name="TipBubbleOk" Classes="secondary small" Content="{l:T tip.ok}" Click="TipOk_Click" />
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Popup>
      <!-- The theme's mascot in a corner of the content area, behind the page: it shows where the page leaves room. -->
      <c:SlotImage x:Name="ThemeMascot" Grid.Row="4" Slot="mascot" />
      <ContentControl x:Name="PageHost" Grid.Row="4" Content="{Binding CurrentPage}" Margin="24,4,24,20" />

      <!-- Docked game log (§6.9): Ctrl+` docks the running game's log at the bottom, 240 high and draggable; in a short
           window it becomes a drawer over the page. It can pop out into its own window. The log view inside is built the
           first time the log is docked (MainWindow.Shell.cs), not on every start. -->
      <Thumb x:Name="LogDockSplitter" Grid.Row="5" Height="6" Background="Transparent" Cursor="SizeNorthSouth" IsVisible="False"
             AutomationProperties.Name="{l:T log.dock.resize}">
        <Thumb.Template><ControlTemplate><Border Background="{TemplateBinding Background}" /></ControlTemplate></Thumb.Template>
      </Thumb>
      <Border x:Name="LogDock" Grid.Row="6" Height="240" IsVisible="False" Background="{DynamicResource Surface}"
              BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="16,8,16,8" />

      <!-- Help drawer (§6.24): 400 on the right, full width when compact. Esc or a click outside closes it -->
      <c:LazyHost x:Name="HelpHost" Grid.RowSpan="7" IsOpen="{Binding Help.IsOpen}" IsVisible="{Binding Help.IsOpen}">
        <Template x:DataType="vm:MainViewModel">
            <Panel x:Name="HelpLayerPart">
              <Border x:Name="HelpScrimPart" Background="{DynamicResource Scrim}" Opacity="0.4" PointerPressed="HelpScrim_Pressed" />
              <Border x:Name="HelpDrawerPart" Width="400" HorizontalAlignment="Right" Background="{DynamicResource Overlay}"
                      BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1,0,0,0" BoxShadow="{DynamicResource Elevation3}">
                <DockPanel Margin="16,12,16,16">
                  <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock x:Name="HelpHeaderPart" Text="{Binding Help.Header}" FontSize="{DynamicResource FontSubtitle}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="HelpClosePart" Grid.Column="1" Classes="ghost icon-only" Command="{Binding Help.CloseCommand}"
                            ToolTip.Tip="{l:T common.close}" AutomationProperties.Name="{l:T common.close}">
                      <Path Classes="icon" Data="{StaticResource Icon.Close}" Width="18" Height="18" />
                    </Button>
                  </Grid>
                  <TextBox x:Name="HelpDrawerSearchPart" DockPanel.Dock="Top" Text="{Binding Help.Query}" PlaceholderText="{l:T help.search}" Margin="0,0,0,10" />
                  <Button x:Name="HelpCenterLinkPart" DockPanel.Dock="Bottom" Classes="ghost" Content="{l:T help.open_center}" Command="{Binding Help.OpenCenterCommand}"
                          HorizontalAlignment="Left" Padding="0,4" Margin="0,8,0,0" />
                  <ScrollViewer x:Name="HelpScrollPart" HorizontalScrollBarVisibility="Disabled">
                    <Panel Margin="0,0,14,0">
                      <views:HelpArticleBody x:Name="HelpArticlePart" DataContext="{Binding Help.Article}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).Help.ShowArticle}"
                                             LinkCommand="{Binding $parent[Window].((vm:MainViewModel)DataContext).Help.FollowLinkCommand}"
                                             ArticleCommand="{Binding $parent[Window].((vm:MainViewModel)DataContext).Help.OpenArticleCommand}" />
                      <StackPanel Spacing="4" IsVisible="{Binding Help.HasQuery}">
                        <TextBlock x:Name="HelpNoResultsPart" Classes="hint" Text="{l:T help.search.empty}" IsVisible="{Binding Help.NoResults}" TextWrapping="Wrap" />
                        <ItemsControl x:Name="HelpResultsPart" ItemsSource="{Binding Help.Results}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:HelpArticleItem">
                              <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6"
                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Help.OpenArticleCommand}" CommandParameter="{Binding}">
                                <StackPanel Spacing="2">
                                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                  <TextBlock Text="{Binding Summary}" Classes="hint" FontSize="12" TextWrapping="Wrap" MaxLines="2" />
                                </StackPanel>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Panel>
                  </ScrollViewer>
                </DockPanel>
              </Border>
            </Panel>
        </Template>
      </c:LazyHost>

      <!-- "Send a file" (batch 12): what and to whom, a drawer over the content like Activity. Esc closes. -->
      <c:LazyHost x:Name="SendFileHost" Grid.RowSpan="7" IsOpen="{Binding Multiplayer.SendPanel.IsOpen}" IsVisible="{Binding Multiplayer.SendPanel.IsOpen}">
        <Template x:DataType="vm:MainViewModel">
            <Panel x:Name="SendFileLayerPart" DataContext="{Binding Multiplayer.SendPanel}" x:DataType="vm:SendFileViewModel">
              <Border Background="{DynamicResource Scrim}" Opacity="0.4" PointerPressed="SendFileScrim_Pressed" />
              <Border x:Name="SendFileDrawerPart" Width="440" HorizontalAlignment="Right" Background="{DynamicResource Overlay}"
                      BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1,0,0,0" BoxShadow="{DynamicResource Elevation3}" KeyDown="SendFile_KeyDown">
                <DockPanel Margin="16,12,16,16">
                  <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <TextBlock Text="{l:T files.panel.title}" FontSize="{DynamicResource FontSubtitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button x:Name="SendFileClosePart" Grid.Column="1" Classes="ghost icon-only" Command="{Binding CloseCommand}"
                            ToolTip.Tip="{l:T common.close}" AutomationProperties.Name="{l:T common.close}">
                      <Path Classes="icon" Data="{StaticResource Icon.Close}" Width="18" Height="18" />
                    </Button>
                  </Grid>
                  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
                    <Button Classes="secondary" Content="{l:T common.cancel}" Command="{Binding CloseCommand}" />
                    <Button x:Name="SendFileSendPart" Classes="primary" Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Classes="icon sm" Data="{StaticResource Icon.Send}" />
                        <TextBlock Text="{l:T files.panel.send}" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                  <ScrollViewer>
                    <StackPanel Spacing="10">
                      <TextBlock Text="{l:T files.panel.what}" FontWeight="SemiBold" />
                      <ComboBox x:Name="SendFileKindPart" ItemsSource="{Binding KindOptions}" SelectedIndex="{Binding KindIndex}" HorizontalAlignment="Stretch"
                                AutomationProperties.Name="{l:T files.panel.what}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate DataType="l:OptionItem"><TextBlock Text="{Binding Label}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <Button x:Name="SendFilePickPart" Classes="secondary" Command="{Binding PickCommand}" IsVisible="{Binding UsesPicker}" HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding PickText}" TextTrimming="CharacterEllipsis" />
                      </Button>
                      <ListBox x:Name="SendFileCandidatesPart" ItemsSource="{Binding Candidates}" SelectedItem="{Binding Candidate}" IsVisible="{Binding UsesList}"
                               MaxHeight="220" AutomationProperties.Name="{l:T files.panel.what}">
                        <ListBox.ItemTemplate>
                          <DataTemplate DataType="vm:SendCandidate">
                            <StackPanel Spacing="1">
                              <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Classes="caption" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                      <TextBlock Classes="hint" FontSize="12" Text="{l:T files.panel.none}" IsVisible="{Binding HasNoCandidates}" TextWrapping="Wrap" />
                      <TextBlock x:Name="SendFileNotePart" Classes="hint" FontSize="12" Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" />

                      <TextBlock Text="{l:T files.panel.whom}" FontWeight="SemiBold" Margin="0,6,0,0" />
                      <ListBox x:Name="SendFileRecipientsPart" ItemsSource="{Binding Recipients}" SelectedItem="{Binding Recipient}" MaxHeight="220"
                               AutomationProperties.Name="{l:T files.panel.whom}">
                        <ListBox.ItemTemplate>
                          <DataTemplate DataType="vm:SendRecipientItem">
                            <StackPanel Spacing="1">
                              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Classes="caption" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                      <TextBlock Classes="hint" FontSize="12" Text="{l:T files.panel.nobody}" IsVisible="{Binding HasNoRecipients}" TextWrapping="Wrap" />
                      <TextBlock x:Name="SendFileLimitPart" Classes="hint" FontSize="12" Text="{Binding LimitNote}" IsVisible="{Binding HasLimitNote}" TextWrapping="Wrap" />
                      <TextBlock Classes="hint" FontSize="12" Text="{l:T files.panel.privacy}" TextWrapping="Wrap" />
                    </StackPanel>
                  </ScrollViewer>
                </DockPanel>
              </Border>
            </Panel>
        </Template>
      </c:LazyHost>

      <!-- 活动中心（§6.22）：盖在内容区右侧的抽屉 400，紧凑档全宽。Esc 或点外面关 -->
      <c:LazyHost x:Name="ActivityHost" Grid.RowSpan="7" IsOpen="{Binding Activity.IsOpen}" IsVisible="{Binding Activity.IsOpen}">
        <Template x:DataType="vm:MainViewModel">
            <Panel x:Name="ActivityLayerPart">
              <Border x:Name="ActivityScrimPart" Background="{DynamicResource Scrim}" Opacity="0.4" PointerPressed="ActivityScrim_Pressed" />
              <Border x:Name="ActivityDrawerPart" Width="400" HorizontalAlignment="Right" Background="{DynamicResource Overlay}"
                      BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1,0,0,0" BoxShadow="{DynamicResource Elevation3}">
                <DockPanel Margin="16,12,16,16">
                  <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="{l:T activity.title}" FontSize="{DynamicResource FontSubtitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button x:Name="ActivityClosePart" Grid.Column="1" Classes="ghost icon-only" Command="{Binding Activity.CloseCommand}"
                            ToolTip.Tip="{l:T common.close}" AutomationProperties.Name="{l:T common.close}">
                      <Path Classes="icon" Data="{StaticResource Icon.Close}" Width="18" Height="18" />
                    </Button>
                  </Grid>
                  <ListBox x:Name="ActivityTabsPart" DockPanel.Dock="Top" Classes="subtabs" ItemsSource="{Binding Activity.TabOptions}" SelectedIndex="{Binding Activity.Tab}"
                           Background="Transparent" Margin="-4,0,0,8" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="l:OptionItem"><TextBlock Text="{Binding Label}" /></DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Classes="secondary small" Content="{l:T activity.clear_finished}" Command="{Binding Activity.ClearFinishedCommand}"
                            IsVisible="{Binding Activity.IsTasksTab}" IsEnabled="{Binding Activity.HasFinishedTasks}" />
                    <Button Classes="secondary small" Content="{l:T activity.clear_notices}" Command="{Binding Activity.ClearNoticesCommand}"
                            IsVisible="{Binding Activity.IsNoticesTab}" IsEnabled="{Binding Activity.HasNotices}" />
                  </StackPanel>
                  <Panel>
                    <!-- 进行中 -->
                    <Panel IsVisible="{Binding Activity.IsTasksTab}">
                      <TextBlock Classes="hint" Text="{l:T activity.empty.tasks}" IsVisible="{Binding !Activity.HasTasks}" Margin="0,8" TextWrapping="Wrap" />
                      <ScrollViewer>
                        <ItemsControl x:Name="ActivityTaskListPart" ItemsSource="{Binding Activity.Tasks}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:TaskItem">
                              <Border Classes="card" Padding="12" Margin="0,0,0,8">
                                <Panel>
                                  <!-- Running: the one progress line. Finished: the name and how it ended. -->
                                  <c:ProgressLine Title="{Binding Title}" Step="{Binding Step}" Percent="{Binding Percent}" IsIndeterminate="{Binding Indeterminate}"
                                                  BytesPerSecond="{Binding Speed}" Remaining="{Binding Remaining}"
                                                  CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancel}" IsVisible="{Binding IsRunning}" />
                                  <StackPanel Spacing="4" IsVisible="{Binding !IsRunning}">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                    <TextBlock Text="{Binding Detail}" Classes="hint" Classes.error="{Binding IsFailed}" TextWrapping="Wrap" />
                                  </StackPanel>
                                </Panel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Panel>
                    <!-- 通知 -->
                    <Panel IsVisible="{Binding Activity.IsNoticesTab}">
                      <TextBlock Classes="hint" Text="{l:T activity.empty.notices}" IsVisible="{Binding !Activity.HasNotices}" Margin="0,8" TextWrapping="Wrap" />
                      <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Activity.Notices}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:NoticeItem">
                              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,4">
                                <TextBlock Text="{Binding TimeText}" Classes="hint" FontSize="12" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" Classes.error="{Binding IsError}" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Panel>
                    <!-- 运行记录 -->
                    <Panel IsVisible="{Binding Activity.IsRunsTab}">
                      <TextBlock Classes="hint" Text="{l:T activity.empty.runs}" IsVisible="{Binding !Activity.HasRuns}" Margin="0,8" TextWrapping="Wrap" />
                      <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Activity.Runs}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:RunItem">
                              <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,4"
                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Activity.OpenCommand}" CommandParameter="{Binding}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                  <StackPanel>
                                    <TextBlock Text="{Binding Instance}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding StateText}" Classes="hint" Classes.error="{Binding IsCrash}" />
                                  </StackPanel>
                                  <TextBlock Grid.Column="1" Text="{Binding StartedText}" Classes="hint" FontSize="12" VerticalAlignment="Top" />
                                </Grid>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Panel>
                  </Panel>
                </DockPanel>
              </Border>
            </Panel>
        </Template>
      </c:LazyHost>
    </Grid>

    <!-- First-run wizard (§6.1): covers the whole shell, under the breaker countdown. -->
    <c:LazyHost x:Name="FirstRunHost" Grid.ColumnSpan="2" IsOpen="{Binding FirstRun.IsOpen}" IsVisible="{Binding FirstRun.IsOpen}">
      <Template x:DataType="vm:MainViewModel">
          <views:FirstRunWizard x:Name="FirstRunLayerPart" DataContext="{Binding FirstRun}" />
      </Template>
    </c:LazyHost>

    <!-- Drag-and-drop import (§6.25): one to three big zones for what is being dragged. Zones sit in a row on wide
         windows and stack when compact. Dropping outside a zone does nothing. -->
    <c:LazyHost x:Name="DropHost" Grid.ColumnSpan="2" IsOpen="{Binding Drop.IsActive}" IsVisible="{Binding Drop.IsActive}">
      <Template x:DataType="vm:MainViewModel">
          <Border x:Name="DropLayerPart" Background="{DynamicResource Scrim}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Margin="16">
              <ItemsControl x:Name="DropTargetsPart" ItemsSource="{Binding Drop.Targets}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel x:Name="DropTargetsPanelPart" ItemSpacing="14" LineSpacing="14" HorizontalAlignment="Center" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:DropTarget">
                    <Border Classes="card drop-target" Classes.hovered="{Binding IsHovered}" MinHeight="130" Padding="18">
                      <StackPanel Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="{DynamicResource FontSubtitle}" TextWrapping="Wrap" TextAlignment="Center" />
                        <TextBlock Classes="hint" Text="{Binding Hint}" TextWrapping="Wrap" TextAlignment="Center" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Classes="card" IsVisible="{Binding Drop.HasNote}" MaxWidth="520" HorizontalAlignment="Center">
                <TextBlock x:Name="DropNotePart" Text="{Binding Drop.Note}" TextWrapping="Wrap" TextAlignment="Center" />
              </Border>
            </StackPanel>
          </Border>
      </Template>
    </c:LazyHost>

    <!-- Command palette (§6.23): Ctrl+K. 640 wide, top centre, at most 480 high; full width when compact. -->
    <c:LazyHost x:Name="PaletteHost" Grid.ColumnSpan="2" IsOpen="{Binding Palette.IsOpen}" IsVisible="{Binding Palette.IsOpen}">
      <Template x:DataType="vm:MainViewModel">
          <Panel x:Name="PaletteLayerPart">
            <Border x:Name="PaletteScrimPart" Background="{DynamicResource Scrim}" Opacity="0.4" PointerPressed="PaletteScrim_Pressed" />
            <Border x:Name="PalettePanelPart" Width="640" MaxHeight="480" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,64,16,16"
                    Background="{DynamicResource Overlay}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="10"
                    BoxShadow="{DynamicResource Elevation3}" Padding="0,0,0,8">
              <DockPanel>
                <TextBox x:Name="PaletteBoxPart" DockPanel.Dock="Top" Text="{Binding Palette.Query}" PlaceholderText="{Binding Palette.Placeholder}"
                         Margin="12,12,12,6" FontSize="{DynamicResource FontSubtitle}" />
                <TextBlock x:Name="PalettePickingPart" DockPanel.Dock="Top" Text="{Binding Palette.PickingText}" IsVisible="{Binding Palette.IsPicking}"
                           Classes="hint" Margin="16,0,16,6" TextWrapping="Wrap" />
                <TextBlock x:Name="PaletteRecentPart" DockPanel.Dock="Top" Text="{l:T palette.recent}" IsVisible="{Binding Palette.ShowsRecent}"
                           Classes="hint" FontSize="12" Margin="16,0,16,4" />
                <TextBlock x:Name="PaletteHintPart" DockPanel.Dock="Bottom" Text="{l:T palette.hint}" Classes="hint" FontSize="12" Margin="16,6,16,0" TextWrapping="Wrap" />
                <TextBlock x:Name="PaletteEmptyPart" DockPanel.Dock="Top" Text="{l:T palette.empty}" IsVisible="{Binding Palette.IsEmpty}"
                           Classes="hint" Margin="16,8" TextWrapping="Wrap" />
                <ListBox x:Name="PaletteListPart" ItemsSource="{Binding Palette.Results}" SelectedIndex="{Binding Palette.SelectedIndex}"
                         Background="Transparent" Margin="6,0" Focusable="False" Tapped="PaletteList_Tapped">
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                      <Setter Property="Padding" Value="10,4" />
                      <Setter Property="CornerRadius" Value="6" />
                    </Style>
                  </ListBox.Styles>
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:PaletteEntry">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinHeight="32">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" Classes="hint" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding KindText}" Classes="hint" FontSize="12" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>
          </Panel>
      </Template>
    </c:LazyHost>

    <!-- 熔断倒计时：盖住整个窗口，按空格或点按钮取消重启 -->
    <!-- Sharing the screen (reserved): a red frame round the whole window; it never takes a click. -->
    <Border x:Name="CallShareFrame" Grid.ColumnSpan="2" BorderThickness="3" BorderBrush="#B3261E" IsHitTestVisible="False" IsVisible="{Binding Call.Sharing}" />
    <c:LazyHost x:Name="BreakerHost" Grid.ColumnSpan="2" IsOpen="{Binding Multiplayer.IsBreakerCounting}" IsVisible="{Binding Multiplayer.IsBreakerCounting}">
      <Template x:DataType="vm:MainViewModel">
          <Border x:Name="BreakerOverlayPart" Background="{DynamicResource Scrim}">
            <Border Classes="card" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
              <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="{l:T multiplayer.breaker.title}" Margin="0" />
                <TextBlock Text="{Binding Multiplayer.BreakerReason}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Multiplayer.BreakerCountdownText}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                <TextBlock Classes="hint" FontSize="12" Text="{l:T multiplayer.breaker.hint}" TextWrapping="Wrap" />
                <Button x:Name="BreakerCancelPart" Content="{l:T multiplayer.breaker.cancel}" Command="{Binding Multiplayer.CancelBreakerRestartCommand}" HorizontalAlignment="Right" />
              </StackPanel>
            </Border>
          </Border>
      </Template>
    </c:LazyHost>
  </Grid>
</Window>
