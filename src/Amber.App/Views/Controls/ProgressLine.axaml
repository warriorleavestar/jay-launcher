<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Amber.App.Localization"
             x:Class="Amber.App.Views.Controls.ProgressLine"
             x:Name="Root">
  <!--
    The one progress line (design: "one kind of progress"): name, current step, percent, speed, time left, [Cancel].
    Game files, Java, loaders, mods, modpacks, the multiplayer component and Jay updates all use it, in the page that
    started the work and in the activity drawer. Parts with nothing to say take no room.
  -->
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
      <TextBlock x:Name="TitleText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="FactsText" Grid.Column="1" Classes="hint" VerticalAlignment="Center" />
      <ProgressBar x:Name="Bar" Grid.Row="1" Grid.ColumnSpan="2" Maximum="100" Margin="0,6,0,0" />
      <TextBlock x:Name="StepText" Grid.Row="2" Grid.ColumnSpan="2" Classes="hint" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                 AutomationProperties.LiveSetting="Polite" />
    </Grid>
    <Button x:Name="CancelButton" Grid.Column="1" Classes="secondary" Content="{l:T common.cancel}" VerticalAlignment="Center" IsVisible="False" />
  </Grid>
</UserControl>
