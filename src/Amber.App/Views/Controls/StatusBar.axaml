<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Amber.App.Localization"
             x:Class="Amber.App.Views.Controls.StatusBar"
             x:Name="Root">
  <!--
    共享状态条（改版规格 5.2）：图标 + 文字，按级别着色；最多 3 行，ToolTip 是全文；有详情时显示【详情】，
    里面能选中、能复制；右边一直有 ✕ 可以关掉；成功几秒后自动消失、警告稍久一点，鼠标停在上面或详情打开时不消失；
    错误和进行中的信息一直留着直到关掉或被下一条换掉；没有消息时不占高度。
  -->
  <UserControl.Styles>
    <Style Selector="Border#Bar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Border#Bar.success"><Setter Property="Background" Value="{DynamicResource SuccessTint}" /></Style>
    <Style Selector="Border#Bar.warning"><Setter Property="Background" Value="{DynamicResource WarningTint}" /></Style>
    <Style Selector="Border#Bar.error"><Setter Property="Background" Value="{DynamicResource DangerTint}" /></Style>
    <Style Selector="Border#Bar.success TextBlock#Icon"><Setter Property="Foreground" Value="{DynamicResource SuccessText}" /></Style>
    <Style Selector="Border#Bar.warning TextBlock#Icon"><Setter Property="Foreground" Value="{DynamicResource WarningText}" /></Style>
    <Style Selector="Border#Bar.error TextBlock#Icon"><Setter Property="Foreground" Value="{DynamicResource DangerText}" /></Style>
    <Style Selector="Border#Bar">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.3" />
        </Transitions>
      </Setter>
    </Style>
  </UserControl.Styles>
  <Border x:Name="Bar" IsVisible="False">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
      <TextBlock x:Name="Icon" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Top" />
      <TextBlock x:Name="MessageText" Grid.Column="1" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
      <Button x:Name="DetailButton" Grid.Column="2" Classes="ghost" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
              Content="{l:T common.details}" IsVisible="False">
        <Button.Flyout>
          <Flyout Placement="TopEdgeAlignedRight">
            <Grid RowDefinitions="*,Auto" MaxWidth="640" MaxHeight="360">
              <ScrollViewer>
                <SelectableTextBlock x:Name="DetailText" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontBodySmall}" />
              </ScrollViewer>
              <Button x:Name="CopyButton" Grid.Row="1" Classes="secondary" HorizontalAlignment="Right" Margin="0,8,0,0" />
            </Grid>
          </Flyout>
        </Button.Flyout>
      </Button>
      <Button x:Name="CloseButton" Grid.Column="3" Classes="ghost" Padding="6,2" Margin="4,0,0,0" VerticalAlignment="Center"
              Content="✕" />
    </Grid>
  </Border>
</UserControl>
