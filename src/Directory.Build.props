<Project>
  <!--
    Version and product information shared by every assembly. The version lives only here and must
    equal the release tag: the update check compares the release tag with the informational version.
    No commit hash goes into InformationalVersion, so the exe's product version reads exactly
    like the tag (0.7.0, not 0.7.0+abc123).
  -->
  <PropertyGroup>
    <Version>0.7.0</Version>
    <!-- Android versionCode / iOS CFBundleVersion 必须是递增整数；移动端工程都从这里读取。 -->
    <MobileApplicationVersion>70</MobileApplicationVersion>
    <Product>Jay</Product>
    <Company>Jay</Company>
    <Authors>warriorleavestar</Authors>
    <Copyright>Copyright (c) 2026 warriorleavestar</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
