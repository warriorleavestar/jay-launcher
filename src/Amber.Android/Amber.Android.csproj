<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationId>nz.work.minecraft.jay</ApplicationId>
    <ApplicationTitle>Jay</ApplicationTitle>
    <ApplicationVersion>$(MobileApplicationVersion)</ApplicationVersion>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="..\Amber.App\Assets\jay.png">
      <Link>Resources\drawable\jay.png</Link>
    </AndroidResource>
    <AndroidNativeLibrary Include="$(BaseIntermediateOutputPath)jay-native/arm64-v8a/libjayjvm.so" Abi="arm64-v8a" Condition="Exists('$(BaseIntermediateOutputPath)jay-native/arm64-v8a/libjayjvm.so')" />
    <AndroidNativeLibrary Include="$(BaseIntermediateOutputPath)jay-native/x86_64/libjayjvm.so" Abi="x86_64" Condition="Exists('$(BaseIntermediateOutputPath)jay-native/x86_64/libjayjvm.so')" />
    <AndroidNativeLibrary Include="$(BaseIntermediateOutputPath)jay-glfw/arm64-v8a/libglfw.so" Abi="arm64-v8a" Condition="Exists('$(BaseIntermediateOutputPath)jay-glfw/arm64-v8a/libglfw.so')" />
    <AndroidNativeLibrary Include="$(BaseIntermediateOutputPath)jay-glfw/x86_64/libglfw.so" Abi="x86_64" Condition="Exists('$(BaseIntermediateOutputPath)jay-glfw/x86_64/libglfw.so')" />
    <AndroidAsset Include="$(IntermediateOutputPath)jay-runtime-probe.jar" LogicalName="jay-runtime-probe.jar" />
    <AndroidAsset Include="..\..\third_party\android-glfw\LICENSE.md" LogicalName="licenses/GLFW-LICENSE.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Android SDK otherwise discovers every .java file recursively. SDLActivity exists only in the optional modern runtime. -->
    <AndroidJavaSource Remove="Sdl/JaySdlActivity.java" />
  </ItemGroup>

  <ItemGroup Condition="'$(JaySdlRuntimeDir)' != ''">
    <AndroidJavaSource Include="Sdl/JaySdlActivity.java" />
    <AndroidLibrary Include="$(JaySdlRuntimeDir)/sdl-classes.jar" Bind="false" />
    <AndroidNativeLibrary Include="$(JaySdlRuntimeDir)/arm64-v8a/libSDL3.so" Abi="arm64-v8a" />
    <AndroidNativeLibrary Include="$(JaySdlRuntimeDir)/x86_64/libSDL3.so" Abi="x86_64" />
    <AndroidAsset Include="$(JaySdlRuntimeDir)/SDL-LICENSE.txt" LogicalName="licenses/SDL-LICENSE.txt" />
  </ItemGroup>

  <ItemGroup Condition="'$(JayModernRuntimeDir)' != ''">
    <AndroidAsset Include="$(JayModernRuntimeDir)/licenses/*" LogicalName="licenses/%(Filename)%(Extension)" />
    <AndroidNativeLibrary Include="$(JayModernRuntimeDir)/lwjgl/*.so" Abi="arm64-v8a" />
    <AndroidAsset Include="$(JayModernRuntimeDir)/jre25-arm64-v8a.tar.xz" LogicalName="jre25-arm64-v8a.tar.xz" />
    <AndroidAsset Include="$(JayModernRuntimeDir)/jre25.json" LogicalName="jre25.json" />
    <!-- Keep the old one-directory experimental input working for local bisects. -->
    <AndroidJavaSource Include="Sdl/JaySdlActivity.java" Condition="'$(JaySdlRuntimeDir)' == ''" />
    <AndroidLibrary Include="$(JayModernRuntimeDir)/sdl-classes.jar" Bind="false" Condition="'$(JaySdlRuntimeDir)' == ''" />
    <AndroidNativeLibrary Include="$(JayModernRuntimeDir)/libSDL3.so" Abi="arm64-v8a" Condition="'$(JaySdlRuntimeDir)' == ''" />
    <AndroidAsset Include="$(JayModernRuntimeDir)/SDL-LICENSE.txt" LogicalName="licenses/SDL-LICENSE.txt" Condition="'$(JaySdlRuntimeDir)' == ''" />
  </ItemGroup>

  <Target Name="BuildJayRuntimeProbe" AfterTargets="_ResolveAndroidTooling" BeforeTargets="_BuildApkEmbed">
    <PropertyGroup>
      <_JayProbeClasses>$(IntermediateOutputPath)jay-runtime-probe-classes</_JayProbeClasses>
      <_JayBootstrapSource>$(MSBuildProjectDirectory)/Java/nz/work/minecraft/jay/AndroidGameBootstrap.java</_JayBootstrapSource>
    </PropertyGroup>
    <MakeDir Directories="$(_JayProbeClasses)" />
    <Exec Command="&quot;$(_JavaSdkDirectory)/bin/javac&quot; --release 8 -encoding UTF-8 -d &quot;$(_JayProbeClasses)&quot; &quot;$(_JayBootstrapSource)&quot; &quot;$(MSBuildProjectDirectory)/Java/nz/work/minecraft/jay/SdlMenuBootstrap.java&quot;" />
    <Exec Command="&quot;$(_JavaSdkDirectory)/bin/jar&quot; --create --file &quot;$(IntermediateOutputPath)jay-runtime-probe.jar&quot; -C &quot;$(_JayProbeClasses)&quot; ." />
  </Target>

  <Target Name="RequireJayJvmHost" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Error Condition="('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'android-arm64') And !Exists('$(BaseIntermediateOutputPath)jay-native/arm64-v8a/libjayjvm.so')" Text="Build the arm64 Jay Android native host with scripts/build-android-native.sh before a Release build." />
    <Error Condition="('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'android-x64') And !Exists('$(BaseIntermediateOutputPath)jay-native/x86_64/libjayjvm.so')" Text="Build the x86_64 Jay Android native host with scripts/build-android-native.sh before a Release build." />
    <Error Condition="('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'android-arm64') And !Exists('$(BaseIntermediateOutputPath)jay-glfw/arm64-v8a/libglfw.so')" Text="Build the arm64 Jay Android GLFW bridge with scripts/build-android-glfw.sh before a Release build." />
    <Error Condition="('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'android-x64') And !Exists('$(BaseIntermediateOutputPath)jay-glfw/x86_64/libglfw.so')" Text="Build the x86_64 Jay Android GLFW bridge with scripts/build-android-glfw.sh before a Release build." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.4" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Amber.App\Amber.App.csproj" AdditionalProperties="AmberAppAsLibrary=true" />
    <ProjectReference Include="..\Amber.Mobile\Amber.Mobile.csproj" />
  </ItemGroup>
</Project>
