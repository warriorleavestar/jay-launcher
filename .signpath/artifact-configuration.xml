<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath 制品配置（artifact configuration）。这个文件只是存档：真正生效的是贴到
  SignPath 网页里（项目 → Artifact Configurations）的那份，两边改动要保持一致。

  build.yml 上传的 jay-win-x64 制品是一个 zip，里面有两个发布包；这里只签我们自己编译的
  Jay.exe 和 jay-server.exe。包里自带的 EasyTier 是上游程序，按 SignPath Foundation 的规则
  不能用我们的证书签，保持原样。

  version 参数由 build.yml 从发布标签传进来（v0.7.0 → 0.7.0）；exe 里的产品名和产品版本
  对不上就拒签，这样忘了改版本号的发布不会被签名。
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <zip-file path="Jay-win-x64.zip">
      <pe-file path="Jay.exe" product-name="Jay" product-version="${version}">
        <authenticode-sign />
      </pe-file>
    </zip-file>
    <zip-file path="JayServer-win-x64.zip">
      <pe-file path="jay-server.exe" product-name="Jay" product-version="${version}">
        <authenticode-sign />
      </pe-file>
    </zip-file>
  </zip-file>
</artifact-configuration>
