 void _glfwPollEventsNull(void)
 {
+#if defined(__ANDROID__)
+    _GLFWwindow* window = _glfw.windowListHead;
+    JayInputSnapshot input = {0};
+    if (!window || !jayInputRead)
+        return;
+    jayGameplayModeSet(window->cursorMode == GLFW_CURSOR_DISABLED);
+    jayInputRead(&input);
+    if (input.generation == window->null.jayInputGeneration)
+        return;
+    window->null.jayInputGeneration = input.generation;
+    if (window->cursorMode != GLFW_CURSOR_DISABLED &&
+        input.pointerGeneration != window->null.jayPointerGeneration)
+    {
+        window->null.jayPointerGeneration = input.pointerGeneration;
+        _glfwInputWindowFocus(window, GLFW_TRUE);
+        _glfwInputCursorEnter(window, GLFW_TRUE);
+        _glfw.null.xcursor = input.pointerX * window->null.width;
+        _glfw.null.ycursor = input.pointerY * window->null.height;
+        GLFWcursorposfun cursorCallback = window->callbacks.cursorPos;
+        GLFWmousebuttonfun mouseCallback = window->callbacks.mouseButton;
+        window->callbacks.cursorPos = NULL;
+        window->callbacks.mouseButton = NULL;
+        _glfwInputCursorPos(window, _glfw.null.xcursor, _glfw.null.ycursor);
+        for (uint32_t click = 0; click < input.pointerClicks; click++)
+        {
+            _glfwInputMouseClick(window, GLFW_MOUSE_BUTTON_LEFT, GLFW_PRESS, 0);
+            _glfwInputMouseClick(window, GLFW_MOUSE_BUTTON_LEFT, GLFW_RELEASE, 0);
+        }
+        window->callbacks.cursorPos = cursorCallback;
+        window->callbacks.mouseButton = mouseCallback;
+        jayJavaPointer(input.pointerX, input.pointerY, input.pointerClicks);
+    }
+    const uint32_t previous = window->null.jayActions;
+    window->null.jayActions = input.actions;
+    const int keys[] = { GLFW_KEY_UNKNOWN, GLFW_MOUSE_BUTTON_LEFT, GLFW_MOUSE_BUTTON_RIGHT,
+                         GLFW_KEY_SPACE, GLFW_KEY_E, GLFW_KEY_ESCAPE, GLFW_KEY_T,
+                         GLFW_KEY_LEFT_SHIFT, GLFW_KEY_LEFT_CONTROL, GLFW_KEY_Q,
+                         GLFW_KEY_UNKNOWN, GLFW_KEY_UNKNOWN };
+    for (int action = 1; action <= 11; action++)
+    {
+        const uint32_t bit = 1u << action;
+        if (action >= 10)
+        {
+            const GLFWbool pressed = !(previous & bit) && (input.actions & bit);
+            const GLFWbool tapped = (input.actionTaps & bit) && !(input.actions & bit);
+            if (pressed || tapped)
+                inputScroll(window, 0.0, action == 10 ? 1.0 : -1.0);
+            continue;
+        }
+        if ((previous & bit) != (input.actions & bit))
+        {
+            if (action <= 2)
+                inputMouseButton(window, keys[action], (input.actions & bit) ? GLFW_PRESS : GLFW_RELEASE);
+            else
+                inputKey(window, keys[action], (input.actions & bit) ? GLFW_PRESS : GLFW_RELEASE);
+        }
+        else if ((input.actionTaps & bit) && !(input.actions & bit))
+        {
+            if (action <= 2)
+            {
+                inputMouseButton(window, keys[action], GLFW_PRESS);
+                inputMouseButton(window, keys[action], GLFW_RELEASE);
+            }
+            else
+            {
+                inputKey(window, keys[action], GLFW_PRESS);
+                inputKey(window, keys[action], GLFW_RELEASE);
+            }
+        }
+    }
+    const float threshold = 0.25f;
+    const int movementKeys[] = { GLFW_KEY_A, GLFW_KEY_D, GLFW_KEY_W, GLFW_KEY_S };
+    const uint32_t movement = (input.moveX < -threshold ? 1u : 0u) |
+                              (input.moveX > threshold ? 2u : 0u) |
+                              (input.moveY < -threshold ? 4u : 0u) |
+                              (input.moveY > threshold ? 8u : 0u);
+    for (int index = 0; index < 4; index++)
+    {
+        const uint32_t bit = 1u << index;
+        if ((window->null.jayMovementKeys & bit) != (movement & bit))
+            inputKey(window, movementKeys[index],
+                     (movement & bit) ? GLFW_PRESS : GLFW_RELEASE);
+    }
+    window->null.jayMovementKeys = movement;
+    for (uint32_t index = 0; index < input.textCount && index < 64; index++)
+        inputChar(window, input.text[index]);
+    for (uint32_t index = 0; index < input.keyCount && index < 16; index++)
+    {
+        inputKey(window, input.keys[index], GLFW_PRESS);
+        inputKey(window, input.keys[index], GLFW_RELEASE);
+    }
+    if (window->cursorMode == GLFW_CURSOR_DISABLED &&
+        (input.lookX != 0.f || input.lookY != 0.f))
+    {
+        _glfw.null.xcursor += (int) (input.lookX * window->null.width);
+        _glfw.null.ycursor += (int) (input.lookY * window->null.height);
+        GLFWcursorposfun callback = window->callbacks.cursorPos;
+        window->callbacks.cursorPos = NULL;
+        _glfwInputCursorPos(window, _glfw.null.xcursor, _glfw.null.ycursor);
+        window->callbacks.cursorPos = callback;
+        jayJavaLook(input.lookX, input.lookY);
+    }
+#endif
 }
 
