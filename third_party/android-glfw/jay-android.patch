 #include <stdlib.h>

+#if defined(__ANDROID__)
+#include <android/native_window.h>
+#include <dlfcn.h>
+
+typedef ANativeWindow* (*JaySurfaceAcquire)(void);
+typedef void (*JaySurfaceRelease)(ANativeWindow*);
+typedef struct JayInputSnapshot
+{
+    float moveX;
+    float moveY;
+    float lookX;
+    float lookY;
+    uint32_t actions;
+    uint32_t textCount;
+    uint32_t keyCount;
+    uint32_t text[64];
+    int32_t keys[16];
+    uint64_t generation;
+} JayInputSnapshot;
+typedef void (*JayInputRead)(JayInputSnapshot*);
+
+static JaySurfaceAcquire jaySurfaceAcquire;
+static JaySurfaceRelease jaySurfaceRelease;
+static JayInputRead jayInputRead;
+static void* jayBridge;
+
+static GLFWbool connectJayBridge(void)
+{
+    if (!jayBridge)
+        jayBridge = dlopen("libjayjvm.so", RTLD_NOW);
+    if (!jayBridge)
+        return GLFW_FALSE;
+    if (!jaySurfaceAcquire)
+        jaySurfaceAcquire = (JaySurfaceAcquire) dlsym(jayBridge, "jay_surface_acquire");
+    if (!jaySurfaceRelease)
+        jaySurfaceRelease = (JaySurfaceRelease) dlsym(jayBridge, "jay_surface_release");
+    if (!jayInputRead)
+        jayInputRead = (JayInputRead) dlsym(jayBridge, "jay_input_read");
+    return jaySurfaceAcquire && jaySurfaceRelease && jayInputRead;
+}
+#endif
+
