+// ESSL requires constant indices for fragment outputs, even when the equivalent
+// desktop shader writes them in a loop. SPIRV-Cross supplies explicit locations.
+static std::string lowerFragmentOutputArrays(const std::string& source) {
+    static const std::regex declaration(
+        R"((layout\s*\([^)]*\)\s*out\s+)((?:highp\s+|mediump\s+|lowp\s+)?\w+)\s+(\w+)\[(\d+)\];)");
+    if (!std::regex_search(source, declaration)) return source;
+
+    std::string result, epilogue;
+    size_t offset = 0;
+    for (std::sregex_iterator it(source.begin(), source.end(), declaration), end; it != end; ++it) {
+        const auto& match = *it;
+        const auto name = match[3].str();
+        const auto local = "jayPrivateOutput" + name;
+        const int count = std::stoi(match[4]);
+        result.append(source, offset, match.position() - offset);
+        result += match.str() + "\n" + match[2].str() + " " + local + "[" + match[4].str() + "];\n";
+        result += "#define " + name + " " + local + "\n";
+        epilogue += "\n#undef " + name + "\n";
+        for (int i = 0; i < count; ++i) {
+            const auto index = "[" + std::to_string(i) + "]";
+            epilogue += name + index + " = " + local + index + ";\n";
+        }
+        offset = match.position() + match.length();
+    }
+    result.append(source, offset, std::string::npos);
+    const auto main = result.find("void main()");
+    if (main == std::string::npos) return source;
+    result.replace(main, 11, "void jay_fragment_body()");
+    return result + "\nvoid main() { jay_fragment_body();\n" + epilogue + "}\n";
+}
