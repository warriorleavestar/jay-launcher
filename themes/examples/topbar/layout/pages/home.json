{
  // 宽窗口：左边是实例和提示，右边一栏放启动卡片。
  "wide": {
    "type": "grid", "columns": ["*", "360"], "rows": ["auto", "*"], "spacing": 16,
    "children": [
      { "type": "region", "name": "home.title", "columnSpan": 2 },
      { "type": "scroll", "row": 1, "children": ["home.pending", "home.onboarding", "home.instance", "home.crash"] },
      { "type": "stack", "row": 1, "column": 1, "spacing": 12, "valign": "start", "children": [
        { "type": "region", "name": "home.launch" },
        { "type": "text", "text": "顶栏主题：导航在上面，启动卡片在右边。", "style": "hint" }
      ] }
    ]
  },
  // 中等和窄窗口：启动卡片放最上面，下面滚动。
  "default": {
    "type": "dock",
    "children": [
      { "type": "region", "name": "home.launch", "dock": "top", "margin": [0, 0, 0, 12] },
      { "type": "scroll", "children": ["home.pending", "home.onboarding", "home.instance", "home.crash"] }
    ]
  }
}
