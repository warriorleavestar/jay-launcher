# Jay 公共网络节点（种子节点 + 房间目录）的 systemd 服务。
# 用法见 docs/public-network.md：把 jay-server 放到 /opt/jay-server/，数据放 /var/lib/jay-public-node/，用单独的 jay 用户运行。
# This template keeps the `jay` user and data folder of existing nodes, so an updated copy restarts as before.
# New nodes: use server/install-network-node.sh, which runs the node as its own jay-network user, so a Minecraft server
# (jay-server.service, user `jay`) on the same machine cannot read the node's keys. To move an existing node to its own
# user: stop the service, create a system user jay-network, `chown -R jay-network:jay-network /var/lib/jay-public-node`,
# set User= and Group= below to jay-network, then `systemctl daemon-reload` and start it again.
[Unit]
Description=Jay public network node (seed + room directory)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jay
Group=jay
Environment=JAY_SERVER_DIR=/var/lib/jay-public-node
ExecStart=/opt/jay-server/jay-server directory --listen 11010
Restart=on-failure
RestartSec=10

# 加固：只能写自己的数据目录。
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jay-public-node
# jay-server's own data (a Minecraft server on the same machine) is none of the node's business.
InaccessiblePaths=-/var/lib/jay-server
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
# Not PrivateDevices (hardware binding uses /dev/tpmrm0) and not MemoryDenyWriteExecute (.NET compiles code at run time).

[Install]
WantedBy=multi-user.target
